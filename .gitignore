# build output
dist/

# generated types
.astro/

# Validierungs-Reports: sync-landings.mjs schreibt bei jedem Lauf eine neue
# timestamped JSON-Datei -> sollen nicht die Git-History zumüllen.
reports/validation/landings/*.json

# dependencies
node_modules

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# VS Code Local History (auto-generated, should not be tracked)
.history/
.vercel

# Claude Code Worktree-Checkouts (transient, nie committen)
.claude/worktrees/

# Sync-generierte leere Why-Bildordner-Platzhalter (sync:why legt sie bei jedem
# Build neu an → sonst dauerhaft untracked). Echte Bilder bleiben sichtbar.
public/img/why/**/.gitkeep
