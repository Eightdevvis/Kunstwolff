---
/**
 * LandingErinnerungen.astro
 *
 * Pinnwand-Streifen mit 4 Fotos, die leicht chaotisch "angepinnt" wirken.
 * Jedes Foto hängt ein bisschen schräg (CSS-Rotation), hat oben eine
 * Pinnadel (SVG) und einen leichten Schatten – wie Polaroids an einer Wand.
 *
 * Daten kommen per JSON aus public/erinnerungen/ mit Fallback-Kette
 * (skill-landing → landing → skill → default), geladen über getErinnerungen().
 *
 * Props:
 *   - skill?:   Skill-Slug (optional) für die Fallback-Auflösung
 *   - landing?: Landing-Slug (optional) für die Fallback-Auflösung
 *
 * Wenn keine Fotos gefunden werden, rendert sich die Komponente nicht (kein leerer Bereich).
 */

import { getErinnerungen } from '../utils/erinnerungen';

// ── Props ────────────────────────────────────────────────────────────────────
const { skill, landing } = Astro.props as {
  skill?: string;
  landing?: string;
};

// ── Daten laden ──────────────────────────────────────────────────────────────
const photos = getErinnerungen(skill, landing);

/**
 * Feste Rotationswinkel für die 4 Fotos.
 * Bewusst asymmetrisch – nicht zu ordentlich, nicht zu wild.
 * Sieht aus als hätte jemand sie schnell an die Wand gepinnt.
 */
const rotations = [-3, 2, -1.5, 2.5];

/**
 * Vertikale Versätze (in px) – damit die Fotos nicht perfekt auf einer Linie hängen.
 * Wie echte Fotos an einer Pinnwand: leicht versetzt, organisch.
 */
const offsets = [0, 12, -8, 6];
---

{/* Nur rendern wenn mindestens 1 Foto vorhanden ist */}
{photos.length > 0 && (
  <section class="erinnerungen-section" aria-label="Erinnerungen">
    <div class="erinnerungen-container">

      {/* Pinnwand-Streifen mit den Fotos – kein Titel, spricht für sich */}
      <div class="pinnwand">
        {photos.slice(0, 4).map((photo, i) => (
          <div
            class="pin-card"
            style={`--rotation: ${rotations[i % rotations.length]}deg; --offset: ${offsets[i % offsets.length]}px;`}
          >
            {/* Pinnadel-SVG – ein stilisierter Reißzwecken-Kopf */}
            <div class="pin-needle" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                {/* Schatten unter der Nadel */}
                <ellipse cx="12" cy="18" rx="5" ry="2" fill="rgba(0,0,0,0.15)" />
                {/* Nadelspitze (der Stift) */}
                <line x1="12" y1="12" x2="12" y2="20" stroke="#888" stroke-width="1.5" stroke-linecap="round" />
                {/* Nadelkopf (der runde Griff oben) */}
                <circle cx="12" cy="8" r="6" fill="#c0392b" />
                {/* Lichtreflex auf dem Kopf für 3D-Effekt */}
                <circle cx="10" cy="6" r="2" fill="rgba(255,255,255,0.4)" />
              </svg>
            </div>

            {/* Das eigentliche Foto – weißer Rand wie ein Polaroid */}
            <div class="pin-photo-frame">
              <img
                src={photo.image}
                alt={photo.alt}
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
)}

<style>
  /* ══════════════════════════════════════════════════════════════════════════
     ERINNERUNGEN-SEKTION
     Ein warmer, persönlicher Streifen – wie eine Pinnwand zuhause.
     Dunkler Hintergrund (passend zum Kunstwolff-Stil), Fotos in weißen Rahmen.
  ══════════════════════════════════════════════════════════════════════════ */

  .erinnerungen-section {
    /* Schmal halten – dezenter Streifen, kein eigener Seitenabschnitt */
    padding: 40px 20px 50px;
    background: #111;
    overflow: hidden;
  }

  .erinnerungen-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ── Pinnwand-Grid ──────────────────────────────────────────────────────── */
  /* 4 Fotos nebeneinander, gleichmäßig verteilt.
     Auf kleinen Screens 2×2, auf ganz kleinen 1 Spalte. */

  .pinnwand {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
    justify-items: center;
    align-items: start;
    padding: 20px 10px;
  }

  /* ── Einzelne Pin-Card ──────────────────────────────────────────────────── */
  /* Jede Card bekommt per CSS Custom Property eine individuelle Rotation
     und einen vertikalen Offset – das erzeugt den "chaotisch angepinnt"-Look. */

  .pin-card {
    position: relative;
    transform: rotate(var(--rotation, 0deg)) translateY(var(--offset, 0px));
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    max-width: 260px;
    width: 100%;
  }

  /* Hover: Foto richtet sich gerade aus und hebt sich leicht an –
     als würde man es von der Wand nehmen um es genauer anzuschauen */
  .pin-card:hover {
    transform: rotate(0deg) translateY(-8px) scale(1.03);
    z-index: 2;
  }

  /* ── Pinnadel ───────────────────────────────────────────────────────────── */
  /* Sitzt oben mittig über dem Foto, ragt leicht über den Rahmen hinaus */

  .pin-needle {
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    /* Leichter Drop-Shadow für die Nadel selbst */
    filter: drop-shadow(1px 2px 2px rgba(0, 0, 0, 0.3));
  }

  /* ── Foto-Rahmen (Polaroid-Stil) ────────────────────────────────────────── */
  /* Weißer Rand rund um das Bild, unten etwas breiter – wie ein echtes Polaroid.
     Box-Shadow erzeugt den "hängt an der Wand"-Effekt. */

  .pin-photo-frame {
    background: #fff;
    padding: 10px 10px 20px;
    border-radius: 2px;
    /* Mehrstufiger Schatten: nah (scharf) + fern (weich) = realistisch */
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.3),
      0 8px 25px rgba(0, 0, 0, 0.15);
    /* Leichte Textur-Anmutung durch minimalen Gelbstich */
    background: linear-gradient(
      145deg,
      #fefefe 0%,
      #f9f7f4 100%
    );
  }

  .pin-photo-frame img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    /* Leichte Entsättigung – wie ein etwas älteres Foto */
    filter: saturate(0.9) contrast(1.02);
    transition: filter 0.3s ease;
  }

  /* Bei Hover: volle Farbe */
  .pin-card:hover .pin-photo-frame img {
    filter: saturate(1) contrast(1);
  }

  /* ── Responsive: Tablet (2×2 Grid) ──────────────────────────────────────── */

  @media (max-width: 900px) {
    .pinnwand {
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
    }

    .pin-card {
      max-width: 240px;
    }
  }

  /* ── Responsive: Mobile (horizontal scrollbar) ──────────────────────────── */

  @media (max-width: 520px) {
    .pinnwand {
      /* Horizontaler Scroll-Strip statt Umbruch –
         wie eine Pinnwand an der man entlanggeht */
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding: 10px 5px;
      scrollbar-width: thin;
      scrollbar-color: #333 transparent;
    }

    .pin-card {
      flex: 0 0 70vw;
      max-width: 70vw;
      scroll-snap-align: center;
    }

    .erinnerungen-section {
      padding: 30px 15px 40px;
    }
  }
</style>
