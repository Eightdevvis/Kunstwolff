---
import { getNavigationItems, type NavigationDropdownItem, type NavigationItem } from '../../utils/navigation';

const navigationItems = getNavigationItems();

const isDropdownItem = (item: NavigationItem): item is NavigationDropdownItem => 'children' in item;
---

<!-- =========================
     Hauptnavigation
========================= -->
<nav class="nav">
  <div class="nav-inner">
    <!-- Logo links -->
    <div class="nav-logo">
      <a href="/" aria-label="Zur Startseite">
        <img src="/img/logo/logo_transparent.png" alt="Kunstwolff Logo" class="nav_logo">
      </a>
    </div>

    <!-- Sprache + Menü rechts -->
    <div class="nav-right">
      <input class="nav-toggle-input" type="checkbox" id="nav-toggle-main" />
      <label
        class="nav-toggle"
        for="nav-toggle-main"
        aria-label="Navigation umschalten"
      >
        <span></span>
        <span></span>
        <span></span>
      </label>
      <!-- Hauptmenü -->
      <ul class="nav-menu" id="main-nav-menu">
        {
          navigationItems.map((item, index) => {
            if (!isDropdownItem(item)) {
              return [
                <li>
                  <a
                    href={item.url}
                    data-nav-contact={item.url === '#contact' ? 'true' : undefined}
                    data-nav-contact-fallback={item.url === '#contact' ? '/contact' : undefined}
                    data-nav-faq={item.url === '#faq' ? 'true' : undefined}
                    data-nav-faq-fallback={item.url === '#faq' ? '/faq' : undefined}
                  >
                    {item.label}
                  </a>
                </li>,
                index < navigationItems.length - 1 ? <li class="divider">|</li> : null
              ];
            } else {
              return [
                <li class="nav-menu-item">
                  <div class="nav-mini-dropdown">
                    <span class="nav-mini-toggle">{item.label}</span>
                    <div class="nav-mini-card">
                      {item.children.map((link) => (
                        <a class="nav-mini-link" href={link.url}>{link.label}</a>
                      ))}
                    </div>
                  </div>
                </li>,
                index < navigationItems.length - 1 ? <li class="divider">|</li> : null
              ];
            }
          })
        }
      </ul>
    </div>
  </div>
</nav>

<script>
  // Contact-Fallback
  const contactLinks = document.querySelectorAll('a[data-nav-contact="true"]');
  contactLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      const href = link.getAttribute('href') ?? '';
      if (href !== '#contact') return;
      const anchor = document.querySelector('#contact');
      if (anchor) return;
      const fallback = link.getAttribute('data-nav-contact-fallback') ?? '/contact';
      event.preventDefault();
      window.location.href = fallback;
    });
  });

  // FAQ-Fallback
  const faqLinks = document.querySelectorAll('a[data-nav-faq="true"]');
  faqLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      const href = link.getAttribute('href') ?? '';
      if (href !== '#faq') return;
      const anchor = document.querySelector('#faq');
      if (anchor) return;
      const fallback = link.getAttribute('data-nav-faq-fallback') ?? '/faq';
      event.preventDefault();
      window.location.href = fallback;
    });
  });
</script>

<script>
  const contactLinks = document.querySelectorAll('a[data-nav-contact="true"]');

  contactLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      const href = link.getAttribute('href') ?? '';
      if (href !== '#contact') {
        return;
      }

      const anchor = document.querySelector('#contact');
      if (anchor) {
        return;
      }

      const fallback = link.getAttribute('data-nav-contact-fallback') ?? '/contact';
      event.preventDefault();
      window.location.href = fallback;
    });
  });
</script>

<style>
/* =========================
   Navigation Container + Ombre
========================= */

.nav-logo img {
  height: 60px;
  width: auto;
  transition: transform 0.3s ease, filter 0.3s ease;
}

.nav-logo {
  margin-left: -18px;
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.nav-logo::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 50px;
  height: 50px;
  transform: translate(-50%, -50%);
  border-radius: 30%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 75%);
  filter: blur(5px);
  pointer-events: none;
  z-index: 0;
}

.nav-logo a {
  position: relative;
  z-index: 1;
}

.nav {
  width: 100%;
  padding: 20px 40px;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 1000;
  overflow: visible;

  /* Ombre von Schwarz zu Transparent */
  background: transparent;
  transition: background 0.3s ease;
}

.nav::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(to bottom, rgba(0,0,0,0.95), rgba(0,0,0,0));
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 1) 0%,
    rgba(0, 0, 0, 1) 62%,
    rgba(0, 0, 0, 0.65) 82%,
    rgba(0, 0, 0, 0) 100%
  );
  -webkit-mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 1) 0%,
    rgba(0, 0, 0, 1) 62%,
    rgba(0, 0, 0, 0.65) 82%,
    rgba(0, 0, 0, 0) 100%
  );
}

/* Innerer Flex-Container */
.nav-inner {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-toggle {
  display: none;
  width: 42px;
  height: 42px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  background: rgba(0, 0, 0, 0.35);
  border-radius: 8px;
  cursor: pointer;
  padding: 10px 8px;
}

.nav-toggle-input {
  display: none;
}

.nav-toggle span {
  display: block;
  width: 100%;
  height: 2px;
  margin: 4px 0;
  background: #fff;
  transition: transform 0.25s ease, opacity 0.25s ease;
}

.nav-toggle-input:checked + .nav-toggle span:nth-child(1) {
  transform: translateY(6px) rotate(45deg);
}

.nav-toggle-input:checked + .nav-toggle span:nth-child(2) {
  opacity: 0;
}

.nav-toggle-input:checked + .nav-toggle span:nth-child(3) {
  transform: translateY(-6px) rotate(-45deg);
}

/* =========================
  Hauptmenü + Divider
========================= */
.nav-menu {
  display: flex;
  align-items: center;
  list-style: none;
  margin: 0;
  padding: 0;
  gap: 12px;
}

.nav-menu-item {
  position: relative;
}

.nav-menu a,
.nav-mini-toggle,
.nav-mini-link {
  text-decoration: none;
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-weight: inherit;
  color: #fff;
  opacity: 0.8;
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.nav-mini-dropdown {
  position: relative;
}

.nav-mini-toggle {
  display: inline-block;
  cursor: default;
}

.nav-menu a:hover,
.nav-mini-toggle:hover {
  opacity: 1;
  transform: translateY(-2px);
}

.nav-mini-card {
  position: absolute;
  top: 100%;
  left: 50%;
  z-index: 1300;
  width: max-content;
  min-width: 0;
  padding: 10px 10px 8px;
  border-radius: 0;
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.12);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  opacity: 0;
  pointer-events: none;
  transform: translateX(-50%) translateY(-6px);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.nav-mini-link {
  display: block;
  text-decoration: none;
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-weight: inherit;
  color: #fff;
  opacity: 1;
  transition: opacity 0.2s ease;
}

.nav-mini-dropdown:hover .nav-mini-card {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}

.nav-menu .divider {
  opacity: 0.3;
  font-size: 12px;
  user-select: none;
}

:global(body[data-nav-tone="light"]) .nav-mini-card .nav-mini-link {
  color: #111;
}

:global(body[data-nav-tone="light"]) .nav-mini-card {
  border-color: rgba(17, 17, 17, 0.18);
}

/* =========================
   Responsives Verhalten
========================= */
@media (max-width: 768px) {
  .nav-inner {
    align-items: flex-start;
    gap: 8px;
  }

  .nav-right {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .nav-toggle {
    display: inline-block;
  }

  .nav-menu {
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    margin-top: 8px;
    padding: 0 14px;
    background: rgba(0, 0, 0, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    transition: max-height 0.28s ease, opacity 0.22s ease, transform 0.22s ease, padding 0.22s ease;
  }

  .nav-toggle-input:checked ~ .nav-menu {
    max-height: 280px;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    padding: 12px 14px;
  }

  .nav-menu .divider {
    display: none;
  }

  .nav-mini-card {
    position: static;
    width: max-content;
    min-width: 0;
    margin-top: 8px;
  }
}
</style>