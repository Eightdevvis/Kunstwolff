---
import { getNavigationItems, type NavigationDropdownItem, type NavigationItem } from '../../utils/navigation';

const navigationItems = getNavigationItems();

const isDropdownItem = (item: NavigationItem): item is NavigationDropdownItem => 'children' in item;

/* Prüft ob ein Link-Item als CTA-Button dargestellt werden soll */
const isCta = (item: NavigationItem): boolean => !isDropdownItem(item) && !!item.cta;
---

<!-- =========================
     Hauptnavigation
========================= -->
<nav class="nav">
  <div class="nav-inner">
    <!-- Logo links -->
    <div class="nav-logo">
      <a href="/" aria-label="Zur Startseite">
        <img src="/img/logo/logo_transparent.webp" alt="Kunstwolff Logo" class="nav_logo">
      </a>
    </div>

    <!-- Sprache + Menü rechts -->
    <div class="nav-right">
      <input class="nav-toggle-input" type="checkbox" id="nav-toggle-main" />
      <label
        class="nav-toggle"
        for="nav-toggle-main"
        aria-label="Navigation umschalten"
      >
        <span></span>
        <span></span>
        <span></span>
      </label>
      <!-- Hauptmenü -->
      <ul class="nav-menu" id="main-nav-menu">
        {
          navigationItems.map((item, index) => {
            if (!isDropdownItem(item)) {
              /* Nächstes Item prüfen: wenn es ein CTA ist, Divider davor ausblenden */
              const nextItem = navigationItems[index + 1];
              const nextIsCta = nextItem && isCta(nextItem);

              return [
                <li class={isCta(item) ? 'nav-cta' : undefined}>
                  <a
                    href={item.url}
                    class={isCta(item) ? 'nav-cta-link' : undefined}
                    data-nav-contact={item.url === '#contact' ? 'true' : undefined}
                    data-nav-contact-fallback={item.url === '#contact' ? '/contact' : undefined}
                    data-nav-faq={item.url === '#faq' ? 'true' : undefined}
                    data-nav-faq-fallback={item.url === '#faq' ? '/faq' : undefined}
                  >
                    {item.label}
                  </a>
                </li>,
                index < navigationItems.length - 1 && !nextIsCta ? <li class="divider">|</li> : null
              ];
            } else {
              return [
                <li class="nav-menu-item">
                  <div class="nav-mini-dropdown">
                    <span class="nav-mini-toggle">{item.label}</span>
                    <div class="nav-mini-card">
                      {item.children.map((link) => (
                        <a class="nav-mini-link" href={link.url}>{link.label}</a>
                      ))}
                    </div>
                  </div>
                </li>,
                index < navigationItems.length - 1 ? <li class="divider">|</li> : null
              ];
            }
          })
        }
      </ul>
    </div>
  </div>
</nav>

<script>
  // Contact-Fallback
  const contactLinks = document.querySelectorAll('a[data-nav-contact="true"]');
  contactLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      const href = link.getAttribute('href') ?? '';
      if (href !== '#contact') return;
      const anchor = document.querySelector('#contact');
      if (anchor) return;
      const fallback = link.getAttribute('data-nav-contact-fallback') ?? '/contact';
      event.preventDefault();
      window.location.href = fallback;
    });
  });

  // FAQ-Fallback
  const faqLinks = document.querySelectorAll('a[data-nav-faq="true"]');
  faqLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      const href = link.getAttribute('href') ?? '';
      if (href !== '#faq') return;
      const anchor = document.querySelector('#faq');
      if (anchor) return;
      const fallback = link.getAttribute('data-nav-faq-fallback') ?? '/faq';
      event.preventDefault();
      window.location.href = fallback;
    });
  });
</script>

<script>
  const contactLinks = document.querySelectorAll('a[data-nav-contact="true"]');

  contactLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      const href = link.getAttribute('href') ?? '';
      if (href !== '#contact') {
        return;
      }

      const anchor = document.querySelector('#contact');
      if (anchor) {
        return;
      }

      const fallback = link.getAttribute('data-nav-contact-fallback') ?? '/contact';
      event.preventDefault();
      window.location.href = fallback;
    });
  });
</script>

<style>
/* =========================
   Navigation Container + Ombre
========================= */

.nav-logo img {
  height: 60px;
  width: auto;
  transition: transform 0.3s ease, filter 0.3s ease;
}

.nav-logo {
  margin-left: -18px;
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.nav-logo::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 50px;
  height: 50px;
  transform: translate(-50%, -50%);
  border-radius: 30%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 75%);
  filter: blur(5px);
  pointer-events: none;
  z-index: 0;
}

.nav-logo a {
  position: relative;
  z-index: 1;
}

.nav {
  width: 100%;
  padding: 20px 40px;
  position: fixed;
  top: 0;
  left: 0;
  /* Muss über dem Cinema-Dimmer (z-index: 1001) liegen,
     damit die Nav beim Scrollen durch CinemaWelcome sichtbar bleibt */
  z-index: 1100;
  overflow: visible;

  /* Ombre von Schwarz zu Transparent */
  background: transparent;
  transition: background 0.3s ease;
}

.nav::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(to bottom, rgba(0,0,0,0.95), rgba(0,0,0,0));
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 1) 0%,
    rgba(0, 0, 0, 1) 62%,
    rgba(0, 0, 0, 0.65) 82%,
    rgba(0, 0, 0, 0) 100%
  );
  -webkit-mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 1) 0%,
    rgba(0, 0, 0, 1) 62%,
    rgba(0, 0, 0, 0.65) 82%,
    rgba(0, 0, 0, 0) 100%
  );
}

/* Innerer Flex-Container */
.nav-inner {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-toggle {
  display: none;
  width: 42px;
  height: 42px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  background: rgba(0, 0, 0, 0.35);
  border-radius: 8px;
  cursor: pointer;
  padding: 10px 8px;
}

.nav-toggle-input {
  display: none;
}

.nav-toggle span {
  display: block;
  width: 100%;
  height: 2px;
  margin: 4px 0;
  background: #fff;
  transition: transform 0.25s ease, opacity 0.25s ease;
}

.nav-toggle-input:checked + .nav-toggle span:nth-child(1) {
  transform: translateY(6px) rotate(45deg);
}

.nav-toggle-input:checked + .nav-toggle span:nth-child(2) {
  opacity: 0;
}

.nav-toggle-input:checked + .nav-toggle span:nth-child(3) {
  transform: translateY(-6px) rotate(-45deg);
}

/* =========================
  Hauptmenü + Divider
========================= */
.nav-menu {
  display: flex;
  align-items: center;
  list-style: none;
  margin: 0;
  padding: 0;
  gap: 12px;
}

.nav-menu-item {
  position: relative;
}

.nav-menu a,
.nav-mini-toggle,
.nav-mini-link {
  text-decoration: none;
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-weight: inherit;
  color: #fff;
  opacity: 0.8;
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.nav-mini-dropdown {
  position: relative;
}

.nav-mini-toggle {
  display: inline-block;
  cursor: default;
}

.nav-menu a:hover,
.nav-mini-toggle:hover {
  opacity: 1;
  transform: translateY(-2px);
}

.nav-mini-card {
  position: absolute;
  top: 100%;
  left: 50%;
  z-index: 1300;
  width: max-content;
  min-width: 0;
  padding: 10px 10px 8px;
  border-radius: 0;
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.12);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  opacity: 0;
  pointer-events: none;
  transform: translateX(-50%) translateY(-6px);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.nav-mini-link {
  display: block;
  text-decoration: none;
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-weight: inherit;
  color: #fff;
  opacity: 1;
  transition: opacity 0.2s ease;
}

.nav-mini-dropdown:hover .nav-mini-card {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}

.nav-menu .divider {
  opacity: 0.3;
  font-size: 12px;
  user-select: none;
}

:global(body[data-nav-tone="light"]) .nav-mini-card .nav-mini-link {
  color: #111;
}

:global(body[data-nav-tone="light"]) .nav-mini-card {
  border-color: rgba(17, 17, 17, 0.18);
}

/* =========================
   CTA-Button (Gold Pill)
   – hebt "Anfrage" als Handlungsaufforderung hervor
========================= */

/*
 * Metallischer Gold-Button mit animiertem Shimmer.
 *
 * Drei Schichten erzeugen den Gold-Effekt:
 * 1. Basis-Gradient – von dunklem zu hellem Gold, gibt dem Button
 *    die typische metallische Tiefe statt flacher Farbe.
 * 2. Dünne helle Oberkante (border-top) – simuliert eine Lichtreflexion
 *    an der oberen Kante, wie bei poliertem Metall.
 * 3. Shimmer-Animation – ein diagonaler heller Streifen (pseudo-Element)
 *    der alle 4 Sekunden einmal über den Button gleitet.
 *    Nutzt overflow:hidden damit der Streifen nicht über die Pill-Form
 *    hinausragt, und mask-image damit er sanft ein-/ausfadet.
 */

/* Shimmer-Keyframes: der helle Streifen wandert von links nach rechts.
   Nur 0%–12% ist Bewegung, der Rest ist Pause → Shimmer alle ~10s statt dauerhaft */
@keyframes cta-shimmer {
  0%   { transform: translateX(-100%) skewX(-20deg); }
  12%  { transform: translateX(250%) skewX(-20deg);  }
  100% { transform: translateX(250%) skewX(-20deg);  }
}

.nav-cta-link {
  --cta-gold-dark: #a8893a;      /* dunkles Gold (Schatten-Seite) */
  --cta-gold: #c9a84c;           /* mittleres Gold */
  --cta-gold-light: #e0c868;     /* helles Gold (Highlight) */
  --cta-text: #1a1400;            /* sehr dunkler warmton statt reinem schwarz */

  /* Metallischer Gradient: dunkel unten → hell oben */
  background: linear-gradient(
    to bottom,
    var(--cta-gold-light) 0%,
    var(--cta-gold) 45%,
    var(--cta-gold-dark) 100%
  );
  color: var(--cta-text) !important;
  opacity: 1 !important;
  padding: 6px 20px;
  border-radius: 999px;
  font-weight: 600;
  letter-spacing: 0.14em;

  /* Helle Oberkante = Lichtreflexion auf poliertem Metall */
  border-top: 1px solid rgba(255, 235, 160, 0.5);
  border-bottom: 1px solid rgba(120, 90, 20, 0.3);

  /* inline-block nötig, weil overflow:hidden auf inline-Elementen ignoriert wird */
  display: inline-block;
  position: relative;
  overflow: hidden;

  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

/* Shimmer-Streifen: diagonaler heller Balken als ::after */
.nav-cta-link::after {
  content: "";
  position: absolute;
  inset: 0;
  /* Schmaler diagonaler Lichtstreifen */
  background: linear-gradient(
    105deg,
    transparent 30%,
    rgba(255, 245, 200, 0.45) 45%,
    rgba(255, 255, 255, 0.25) 50%,
    rgba(255, 245, 200, 0.45) 55%,
    transparent 70%
  );
  /* 10s Gesamtzyklus: ~1.2s Shimmer + ~8.8s Pause (dezent, nicht nervig) */
  animation: cta-shimmer 10s ease-in-out infinite;
  pointer-events: none;
}

.nav-cta-link:hover {
  transform: translateY(-2px);
  box-shadow:
    0 4px 18px rgba(201, 168, 76, 0.4),
    0 0 8px rgba(224, 200, 104, 0.2);
}

/* Animation pausieren wenn User reduced-motion bevorzugt */
@media (prefers-reduced-motion: reduce) {
  .nav-cta-link::after {
    animation: none;
  }
}

/* =========================
   Responsives Verhalten
========================= */
@media (max-width: 768px) {
  .nav-inner {
    align-items: flex-start;
    gap: 8px;
  }

  .nav-right {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .nav-toggle {
    display: inline-block;
  }

  .nav-menu {
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    margin-top: 8px;
    padding: 0 14px;
    background: rgba(0, 0, 0, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    transition: max-height 0.28s ease, opacity 0.22s ease, transform 0.22s ease, padding 0.22s ease;
  }

  .nav-toggle-input:checked ~ .nav-menu {
    max-height: 280px;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    padding: 12px 14px;
  }

  .nav-menu .divider {
    display: none;
  }

  .nav-mini-card {
    position: static;
    width: max-content;
    min-width: 0;
    margin-top: 8px;
  }

  /* CTA im mobilen Menü: volle Breite, zentriert */
  .nav-cta {
    width: 100%;
    text-align: center;
    margin-top: 4px;
  }
}
</style>