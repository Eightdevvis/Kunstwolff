  <!-- =========================
     CONTACT
========================= -->
  <section id="contact" class="section contact">
    <div class="section-inner">
      <h2>Kontakt</h2>

      <p class="contact-intro">
        Stellen Sie uns jetzt unverbindlich eine Anfrage. Auch Fragen oder Vorschläge nehmen wir gerne hier direkt entgegen. Für allgemeine Fragen werfen Sie zuerst einen Blick in unsere
        <a href="#faq">FAQ's</a>, dort finden Sie auch einige Antworten. Wir freuen uns auf Ihre Nachricht!
      </p>

      <!-- Formspree-Formular (mit JS) -->
      <form id="contactForm" class="contact-form">
        <input
          type="hidden"
          name="_subject"
          value="Neue Anfrage von Kunstwolff Website"
        />

        <input type="text" name="name" placeholder="Name" required />
        <input type="email" name="email" placeholder="E-Mail" required />
        <input type="tel" name="phone" placeholder="Telefon" required />
        <input
          type="date"
          name="date"
          required
          onfocus="this.showPicker()"
          placeholder="Datum des Events"
          style="color: #fff;"
        />

        <textarea name="message" placeholder="Ihre Anfrage" required></textarea>

        <button type="submit">Anfrage senden</button>
      </form>

      <div
        id="formMessage"
        style="display:none; color:#0f0; margin-top:10px; text-align:center; font-weight:700;"
      >
        Sent!
      </div>

      <!-- alternative Kontaktinfos -->
      <div class="contact-info">
        <p>Telefon: +49 (0)173 6677 229</p>
        <p>E-Mail: info@artelines.com</p>
      </div>
    </div>
  </section>

  <style>
    .contact {
      background: #000;
}

    .contact-intro {
      max-width: 860px;
      margin: 0 0 16px;
      text-align: left;
      line-height: 1.7;
      opacity: 0.9;
    }

    .contact-intro a {
      color: inherit;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

.contact-form {
  display: grid;
  grid-template-columns: 1fr 1fr;
