}

.contact-form input,
.contact-form textarea {
  background: transparent;
  border: 1px solid rgba(255,255,255,0.2);
  padding: 14px;
  color: #fff;
  font-size: 14px;
}

.contact-form button {
  grid-column: span 2;
  padding: 14px;
