---
import { getWhyBenefits } from '../utils/why';
import { isPageHiddenByPath } from '../utils/pageVisibility';
import { WHY_DETAIL_LINKS } from '../utils/whyDetailLinks';
import { getSiteTexts } from '../utils/siteTexts';

const { skill, landing } = Astro.props as {
  skill?: string;
  landing?: string;
};

// Positions-zu-Detailseite-Liste zentral in whyDetailLinks.ts (per Test gegen
// die titelbasierte Auflösung + default.json abgesichert, siehe WEB-007/P3-2).
const benefits = getWhyBenefits(skill, landing);
const detailLinks = WHY_DETAIL_LINKS;
const whyText = getSiteTexts().why;
---

<section class="why-section">
  <div class="why-container">

    <div class="why-header">
      <h2>{whyText.heading}</h2>
      <p>{whyText.intro}</p>
    </div>

    <div class="why-grid">
      {benefits.map((benefit, i) => {
        const targetLink = detailLinks[i] ?? null;
        const linkVisible = !!targetLink && !isPageHiddenByPath(targetLink);
        return linkVisible && targetLink ? (
          <a class="why-item why-item--link" href={targetLink}>
            <img src={benefit.image} alt={benefit.alt} loading="lazy" />
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </a>
        ) : (
          <div class="why-item">
            <img src={benefit.image} alt={benefit.alt} loading="lazy" />
            <h3>{benefit.title}</h3>
            <p>{benefit.text}</p>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
.why-section {
  padding: 80px 20px;
  background: #f5f5f5;
  color: #000;
}

.why-container {
  max-width: 1200px;
  margin: 0 auto;
}

.why-header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 60px auto;
}

.why-header h2 {
  font-size: clamp(2.4rem, 5vw, 3.6rem);
  margin-bottom: 15px;
  color: #000;
  font-family: "Mayonice", Georgia, serif;
  font-weight: 400;
  line-height: 1.25;
  letter-spacing: 0.01em;
}

.why-header p {
  font-size: 1.1rem;
  color: #333;
  font-family: var(--font-body);
}

.why-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 30px;
}

@media (max-width: 768px) {
  .why-grid {
    grid-template-columns: 1fr;
    gap: 25px;
  }
}

.why-item {
  background: #fff;
  padding: 30px;
  border-radius: 12px;
  text-align: center;
  box-shadow: 0 10px 30px rgba(0,0,0,0.06);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.why-item--link {
  display: block;
  text-decoration: none;
  color: inherit;
}

.why-item:hover {
  transform: translateY(-6px);
  box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}

.why-item img {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 10;
  object-fit: cover;
  border-radius: 8px;
  margin-bottom: 20px;
}

.why-item h3 {
  margin-bottom: 10px;
  font-size: 1.2rem;
  color: #000;
  font-family: var(--font-headings);
}

.why-item p {
  font-size: 0.95rem;
  color: #444;
  line-height: 1.6;
  font-family: var(--font-body);
}
</style>