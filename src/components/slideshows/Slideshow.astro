---

type Slide = {
    src: string;
    alt?: string;
    title?: string;
    categories?: string[];
    width?: number;
};

import { buildSrcSet, SLIDESHOW_SIZES } from '../../utils/responsiveImages';
import { GALERIE_URL } from '../../utils/gallery';

const { items = [], filteredCategories = [] } = Astro.props;

const filteredItems =
    filteredCategories.length === 0
        ? items
        : items.filter((slide: Slide) => {
              if (!slide.categories || slide.categories.length === 0) {
                  return false;
              }

              return slide.categories.some((cat) => filteredCategories.includes(cat));
          });


---

<!--
  Leer-Guard: ohne ihn rendert die Sektion samt Ueberschrift "Unsere Kunst" auch
  dann, wenn nach dem Skill-Filter kein einziges Bild uebrig bleibt - eine
  Ueberschrift ueber dem Nichts. Betraf gemessen 38 von 105 Skill-Stadt-Seiten
  (siehe reports/tagsystem-audit-2026-07-30.md, B1/B2).
-->
{filteredItems.length > 0 && (
<section class="section gallery">
    <h2>Unsere Kunst</h2>

    <div class="swiper mySwiper">
        <div class="swiper-wrapper">
            {
                filteredItems.map((slide: Slide) => (
                    <div class="swiper-slide">
                        <a class="lg-item" href={slide.src} data-title={slide.title ?? ""}>
                            <img
                                src={slide.src}
                                srcset={buildSrcSet(slide.src, slide.width)}
                                sizes={SLIDESHOW_SIZES}
                                alt={slide.alt ?? ""}
                                loading="lazy"
                                decoding="async"
                            />
                        </a>
                    </div>
                ))
            }
        </div>

        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-pagination"></div>
    </div>

    {/* Die Slideshow zeigt immer nur einen Ausschnitt (Startseite: die kuratierte
        Auswahl, Landing/Event: die Bilder mit dem passenden Tag). Der Link führt
        auf den vollständigen Bestand – gleiche Rolle wie der FAQ-Link unter der
        gekürzten FAQ-Liste. Steht in der Komponente und damit unter JEDEM
        "Unsere Kunst"-Banner, auf allen Seitentypen. */}
    <p class="gallery-all-link">
        <a href={GALERIE_URL}>Alle Bilder in der Galerie ansehen</a>
    </p>
</section>
)}

<script>
    import Swiper from "swiper";
    import { Autoplay, Navigation, Pagination } from "swiper/modules";

    // Lightbox: gemeinsame Implementierung, siehe src/scripts/lightbox.ts.
    // Lag bis zur Galerie hier inline – mit einem zweiten Aufrufer waeren daraus
    // zwei Kopien geworden, die bei der naechsten Aenderung auseinanderlaufen.
    import { openLightbox, type LbSlide } from "../../scripts/lightbox";

    // =====================================================================
    // UNIFORM IMAGE HEIGHT
    // =====================================================================
    const syncUniformImageHeights = (host: HTMLElement) => {
        const images = Array.from(host.querySelectorAll(".swiper-slide img")) as HTMLImageElement[];

        if (images.length === 0) {
            return;
        }

        host.classList.remove("uniform-image-height");
        host.style.removeProperty("--slide-image-height");

        requestAnimationFrame(() => {
            let tallestHeight = 0;

            images.forEach((img) => {
                const { height } = img.getBoundingClientRect();

                if (height > tallestHeight) {
                    tallestHeight = height;
                }
            });

            if (tallestHeight > 0) {
                host.style.setProperty("--slide-image-height", `${Math.round(tallestHeight)}px`);
                host.classList.add("uniform-image-height");
            }
        });
    };

    // WEB-005: EIN globaler resize-Handler (einmal pro Window) statt einer pro
    // Slider – sonst akkumulieren die Listener bei Astro-View-Transitions und
    // referenzieren detachten DOM. Recalc für alle aktuell vorhandenen Slider.
    if (!(window as unknown as { __kwSlideshowResizeBound?: boolean }).__kwSlideshowResizeBound) {
        (window as unknown as { __kwSlideshowResizeBound?: boolean }).__kwSlideshowResizeBound = true;
        window.addEventListener("resize", () => {
            document.querySelectorAll<HTMLElement>(".mySwiper").forEach((host) =>
                syncUniformImageHeights(host),
            );
        });
    }

    // =====================================================================
    // SLIDER INIT
    // =====================================================================
    const initSliders = () => {
        const sliderElements = document.querySelectorAll(".mySwiper");

        sliderElements.forEach((sliderElement) => {
            const host = sliderElement as HTMLElement;

            if (host.dataset.sliderInitialized === "true") {
                return;
            }

            const slidesCount = host.querySelectorAll(".swiper-slide").length;
            const paginationEl = host.querySelector(".swiper-pagination");
            const nextEl = host.querySelector(".swiper-button-next");
            const prevEl = host.querySelector(".swiper-button-prev");

            if (!paginationEl || !nextEl || !prevEl || slidesCount === 0) {
                return;
            }

            host.dataset.sliderInitialized = "true";

            // Slides VOR Swiper-Init sammeln (noch keine Duplikate durch Loop)
            const lgAnchors = Array.from(host.querySelectorAll<HTMLAnchorElement>(
                ".swiper-slide .lg-item"
            ));
            const slides: LbSlide[] = lgAnchors.map((a) => ({
                src: a.getAttribute("href") || "",
                alt: a.querySelector("img")?.getAttribute("alt") || "",
                title: a.getAttribute("data-title") || "",
            }));

            // Click-Handler via Event-Delegation (funktioniert auch auf geklonten Swiper-Slides)
            host.addEventListener("click", (e) => {
                const lgItem = (e.target as HTMLElement).closest(".lg-item");
                if (!lgItem) return;
                e.preventDefault();
                const href = lgItem.getAttribute("href") || "";
                const idx = slides.findIndex((s) => s.src === href);
                openLightbox(slides, idx >= 0 ? idx : 0);
            });

            const sliderImages = Array.from(host.querySelectorAll(".swiper-slide img")) as HTMLImageElement[];
            const recalcUniformHeight = () => syncUniformImageHeights(host);

            sliderImages.forEach((img) => {
                if (!img.complete) {
                    img.addEventListener("load", recalcUniformHeight, { once: true });
                    img.addEventListener("error", recalcUniformHeight, { once: true });
                }
            });

            recalcUniformHeight();
            // (resize wird global gebunden, s.o. – nicht pro Slider, sonst Leak)

            new Swiper(host, {
                modules: [Autoplay, Navigation, Pagination],
                slidesPerView: "auto",
                spaceBetween: 10,
                loop: slidesCount > 1,
                watchOverflow: true,
                observer: true,
                observeParents: true,
                preventClicks: false,
                preventClicksPropagation: false,
                autoplay: {
                    delay: 2500,
                    disableOnInteraction: false,
                    pauseOnMouseEnter: false,
                },
                pagination: {
                    el: paginationEl as HTMLElement,
                    clickable: true,
                },
                navigation: {
                    nextEl: nextEl as HTMLElement,
                    prevEl: prevEl as HTMLElement,
                },
            });
        });
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initSliders, { once: true });
    } else {
        initSliders();
    }
</script>

<style>
    .gallery.section {
        padding-top: 60px;
    }

    .gallery h2 {
        text-align: center;
    }

    .mySwiper {
        position: relative;
        --slide-image-height: 500px;
    }

    .swiper-slide {
        text-align: center;
        font-size: 18px;
        background: #000000;
        display: flex;
        justify-content: center;
        align-items: center;
        width: auto;
        min-height: 400px;
    }


    .swiper-slide img {
        display: block;
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 500px;
        object-fit: contain;
    }

    .lg-item {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 100%;
        cursor: zoom-in;
    }

    .mySwiper.uniform-image-height .swiper-slide,
    .mySwiper.uniform-image-height .lg-item {
        min-height: var(--slide-image-height);
        width: auto;
    }

    .mySwiper.uniform-image-height .swiper-slide img {
        height: var(--slide-image-height);
        width: auto;
        max-width: none;
        max-height: none;
    }

    .swiper-pagination {
        display: none;
    }

    .swiper-button-next,
    .swiper-button-prev {
        color: #d4af37;
        z-index: 10;
    }

    .swiper-button-next::after,
    .swiper-button-prev::after {
        font-size: 24px;
        font-weight: 700;
    }

    /* Verweis auf die Galerie – Gold-Unterstrich wie der FAQ-Weiterlink,
       damit "hier geht es weiter" seitenweit gleich aussieht. */
    .gallery-all-link {
        margin-top: 18px;
        text-align: center;
        font-size: 0.95rem;
    }

    .gallery-all-link a {
        color: #d7b96a;
        text-decoration: none;
        border-bottom: 1px solid rgba(215, 185, 106, 0.65);
        padding-bottom: 2px;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    .gallery-all-link a:hover,
    .gallery-all-link a:focus-visible {
        color: #fff;
        border-color: #fff;
    }
</style>
