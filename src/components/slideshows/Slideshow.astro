---

type Slide = {
    src: string;
    alt?: string;
    categories?: string[];
};

const { items = [], filteredCategories = [] } = Astro.props;

const filteredItems =
    filteredCategories.length === 0
        ? items
        : items.filter((slide: Slide) =>
              slide.categories?.some((cat) => filteredCategories.includes(cat)),
          );


---

<section class="section gallery">
    <h2>Unsere Kunst</h2>

    <div class="swiper mySwiper">
        <div class="swiper-wrapper">
            {
                filteredItems.map((slide: Slide) => (
                    <div class="swiper-slide">
                        <a class="lg-item" href={slide.src}>
                            <img src={slide.src} alt={slide.alt ?? ""} />
                        </a>
                    </div>
                ))
            }
        </div>

        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-pagination"></div>
    </div>
</section>

<script>
    import Swiper from "swiper";
    import { Autoplay, Navigation, Pagination } from "swiper/modules";
    import lightGallery from "lightgallery";
    import "lightgallery/css/lightgallery.css";

    const sliderElements = document.querySelectorAll(".mySwiper");

    sliderElements.forEach((sliderElement) => {
        const paginationEl = sliderElement.querySelector(".swiper-pagination");
        const nextEl = sliderElement.querySelector(".swiper-button-next");
        const prevEl = sliderElement.querySelector(".swiper-button-prev");

        if (!paginationEl || !nextEl || !prevEl) {
            return;
        }

        new Swiper(sliderElement as HTMLElement, {
            modules: [Autoplay, Navigation, Pagination],
            slidesPerView: 3,
            spaceBetween: 10,
            loop: true,
            preventClicks: false,
            preventClicksPropagation: false,
            autoplay: {
                disableOnInteraction: false,
            },
            pagination: {
                el: paginationEl as HTMLElement,
                clickable: true,
            },
            navigation: {
                nextEl: nextEl as HTMLElement,
                prevEl: prevEl as HTMLElement,
            },
        });

        lightGallery(sliderElement as HTMLElement, {
            selector: ".lg-item",
            download: false,
        });
    });
</script>

<style>
    .mySwiper {
        position: relative;
    }

    .swiper-slide {
        text-align: center;
        font-size: 18px;
        background: #000000;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 400px; /* optional: Höhe des Slides, kann angepasst werden */
    }

    .swiper-slide img {
        display: block;
        width: 100%;
        height: 100%;
        max-width: 90%; /* Bild maximal 90% der Breite */
        max-height: 500px; /* Bild maximal 500px hoch */
        object-fit: contain; /* Bild komplett sichtbar, nicht abgeschnitten */
    }

    .lg-item {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 100%;
        cursor: zoom-in;
    }

    .swiper-button-next,
    .swiper-button-prev {
        color: #d4af37;
        z-index: 10;
    }

    .swiper-button-next::after,
    .swiper-button-prev::after {
        font-size: 24px;
        font-weight: 700;
    }
</style>
