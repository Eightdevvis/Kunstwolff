---
import { getVisibleLandingSlugs } from "../utils/landings";
import { cityComboPath, skillSlugFromLink } from "../utils/comboUrls";

const cities = getVisibleLandingSlugs();

/**
 * `skillSlug` gesetzt  → Links auf die Kombi-Seiten (`/berlin-szenenmaler/`)
 * `skillSlug` leer     → Links auf die reinen Stadtseiten (`/berlin/`)
 *
 * Früher hiess die Prop `site` und war ein URL-Präfix, aus dem hier
 * `${praefix}/${stadt}` zusammengesetzt wurde. Seit die Ort-Kombis flach sind,
 * ist das kein Präfix mehr – die Adresse baut `cityComboPath`, damit sie an
 * einer Stelle festgelegt bleibt.
 */
const { skillSlug = "" } = Astro.props;
const normalizedSkill = skillSlugFromLink(String(skillSlug));
---

<!-- =========================
     LANDING PAGE LINKS / CTA
========================= -->
<section class="section landing-links">
  <div class="section-inner">
    <p>
      Orte:<br />

      {
        cities.map((city, index) => (
          <>
            <a href={normalizedSkill ? cityComboPath(normalizedSkill, city) : `/${city}/`}>
              {city.charAt(0).toUpperCase() + city.slice(1)}
            </a>
            {index < cities.length - 1 && " · "}
          </>
        ))
      }
    </p>
  </div>
</section>

<style>
  .landing-links {
    background: #000000;
    padding: 60px 40px;
  }

  .landing-links p {
    font-size: 14px;
    letter-spacing: 0.12em;
  }

  .landing-links a {
    color: #fff;
    text-decoration: none;
    opacity: 0.8;
  }

  .landing-links a:hover {
    opacity: 1;
  }
</style>
