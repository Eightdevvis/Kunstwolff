---
import { getVisibleLandingSlugs } from "../utils/landings";
import { cityComboPath, skillSlugFromLink } from "../utils/comboUrls";
import { getCityDisplayName } from "../utils/cityNames";
import { isPageHiddenByPath } from "../utils/pageVisibility";

const cities = getVisibleLandingSlugs();

/**
 * `skillSlug` gesetzt  → Links auf die Kombi-Seiten (`/berlin-szenenmaler/`)
 * `skillSlug` leer     → Links auf die reinen Stadtseiten (`/berlin/`)
 *
 * Früher hiess die Prop `site` und war ein URL-Präfix, aus dem hier
 * `${praefix}/${stadt}` zusammengesetzt wurde. Seit die Ort-Kombis flach sind,
 * ist das kein Präfix mehr – die Adresse baut `cityComboPath`, damit sie an
 * einer Stelle festgelegt bleibt.
 */
const { skillSlug = "" } = Astro.props;
const normalizedSkill = skillSlugFromLink(String(skillSlug));

/**
 * Ist die Kombi-Seite ausgeblendet (`page-visibility.json` → `noindex, nofollow`),
 * zeigt der Link auf die Stadtseite (2026-11-20). Vorher liefen von den
 * indexierbaren Skill-Seiten 30 Links in ausgeblendete Kombis – Sackgassen für
 * Crawler, weil dort auch `nofollow` gilt.
 */
const cityHref = (city: string): string => {
  if (!normalizedSkill) return `/${city}/`;
  const combo = cityComboPath(normalizedSkill, city);
  return isPageHiddenByPath(combo) ? `/${city}/` : combo;
};
---

<!-- =========================
     LANDING PAGE LINKS / CTA
========================= -->
<section class="section landing-links">
  <div class="section-inner">
    <p>
      Orte:<br />

      {
        cities.map((city, index) => (
          <>
            <a href={cityHref(city)}>
              {getCityDisplayName(city)}
            </a>
            {index < cities.length - 1 && " · "}
          </>
        ))
      }
    </p>
  </div>
</section>

<style>
  .landing-links {
    background: #000000;
    padding: 60px 40px;
  }

  .landing-links p {
    font-size: 14px;
    letter-spacing: 0.12em;
  }

  .landing-links a {
    color: #fff;
    text-decoration: none;
    opacity: 0.8;
  }

  .landing-links a:hover {
    opacity: 1;
  }
</style>
