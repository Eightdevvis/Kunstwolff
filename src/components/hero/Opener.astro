---
import BrandStripe from "../reviews-references/BrandStripe.astro";
const { titleImage = '/img/Titelbild/default/titelbild.avif', titleImageAlt = 'Kunstwolff - Eventkünstler seit über 20 Jahren', titleImagePosition = 'center', heading = 'Event- und Showkünstler seit über 25 Jahren' } = Astro.props;
---
<style>
.hero {
  width: 100%;
  min-height: calc(100dvh - 60px);
  background: var(--hero-bg-image) var(--hero-bg-pos, center) / cover no-repeat;

  display: flex;
  justify-content: center;
  align-items: center;

  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.hero::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120px;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.98) 0%,
    rgba(0, 0, 0, 0.82) 32%,
    rgba(0, 0, 0, 0.24) 70%,
    rgba(0, 0, 0, 0) 100%
  );
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  mask-image: linear-gradient(
    to top,
    rgba(0, 0, 0, 1) 0%,
    rgba(0, 0, 0, 0.98) 46%,
    rgba(0, 0, 0, 0.45) 76%,
    rgba(0, 0, 0, 0) 100%
  );
  -webkit-mask-image: linear-gradient(
    to top,
    rgba(0, 0, 0, 1) 0%,
    rgba(0, 0, 0, 0.98) 46%,
    rgba(0, 0, 0, 0.45) 76%,
    rgba(0, 0, 0, 0) 100%
  );
  pointer-events: none;
}

.hero-band {
  transform: translateY(20vh);
  background: rgba(0, 0, 0, 0.55);
  padding: clamp(20px, 5vw, 32px) clamp(20px, 6vw, 48px);
  max-width: min(1000px, 100%);
  box-sizing: border-box;
  text-align: center;
}


/* Marken-Wortmarke (visuell groß, aber semantisch KEINE Überschrift) */
.hero-brand {
  font-family: Mayonice;
  font-weight: 200;
  font-size: clamp(2.5rem, 14vw, 80px);
  line-height: 1.05;
  margin-bottom: 16px;
}

/* H1 = keyword-/ortsrelevante Überschrift pro Seite (optisch wie alter Untertitel) */
.hero-band h1 {
  font-size: clamp(0.75rem, 2.8vw, 18px);
  letter-spacing: clamp(0.08em, 1.2vw, 0.18em);
  margin-top: 8px;
  font-weight: 100;
  opacity: 0.85;
  text-transform: uppercase;
}

.hero-band p {
  font-size: clamp(0.75rem, 2.8vw, 18px);
  letter-spacing: clamp(0.08em, 1.2vw, 0.18em);
  margin-top: 8px;
  font-weight: 100;
  opacity: 0.75;
}
</style>



<!-- Hero Section -->
  <section class="hero" style={`--hero-bg-image: url('${titleImage}'); --hero-bg-pos: ${titleImagePosition}`}>
    <!-- Unsichtbares Bild für SEO / Alt-Text ECHTES BILD LIEGT IN CSSstartpage.css!!!!-->
    <img
      src={titleImage}
      alt={titleImageAlt}
      style="display:none;"
    />

    <!-- Overlay-Streifen für Text -->
    <div class="hero-band">
      <p class="hero-brand">Kunstwolff</p>
      <h1>{heading}</h1>
    </div>
  </section>

  <BrandStripe />