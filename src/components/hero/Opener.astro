---
import BrandStripe from "../reviews-references/BrandStripe.astro";
import { heroHintergrundStyle } from "../../utils/responsiveImages";
const { titleImage = '/img/Titelbild/default/titelbild.avif', titleImageAlt = 'Kunstwolff - Eventkünstler seit über 25 Jahren', titleImagePosition = 'center', titleImageFrame = 0, heading = 'Event- und Showkünstler seit über 25 Jahren' } = Astro.props;

// Weißer Rahmen: bei frame > 0 wird das Bild via `contain` komplett gezeigt
// (nichts wird beschnitten) und mit einem weißen Rand dieser Dicke eingefasst.
// So legt sich der Rahmen bei abweichenden Bildmaßen automatisch drumherum.
const frameThickness = Number(titleImageFrame);
const framed = Number.isFinite(frameThickness) && frameThickness > 0;
const heroFit = framed ? 'contain' : 'cover';
const heroFrame = framed ? `${frameThickness}px` : '0px';
// Kleinere Ausgaben desselben Bildes als eigene Variablen; die Media-Queries
// unten greifen sie ab. Fehlen sie (AVIF, zu kleines Original), bleibt es beim
// Original – der `var(…, …)`-Rückfall regelt das ohne Sonderfall im Markup.
const heroVarianten = heroHintergrundStyle(titleImage);
const heroStyle = `--hero-bg-image: url('${titleImage}'); ${heroVarianten}--hero-bg-pos: ${titleImagePosition}; --hero-fit: ${heroFit}; --hero-frame: ${heroFrame};`;
---
<style>
.hero {
  width: 100%;
  min-height: calc(100dvh - 60px);
  /* Longhand statt Shorthand, damit der weiße Rahmen (Padding + weißer Grund)
     und der Fit-Modus (cover/contain) per CSS-Variable steuerbar sind.
     background-origin/-clip = content-box → das Bild sitzt INNERHALB des
     Paddings, die Paddingfläche zeigt den weißen Grund = der Rahmen. */
  background-color: #fff;
  background-image: var(--hero-bg-image);
  background-position: var(--hero-bg-pos, center);
  background-repeat: no-repeat;
  background-size: var(--hero-fit, cover);
  background-origin: content-box;
  background-clip: content-box;
  padding: var(--hero-frame, 0px);

  display: flex;
  justify-content: center;
  align-items: center;

  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* ── Kleinere Ausgabe für kleinere Bildschirme ──────────────────────────────
   Ein CSS-Hintergrund kennt kein `srcset`, deshalb hier von Hand. Die
   Variablen setzt `heroHintergrundStyle()` im style-Attribut; fehlen sie,
   greift der zweite Wert in `var(…, …)` und es bleibt beim Original — der
   Grund, warum es kein AVIF-Sonderfall gibt.

   Gemessen an /berlin/ (2026-07-31): Original 246 KB · 1200er 133 KB ·
   800er 78 KB. Auf einem gewöhnlichen Handy landen also 78 statt 246 KB, und
   zwar für das Bild, das als erstes über dem Falz steht.

   Die Pixeldichte MUSS mit rein: auf einem Retina-Handy sind 640 CSS-Punkte
   1280 echte Pixel, dort wäre die 800er sichtbar weich. Browser ohne
   `resolution`-Abfrage (Safari < 16) treffen keine der Regeln und bekommen das
   Original — schlechter Fall, aber nie ein unscharfes Bild. */
@media (max-width: 640px) and (max-resolution: 1.5dppx) {
  .hero {
    background-image: var(--hero-bg-800, var(--hero-bg-image));
  }
}

@media (max-width: 640px) and (min-resolution: 1.5dppx) {
  .hero {
    background-image: var(--hero-bg-1200, var(--hero-bg-image));
  }
}

@media (min-width: 641px) and (max-width: 1200px) and (max-resolution: 1.5dppx) {
  .hero {
    background-image: var(--hero-bg-1200, var(--hero-bg-image));
  }
}

.hero::after {
  content: "";
  position: absolute;
  /* innerhalb des weißen Rahmens bleiben (frame = 0 → bündig wie bisher) */
  left: var(--hero-frame, 0px);
  right: var(--hero-frame, 0px);
  bottom: var(--hero-frame, 0px);
  height: 120px;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.98) 0%,
    rgba(0, 0, 0, 0.82) 32%,
    rgba(0, 0, 0, 0.24) 70%,
    rgba(0, 0, 0, 0) 100%
  );
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  mask-image: linear-gradient(
    to top,
    rgba(0, 0, 0, 1) 0%,
    rgba(0, 0, 0, 0.98) 46%,
    rgba(0, 0, 0, 0.45) 76%,
    rgba(0, 0, 0, 0) 100%
  );
  -webkit-mask-image: linear-gradient(
    to top,
    rgba(0, 0, 0, 1) 0%,
    rgba(0, 0, 0, 0.98) 46%,
    rgba(0, 0, 0, 0.45) 76%,
    rgba(0, 0, 0, 0) 100%
  );
  pointer-events: none;
}

.hero-band {
  transform: translateY(20vh);
  background: rgba(0, 0, 0, 0.55);
  padding: clamp(20px, 5vw, 32px) clamp(20px, 6vw, 48px);
  max-width: min(1000px, 100%);
  box-sizing: border-box;
  text-align: center;
}


/* Marken-Wortmarke (visuell groß, aber semantisch KEINE Überschrift) */
.hero-brand {
  font-family: Mayonice;
  font-weight: 200;
  font-size: clamp(2.5rem, 14vw, 80px);
  line-height: 1.05;
  margin-bottom: 16px;
}

/* H1 = keyword-/ortsrelevante Überschrift pro Seite (optisch wie alter Untertitel) */
.hero-band h1 {
  font-size: clamp(0.75rem, 2.8vw, 18px);
  letter-spacing: clamp(0.08em, 1.2vw, 0.18em);
  margin-top: 8px;
  font-weight: 100;
  opacity: 0.85;
  text-transform: uppercase;
}

.hero-band p:not(.hero-brand) {
  font-size: clamp(0.75rem, 2.8vw, 18px);
  letter-spacing: clamp(0.08em, 1.2vw, 0.18em);
  margin-top: 8px;
  font-weight: 100;
  opacity: 0.75;
}
</style>



<!-- Hero Section -->
  <section class="hero" style={heroStyle}>
    <!-- Unsichtbares Bild für SEO / Alt-Text ECHTES BILD LIEGT IN CSSstartpage.css!!!!-->
    <img
      src={titleImage}
      alt={titleImageAlt}
      style="display:none;"
    />

    <!-- Overlay-Streifen für Text -->
    <div class="hero-band">
      <p class="hero-brand">Kunstwolff</p>
      <h1>{heading}</h1>
    </div>
  </section>

  <BrandStripe />