---
import MiniReviews from '../reviews-references/MiniReviews.astro';
import BrandStripe from '../reviews-references/BrandStripe.astro';
import { heroSrcSet, HERO_SIZES, HERO_BG_SIZES } from '../../utils/responsiveImages';

const {
  title = 'Live Event-Künstler',
  reviews = [],
  titleImage = '',
  titleImageAspect = null,
  skillName = '',
  backgroundImage = '',
} = Astro.props;

// Das Hero-Bild ist auf fast jeder Seite das grösste Einzelobjekt und wird
// SOFORT geladen (kein lazy) – hier zahlt sich eine passende Grösse am meisten
// aus. Leerer String = keine Variante bekannt, dann bleibt es beim Original.
const titleSrcSet = heroSrcSet(titleImage);
const bgSrcSet = heroSrcSet(backgroundImage);

// Aspect-Ratio des Titelbildes für Mobil: analog zum Opener-Fix (M3) wird der
// Bild-Container auf Portrait-Handys nicht mehr auf feste 300 px gezwungen,
// sondern nimmt das Bild-Aspect an — sonst croppt `object-fit: cover` das
// Landscape-Titelbild an einer Portrait-Kachel. Fehlt die Var, greift die
// Regel nicht → alter Zustand bleibt, kein 0-Pixel-Container.
const heroAspect = typeof titleImageAspect === 'string' && titleImageAspect.trim() !== '' ? titleImageAspect : null;
const heroMediaStyle = heroAspect ? `--hero-media-aspect: ${heroAspect};` : undefined;
---

<div class="hero section">
  {backgroundImage && (
    <img
      class="hero-bg"
      src={backgroundImage}
      srcset={bgSrcSet || undefined}
      sizes={bgSrcSet ? HERO_BG_SIZES : undefined}
      alt=""
      aria-hidden="true"
      loading="eager"
    />
  )}
  <div class="hero-inner section-inner">
    <div class="hero-content">
      <h1>{title}</h1>
      
      <div class="hero-badges">
        <span>International</span>
        <span>5.0 Google</span>
      </div>

      {skillName && reviews.length > 0 && (
        <MiniReviews items={reviews} filteredCategories={[skillName]} />
      )}
      {!skillName && reviews.length > 0 && (
        <MiniReviews items={reviews} />
      )}
    </div>

    <div class="hero-media" style={heroMediaStyle}>
      {titleImage && (
        <img
          src={titleImage}
          srcset={titleSrcSet || undefined}
          sizes={titleSrcSet ? HERO_SIZES : undefined}
          alt={title}
        />
      )}
    </div>
  </div>

  <div class="hero-brandstripe">
    <BrandStripe />
  </div>

  <style>
    .hero {
      width: 100%;
      min-height: 100vh;
      background:
        radial-gradient(circle at 18% 18%, #ffffff 0%, #f9f9f9 16%, #ececec 34%, #d6d6d6 58%, #bcbcbc 100%),
        radial-gradient(circle at 78% 72%, rgba(255, 255, 255, 0.72) 0%, rgba(255, 255, 255, 0.18) 36%, rgba(255, 255, 255, 0) 60%),
        radial-gradient(circle at 8% 92%, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0) 52%);
      color: #111;
      padding-top: 100px;
      padding-bottom: 160px;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.12;
      pointer-events: none;
      z-index: 0;
    }

    .hero-inner {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 96px;
      align-items: center;
    }

    .hero-content h1 {
      font-family: "Mayonice", system-ui, sans-serif;
      font-size: clamp(2.8rem, 5vw, 4rem);
      font-weight: 400;
      line-height: 1.1;
      letter-spacing: 0.02em;
      margin-bottom: 24px;
      color: #111;
    }

    .hero-content p {
      font-size: 18px;
      line-height: 1.6;
      opacity: 0.85;
      max-width: 520px;
      color: #222;
    }

    .hero-badges {
      display: flex;
      gap: 24px;
      margin-top: 32px;
    }

    .hero-badges span {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      opacity: 0.9;
      color: #222;
    }

    .hero-media {
      width: 100%;
      height: 420px;
      border-radius: 24px;
      background: #dcdcdc;
      overflow: hidden;
      border: 1px solid #d1d1d1;
    }

    .hero-media img,
    .hero-media video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hero-brandstripe {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 3;
    }

    @media (max-width: 900px) {
      .hero-inner {
        grid-template-columns: 1fr;
        gap: 64px;
      }

      .hero {
        padding-top: 120px;
        padding-bottom: 120px;
      }

      .hero-media {
        height: 300px;
      }
    }

    /* Portrait-Handy: Media-Kachel übernimmt das Bild-Aspect-Ratio, damit das
       Titelbild nicht auf 300 px feste Höhe gecropped wird. Analog zum
       Opener-Fix (M3). Fehlt `--hero-media-aspect`, ist die Property invalid
       und die Regel greift nicht — dann bleibt es bei den 300 px. */
    @media (max-width: 640px) {
      .hero-media {
        height: auto;
        aspect-ratio: var(--hero-media-aspect);
      }
    }
  </style>
</div>
