---
import { getBrandLogos } from '../../utils/brandLogos';

const logoItems = getBrandLogos();

const loopSpeedMultiplier = 1.6;
const baseLoopDurationSeconds = Math.max(20, logoItems.length * 3.5);
const loopDurationSeconds = baseLoopDurationSeconds * loopSpeedMultiplier;
---

<!-- =========================
     BRAND STRIPE / LOGOS
========================= -->
<section class="brand-stripe" style={`--brand-loop-duration: ${loopDurationSeconds}s;`}>
  <div class="brand-marquee">
    <div class="brand-track">
      <div class="brand-group">
        {logoItems.map((logo) => (
          <div class="brand-slot" data-logo-name={logo.label}>
            <img
              class="brand-item"
              src={logo.src}
              alt={`Referenzlogo ${logo.label}`}
              loading="eager"
              decoding="async"
            />
          </div>
        ))}
      </div>

      <div class="brand-group" aria-hidden="true">
        {logoItems.map((logo) => (
          <div class="brand-slot" data-logo-name={logo.label}>
            <img
              class="brand-item"
              src={logo.src}
              alt={`Referenzlogo ${logo.label}`}
              loading="eager"
              decoding="async"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="brand-tooltip" aria-hidden="true"></div>
</section>

<style>
  .brand-stripe {
    --brand-strip-height: 40px;
    --brand-vertical-padding: 0px;
    --brand-top-padding: 12px;
    --brand-bottom-padding: 14px;
    --brand-edge-padding: clamp(18px, 4vw, 40px);
    --brand-slot-height: calc(var(--brand-strip-height) - (var(--brand-vertical-padding) * 2));
    --brand-slot-width: calc(var(--brand-slot-height) * 2.6);
    --brand-gap: 22px;
    --brand-logo-filter: invert(1) grayscale(1) brightness(0.92) contrast(1.36);
    width: 100%;
    background: black;
    padding: var(--brand-top-padding) var(--brand-edge-padding) var(--brand-bottom-padding);
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    margin-top: 16px;
  }

  .brand-marquee {
    width: 100%;
    overflow: hidden;
  }

  .brand-track {
    display: flex;
    width: max-content;
    gap: var(--brand-gap);
    animation: brand-loop var(--brand-loop-duration) linear infinite;
    will-change: transform;
  }

  .brand-group {
    display: flex;
    gap: var(--brand-gap);
    align-items: center;
    flex-wrap: nowrap;
  }

  .brand-slot {
    flex: 0 0 auto;
    width: var(--brand-slot-width);
    height: var(--brand-slot-height);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .brand-item {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: var(--brand-logo-filter);
  }

:global(.brand-stripe[data-brand-theme="light-bg"]) {
  --brand-logo-filter: invert(0) grayscale(1) brightness(0.72) contrast(1.08);
}

:global(body[data-nav-tone="light"]) .brand-stripe {
  --brand-logo-filter: invert(0) grayscale(1) brightness(0.72) contrast(1.08);
}

.brand-tooltip {
  position: fixed;
  left: 0;
  top: 0;
  transform: translate3d(0, 0, 0);
  padding: 6px 10px;
  background: rgba(0, 0, 0, 0.86);
  border: 1px solid rgba(255, 255, 255, 0.24);
  color: #fff;
  font-size: 12px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  z-index: 2000;
  transition: opacity 0.12s ease;
}

.brand-tooltip.is-visible {
  opacity: 1;
}

@media (max-width: 768px) {
  .brand-stripe {
    --brand-gap: 16px;
    --brand-strip-height: 44px;
    --brand-top-padding: 10px;
    --brand-bottom-padding: 12px;
    --brand-edge-padding: clamp(14px, 5vw, 28px);
  }

  .brand-item {
    max-width: 100%;
    max-height: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .brand-track {
    animation: none;
  }
}

@keyframes brand-loop {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(calc(-50% - (var(--brand-gap) / 2)));
  }
}

</style>

<script>
  type RgbaColor = { r: number; g: number; b: number; a: number };

  const parseRgba = (value?: string | null): RgbaColor | null => {
    const match = value
      ?.trim()
      .match(/^rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([0-9.]+))?\)$/i);

    if (!match) {
      return null;
    }

    return {
      r: Number(match[1]),
      g: Number(match[2]),
      b: Number(match[3]),
      a: match[4] === undefined ? 1 : Number(match[4]),
    };
  };

  const srgbToLinear = (channel: number): number => {
    const normalized = channel / 255;
    return normalized <= 0.03928
      ? normalized / 12.92
      : Math.pow((normalized + 0.055) / 1.055, 2.4);
  };

  const luminance = ({ r, g, b }: Pick<RgbaColor, "r" | "g" | "b">): number =>
    0.2126 * srgbToLinear(r) + 0.7152 * srgbToLinear(g) + 0.0722 * srgbToLinear(b);

  const resolveBackgroundSample = (element: Element): RgbaColor => {
    let current: Element | null = element;

    while (current && current !== document.documentElement) {
      const styles = getComputedStyle(current);
      const parsed = parseRgba(styles.backgroundColor);

      if (parsed && parsed.a > 0.05) {
        return parsed;
      }

      current = current.parentElement;
    }

    const bodyColor = parseRgba(getComputedStyle(document.body).backgroundColor);
    if (bodyColor) {
      return bodyColor;
    }

    return { r: 255, g: 255, b: 255, a: 1 };
  };

  const applyStripeTheme = (stripe: HTMLElement): void => {
    const sample = resolveBackgroundSample(stripe);
    const isDarkBackground = luminance(sample) < 0.5;
    stripe.setAttribute("data-brand-theme", isDarkBackground ? "dark-bg" : "light-bg");
  };

  const stripes = document.querySelectorAll('.brand-stripe');

  stripes.forEach((stripe) => {
    applyStripeTheme(stripe as HTMLElement);

    const tooltip = stripe.querySelector<HTMLElement>('.brand-tooltip');
    const logos = stripe.querySelectorAll<HTMLElement>('.brand-slot');

    if (!tooltip || logos.length === 0) return;

    const moveTooltip = (event: MouseEvent) => {
      tooltip.style.left = `${event.clientX + 14}px`;
      tooltip.style.top = `${event.clientY + 18}px`;
    };

    logos.forEach((logo) => {
      logo.addEventListener('mouseenter', (event) => {
        const logoName = logo.getAttribute('data-logo-name') || 'Logo';
        tooltip.textContent = logoName;
        tooltip.classList.add('is-visible');
        moveTooltip(event);
      });

      logo.addEventListener('mousemove', moveTooltip);
      logo.addEventListener('mouseleave', () => {
        tooltip.classList.remove('is-visible');
      });
    });
  });

  window.addEventListener("resize", () => {
    stripes.forEach((stripe) => applyStripeTheme(stripe as HTMLElement));
  });
</script>
