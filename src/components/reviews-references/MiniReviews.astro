---
type Review = {
  author: string;
  text: string;
  categories?: string[];
};

const { items = [], filteredCategories = [] } = Astro.props;

const filteredItems =
  filteredCategories.length === 0
    ? items
    : items.filter((review: Review) =>
        review.categories?.some((cat) => filteredCategories.includes(cat))
      );
---

<div class="review-slider" data-review-rotator>
  <div class="review-track">
    {filteredItems.map((review: Review, index: number) => (
      <div class={`review-slide ${index === 0 ? "is-active" : ""}`}>
        <p class="review-text">&ldquo;{review.text}&rdquo;</p>
        <p class="review-stars" aria-label="5 von 5 Sternen">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
        <span class="review-author">&mdash; {review.author}</span>
      </div>
    ))}
  </div>

  {filteredItems.length > 1 && (
    <div class="review-nav" aria-label="Bewertungen durchblättern">
      <button type="button" class="review-arrow review-prev" aria-label="Vorherige Bewertung">&lsaquo;</button>
      <button type="button" class="review-arrow review-next" aria-label="Nächste Bewertung">&rsaquo;</button>
    </div>
  )}
</div>

<script>
  type RgbaColor = { r: number; g: number; b: number; a: number };

  const parseRgba = (value?: string | null): RgbaColor | null => {
    const match = value
      ?.trim()
      .match(/^rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([0-9.]+))?\)$/i);

    if (!match) {
      return null;
    }

    return {
      r: Number(match[1]),
      g: Number(match[2]),
      b: Number(match[3]),
      a: match[4] === undefined ? 1 : Number(match[4]),
    };
  };

  const srgbToLinear = (channel: number): number => {
    const normalized = channel / 255;
    return normalized <= 0.03928
      ? normalized / 12.92
      : Math.pow((normalized + 0.055) / 1.055, 2.4);
  };

  const luminance = ({ r, g, b }: Pick<RgbaColor, "r" | "g" | "b">): number =>
    0.2126 * srgbToLinear(r) + 0.7152 * srgbToLinear(g) + 0.0722 * srgbToLinear(b);

  const resolveBackgroundSample = (element: Element): RgbaColor => {
    let current: Element | null = element;

    while (current && current !== document.documentElement) {
      const styles = getComputedStyle(current);
      const parsed = parseRgba(styles.backgroundColor);

      if (parsed && parsed.a > 0.05) {
        return parsed;
      }

      current = current.parentElement;
    }

    const bodyColor = parseRgba(getComputedStyle(document.body).backgroundColor);
    if (bodyColor) {
      return bodyColor;
    }

    return { r: 255, g: 255, b: 255, a: 1 };
  };

  const applyReviewTheme = (rotator: Element): void => {
    const sample = resolveBackgroundSample(rotator);
    let isDarkBackground = luminance(sample) < 0.5;

    const inheritedText = parseRgba(getComputedStyle(rotator).color);

    if (inheritedText) {
      const textLuminance = luminance(inheritedText);

      if (textLuminance <= 0.45) {
        isDarkBackground = false;
      } else if (textLuminance >= 0.65) {
        isDarkBackground = true;
      }
    }

    rotator.setAttribute("data-review-theme", isDarkBackground ? "dark-bg" : "light-bg");
  };

  const reviewRotators = document.querySelectorAll<HTMLElement>("[data-review-rotator]");

  reviewRotators.forEach((rotator) => {
    applyReviewTheme(rotator);

    // Manuelles Durchklicken: immer genau EIN Review sichtbar (display:flex),
    // der Rest display:none. Die Höhe ergibt sich aus dem sichtbaren Review im
    // normalen Fluss – kein Stapeln, kein Messen, nichts schneidet ab.
    const slides = Array.from(rotator.querySelectorAll<HTMLElement>(".review-slide"));
    const prevBtn = rotator.querySelector<HTMLButtonElement>(".review-prev");
    const nextBtn = rotator.querySelector<HTMLButtonElement>(".review-next");

    if (slides.length <= 1) {
      return;
    }

    let activeIndex = 0;

    const goTo = (nextIndex: number): void => {
      const target = (nextIndex + slides.length) % slides.length;
      if (target === activeIndex) {
        return;
      }

      slides[activeIndex].classList.remove("is-active");
      activeIndex = target;
      slides[activeIndex].classList.add("is-active");
    };

    prevBtn?.addEventListener("click", () => goTo(activeIndex - 1));
    nextBtn?.addEventListener("click", () => goTo(activeIndex + 1));

    rotator.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        goTo(activeIndex - 1);
      } else if (event.key === "ArrowRight") {
        goTo(activeIndex + 1);
      }
    });
  });

  window.addEventListener("resize", () => {
    reviewRotators.forEach((rotator) => applyReviewTheme(rotator));
  });
</script>

<style>
  .review-slider {
    --review-text-color: rgba(17, 17, 17, 0.92);
    --review-author-color: rgba(34, 34, 34, 0.9);
    --review-stars-color: #d4af37;
    --review-stars-glow: 0 0 8px rgba(212, 175, 55, 0.35);
    --review-stars-glow-strong: 0 0 18px rgba(212, 175, 55, 0.48);
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 860px;
    margin: 0 auto;
    padding: 22px 24px;
  }

  .review-slider[data-review-theme="dark-bg"] {
    --review-text-color: rgba(255, 255, 255, 0.92);
    --review-author-color: rgba(255, 255, 255, 0.9);
    --review-stars-color: #d4af37;
    --review-stars-glow: 0 0 10px rgba(212, 175, 55, 0.48);
    --review-stars-glow-strong: 0 0 22px rgba(212, 175, 55, 0.65);
  }

  .review-track {
    width: 100%;
  }

  /* Genau ein Review sichtbar, ganz normal im Fluss gestapelt: Text, Sterne,
     Autor untereinander. Der Rest ist display:none und nimmt keinen Platz weg. */
  .review-slide {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
    padding: 18px 22px;
  }

  .review-slide.is-active {
    display: flex;
    animation: review-fade-in 380ms ease;
  }

  @keyframes review-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .review-slider .review-text {
    max-width: 700px;
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    line-height: 1.65;
    font-style: normal;
    font-family: var(--font-body);
    color: var(--review-text-color);
    letter-spacing: 0.01em;
  }

  .review-slider .review-stars {
    margin-top: 0;
    font-size: clamp(1.45rem, 2.7vw, 1.8rem);
    letter-spacing: 0.2em;
    color: var(--review-stars-color);
    text-shadow: var(--review-stars-glow), var(--review-stars-glow-strong);
  }

  .review-slider .review-author {
    margin-top: 2px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    text-transform: uppercase;
    color: var(--review-author-color);
    letter-spacing: 0.18em;
    opacity: 0.8;
  }

  /* Navigation: nur Pfeile, direkt unter dem Review */
  .review-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    margin-top: 4px;
  }

  .review-arrow {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.9rem;
    line-height: 1;
    padding: 2px 10px;
    color: var(--review-author-color);
    opacity: 0.55;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .review-arrow:hover,
  .review-arrow:focus-visible {
    opacity: 1;
    transform: scale(1.1);
    outline: none;
  }

  @media (max-width: 768px) {
    .review-slider {
      padding: 16px 14px;
    }

    .review-slide {
      padding: 14px 12px;
    }

    .review-slider .review-stars {
      font-size: clamp(1.3rem, 5.2vw, 1.65rem);
      letter-spacing: 0.15em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .review-slide.is-active {
      animation: none;
    }
  }
</style>
