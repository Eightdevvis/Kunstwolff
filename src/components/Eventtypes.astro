---
type EventImageOverride = {
  image?: string;
};

const { events = [], items = [] } = Astro.props as {
  events?: EventImageOverride[];
  items?: EventImageOverride[];
};

const rawOverrides: EventImageOverride[] =
  events && events.length ? events : items;

/*
  FEST DEFINIERTE EVENTTYPEN
  → Titel, Link und ALT bleiben immer gleich (SEO-Kontrolle)
  → Nur image darf überschrieben werden
*/

const DEFAULT_EVENTS = [
  {
    title: "Firmenfeiern & Corporate Events",
    image: "/img/samples/sample1.jpeg",
    link: "/schnellzeichner/firmenfeier/",
    alt: "Schnellzeichner auf einer Firmenfeier zeichnet Gäste live",
    text: "Ein Schnellzeichner bringt Energie in Corporate Events: Gäste werden live porträtiert, kommen ins Gespräch und nehmen eine persönliche Erinnerung mit.",
  },
  {
    title: "Messen & Promotion",
    image: "/img/samples/sample2.jpeg",
    link: "/schnellzeichner/messe/",
    alt: "Schnellzeichner als Besuchermagnet am Messestand",
    text: "Auf Messen sorgt Live-Zeichnen für Aufmerksamkeit am Stand, längere Verweildauer und einen sympathischen Erstkontakt mit Ihrer Marke.",
  },
  {
    title: "Hochzeiten",
    image: "/img/samples/sample3.jpeg",
    link: "/schnellzeichner/hochzeit/",
    alt: "Schnellzeichner zeichnet Brautpaar live auf Hochzeit",
    text: "Bei Hochzeiten entstehen charmante Live-Porträts von Brautpaar und Gästen – unterhaltsam während des Tages und ein besonderes Andenken.",
  },
  {
    title: "Geburtstage & Private Feiern",
    image: "/img/samples/sample4.jpeg",
    link: "/schnellzeichner/private-feier/",
    alt: "Live Karikaturist auf einer privaten Feier",
    text: "Für private Feiern schafft ein Schnellzeichner lockere Stimmung, individuelle Erinnerungen und ein Highlight, über das noch lange gesprochen wird.",
  },
  
];

/*
  Merge:
  Nur image darf überschrieben werden.
*/

const list = DEFAULT_EVENTS.map((def, idx) => {
  const override = rawOverrides[idx];
  return {
    ...def,
    image: override?.image ?? def.image,
  };
});
---

<section class="eventtypes-section">
  <div class="eventtypes-grid">
    {list.map((event) => (
      <details class="eventtype-item">
        <summary class="eventtype-link">
          <img
            src={event.image}
            alt={event.alt}
            class="eventtype-image"
            loading="lazy"
          />
          <div class="eventtype-label">
            <h3>{event.title}</h3>
          </div>
        </summary>

        <div class="eventtype-textbox">
          <p>{event.text}</p>
          <a href={event.link}>Mehr erfahren</a>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
.eventtypes-section {
  padding: 70px 20px;
  background: #111;
}

.eventtypes-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 40px;
  max-width: 1200px;
  margin: 0 auto;
  justify-content: center;
}

.eventtype-item {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 14px;
  overflow: visible;
  background: #161616;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.eventtype-item summary {
  list-style: none;
}

.eventtype-item summary::-webkit-details-marker {
  display: none;
}

.eventtype-link {
  display: block;
  width: 100%;
  height: 100%;
  position: relative;
  cursor: pointer;
  overflow: hidden;
  border-radius: 14px;
}

.eventtype-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.75);
  transition: transform 0.4s ease, filter 0.3s ease;
}

@media (max-width: 640px) {
  .eventtypes-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }
}

.eventtype-label {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 25px;
  background: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0.1));
  transition: background 0.3s ease;
}

.eventtype-label h3 {
  color: #fff;
  font-size: 1.15rem;
  font-weight: 700;
  text-align: center;
  letter-spacing: 0.04em;
}

.eventtype-textbox {
  position: absolute;
  left: 0;
  right: 0;
  top: calc(100% + 10px);
  z-index: 20;
  background: #161616;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  padding: 0 20px;
  transition: max-height 0.35s ease, padding 0.35s ease, opacity 0.25s ease;
}

.eventtype-textbox p {
  color: #e8e8e8;
  line-height: 1.5;
  margin: 0;
}

.eventtype-textbox a {
  display: inline-block;
  margin-top: 14px;
  color: #fff;
  font-weight: 600;
  text-decoration: underline;
}

.eventtype-item[open] .eventtype-textbox {
  max-height: 220px;
  padding: 18px 20px 20px;
  opacity: 1;
}

.eventtype-item:hover .eventtype-image {
  transform: scale(1.07);
  filter: brightness(0.45);
}

.eventtype-item:hover .eventtype-label {
  background: linear-gradient(to top, rgba(0,0,0,0.85), rgba(0,0,0,0.2));
}
</style>