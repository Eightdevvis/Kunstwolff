---
import { getVisibleEvents, getEventSlides, resolveEventTitleImage } from "../utils/events";
import { getSiteTexts } from "../utils/siteTexts";

const et = getSiteTexts().eventtypes;

type EventImageOverride = {
  slug?: string;
  image?: string;
};

const { events = [], items = [] } = Astro.props as {
  events?: EventImageOverride[];
  items?: EventImageOverride[];
};

const rawOverrides: EventImageOverride[] = events.length > 0 ? events : items;
const imageOverrides = new Map(
  rawOverrides
    .filter((item) => !!item.slug && !!item.image)
    .map((item) => [item.slug as string, item.image as string]),
);

const list = getVisibleEvents().map((event) => {
  const firstSlide = getEventSlides(event.slug)[0]?.src;
  const titleImage = resolveEventTitleImage(event.slug);
  const image = imageOverrides.get(event.slug) ?? event.image ?? firstSlide ?? titleImage;
  const alt = `Eventseite ${event.title} von Kunstwolff`;
  const text =
    event.description ??
    `Live-Kunst fuer ${event.title}: Schnellzeichner und Szenenmaler als unterhaltsames Highlight fuer dein Event.`;

  return {
    title: event.title,
    image,
    link: event.link,
    alt,
    text,
  };
});
---

{list.length > 0 && (
<section class="eventtypes-section">
  <div class="eventtypes-headline">
    <h2>{et.heading}</h2>
    <p>{et.subtitle}</p>
  </div>
  <div class="eventtypes-grid">
    {list.map((event) => (
      <details class="eventtype-item">
        <summary class="eventtype-link">
          <img
            src={event.image}
            alt={event.alt}
            class="eventtype-image"
            loading="lazy"
          />
          <div class="eventtype-label">
            <span class="eventtype-chip">Event</span>
            <h3>{event.title}</h3>
            <span class="eventtype-toggle" aria-hidden="true">+</span>
          </div>
        </summary>

        <div class="eventtype-textbox">
          <p>{event.text}</p>
          <a href={event.link} class="eventtype-cta">Zur Eventseite</a>
        </div>
      </details>
    ))}
  </div>
</section>
)}

<style>
.eventtypes-section {
  position: relative;
  z-index: 3;
  padding: 84px 20px;
  background:
    radial-gradient(circle at 20% 0%, rgba(251, 191, 36, 0.08), transparent 40%),
    radial-gradient(circle at 90% 10%, rgba(56, 189, 248, 0.08), transparent 35%),
    #0f0f11;
}

.eventtypes-headline {
  max-width: 1200px;
  margin: 0 auto 30px;
  text-align: center;
}

.eventtypes-headline h2 {
  color: #fff;
  font-size: clamp(1.7rem, 2.6vw, 2.25rem);
  letter-spacing: 0.02em;
  margin: 0 0 10px;
}

.eventtypes-headline p {
  color: #c7c7cb;
  margin: 0;
  font-size: clamp(0.98rem, 1.6vw, 1.08rem);
}

.eventtypes-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 28px;
  max-width: 1200px;
  margin: 0 auto;
  justify-content: center;
}

.eventtype-item {
  position: relative;
  z-index: 1;
  border-radius: 18px;
  overflow: visible;
  background: #121214;
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.28);
  transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
}

.eventtype-item summary {
  list-style: none;
}

.eventtype-item summary::-webkit-details-marker {
  display: none;
}

.eventtype-link {
  display: block;
  width: 100%;
  aspect-ratio: 1 / 1;
  position: relative;
  cursor: pointer;
  overflow: hidden;
  border-radius: 18px;
}

.eventtype-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.68) saturate(1.04);
  transition: transform 0.45s ease, filter 0.3s ease;
}

@media (max-width: 640px) {
  .eventtypes-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }
}

.eventtype-label {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: flex-start;
  gap: 10px;
  padding: 22px;
  background: linear-gradient(to top, rgba(0,0,0,0.82), rgba(0,0,0,0.16));
  transition: background 0.3s ease, backdrop-filter 0.3s ease;
}

.eventtype-label h3 {
  color: #fff;
  font-size: 1.2rem;
  font-weight: 750;
  margin: 0;
  text-align: left;
  letter-spacing: 0.02em;
  line-height: 1.25;
}

.eventtype-chip {
  display: inline-flex;
  align-items: center;
  padding: 5px 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.17);
  border: 1px solid rgba(255, 255, 255, 0.34);
  color: #fff;
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.eventtype-toggle {
  position: absolute;
  right: 16px;
  top: 16px;
  width: 34px;
  height: 34px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1.35rem;
  font-weight: 400;
  color: #fff;
  background: rgba(0, 0, 0, 0.36);
  border: 1px solid rgba(255, 255, 255, 0.36);
  transition: transform 0.25s ease, background 0.25s ease;
}

.eventtype-textbox {
  position: absolute;
  left: 0;
  right: 0;
  top: calc(100% + 10px);
  z-index: 20;
  background: linear-gradient(140deg, #18181b, #121214);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 14px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.38);
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  padding: 0 18px;
  transition: max-height 0.4s ease, padding 0.4s ease, opacity 0.3s ease;
}

.eventtype-textbox p {
  color: #ececf0;
  line-height: 1.6;
  font-size: 0.96rem;
  margin: 0;
}

.eventtype-cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 14px;
  color: #111;
  background: #f8fafc;
  font-weight: 700;
  text-decoration: none;
  border-radius: 10px;
  padding: 10px 14px;
  transition: transform 0.2s ease, background 0.2s ease;
}

.eventtype-cta::after {
  content: "->";
}

.eventtype-item[open] .eventtype-textbox {
  max-height: 260px;
  padding: 18px 18px 20px;
  opacity: 1;
}

.eventtype-item[open] .eventtype-toggle {
  transform: rotate(45deg);
  background: rgba(255, 255, 255, 0.22);
}

.eventtype-item[open] {
  z-index: 10;
  border-color: rgba(255, 255, 255, 0.28);
}

.eventtype-item:hover .eventtype-image {
  transform: scale(1.06);
  filter: brightness(0.52) saturate(1.08);
}

.eventtype-item:hover .eventtype-label {
  background: linear-gradient(to top, rgba(0,0,0,0.86), rgba(0,0,0,0.22));
  backdrop-filter: blur(1px);
}

.eventtype-item:hover {
  z-index: 10;
  transform: translateY(-4px);
  border-color: rgba(255, 255, 255, 0.24);
  box-shadow: 0 18px 36px rgba(0, 0, 0, 0.34);
}

.eventtype-cta:hover {
  transform: translateY(-1px);
  background: #ffffff;
}

@media (max-width: 640px) {
  .eventtypes-section {
    padding: 70px 16px;
  }

  .eventtype-label h3 {
    font-size: 1.1rem;
  }
}
</style>