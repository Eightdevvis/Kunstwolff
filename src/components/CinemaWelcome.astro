---
/**
 * CinemaWelcome.astro
 *
 * Interaktiver Konfigurator: Der Besucher wählt Event, Gästeanzahl und Stil –
 * am Ende erscheint ein personalisiertes Angebot.
 *
 * Aufbau:
 *
 * [INTRO]   Cinematic opener (zentrierter Text, kein Orbit)
 * [1] Ihr Event    – Text links / Orbit rechts  – Event-Typ auswählen
 * [2] Ihre Muse    – Orbit links / Text rechts   – Gästezahl (Text-Kreise)
 * [3] Ihr Geschmack – Text links / Orbit rechts  – Stil auswählen
 * [4] Ergebnis     – Personalisiertes Angebot basierend auf den 3 Auswahlen
 *
 * Orbit-Animationen + Dimmer bleiben wie gehabt.
 * Satelliten sind jetzt Auswahl-Buttons statt Links.
 * Ergebnis-Sektion wird per JS mit den gewählten Daten befüllt.
 */

import { getCinemaData } from '../utils/cinema';

const cinema = getCinemaData();
const { intro, overrides } = cinema;
const [sec1, sec2, sec3] = cinema.sections;

// Satelliten-Defaults als Lookup für Client-JS (value → defaults)
const satelliteData = {
  sections: cinema.sections.map(s => ({
    id: s.id,
    satellites: s.satellites.map(sat => ({
      value: sat.value,
      title: sat.title,
      defaults: sat.defaults,
      ...(sat.autoSelect ? { autoSelect: sat.autoSelect } : {}),
    })),
  })),
  overrides,
};
---

<div class="cw-scroll-shell" id="cw-scroll-shell">
  <div class="cw-scroll-viewport" id="cw-scroll-viewport">
    <!-- ══════════════════════════════════════════════════════════════════
         INTRO – Cinematic Opener (reine Text-Begrüßung, zentriert)
    ═══════════════════════════════════════════════════════════════════ -->
    <div class="cw-intro" id="cw-intro">
      <p class="cw-title">{intro.title}</p>
      <p class="cw-subtitle">{intro.subtitle}</p>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════
         SEKTION 1 – Ihr Event (Text links, Orbit rechts)
    ═══════════════════════════════════════════════════════════════════ -->
    <section class="cw" id="cinema-welcome">
  <div class="cw-inner">

    <div class="cw-text">
      <h2 class="cw-title">{sec1.title}</h2>
      <p class="cw-subtitle">{sec1.subtitle}</p>
    </div>

    <div class="cw-orbit" id="cw-orbit">
      {sec1.satellites.map((item, i) => (
        <button
          class={`cw-satellite ${item.displayMode === 'text' ? 'cw-satellite--text' : ''}`}
          data-sat-index={i.toString()}
          data-value={item.value}
          aria-label={item.title}
          type="button"
        >
          {item.displayMode === 'text' ? (
            <span class="cw-satellite-text">{item.title}</span>
          ) : (
            <img src={item.image} alt={item.alt ?? item.title} loading="lazy" />
          )}
          <span class="cw-satellite-label">{item.title}</span>
        </button>
      ))}
      <button class="cw-main" id="cw-main" aria-label="Event-Typ auswählen" aria-expanded="false" type="button">
        <img src={sec1.mainCircle.image} alt={sec1.mainCircle.alt} />
        <span class="cw-main-hint">{sec1.mainCircle.hint ?? 'Entdecken'}</span>
      </button>
      <button class="cw-reopen" type="button" aria-label="Optionen erneut anzeigen" title="Optionen erneut anzeigen">
        ↻
      </button>
    </div>

  </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════════
         SEKTION 2 – Ihre Muse (Orbit links, Text rechts) – Text-Kreise
    ═══════════════════════════════════════════════════════════════════ -->
    <section class="cw cw--reversed cw--hidden" id="cinema-welcome-2">
  <div class="cw-inner">

    <div class="cw-orbit" id="cw-orbit-2">
      {sec2.satellites.map((item, i) => (
        <button
          class={`cw-satellite ${item.displayMode === 'text' ? 'cw-satellite--text' : ''}`}
          data-sat-index={i.toString()}
          data-value={item.value}
          aria-label={item.title}
          type="button"
        >
          {item.displayMode === 'text' ? (
            <span class="cw-satellite-text">{item.title}</span>
          ) : (
            <img src={item.image} alt={item.alt ?? item.title} loading="lazy" />
          )}
          <span class="cw-satellite-label">{item.title}</span>
        </button>
      ))}
      <button class="cw-main cw-main--empty" id="cw-main-2" aria-label="Gästeanzahl wählen" aria-expanded="false" type="button">
        <span class="cw-main-hint">{sec2.mainCircle.hint ?? 'Wählen'}</span>
        <span class="cw-main-selected-text" id="cw-main-2-text"></span>
      </button>
      <button class="cw-reopen" type="button" aria-label="Optionen erneut anzeigen" title="Optionen erneut anzeigen">
        ↻
      </button>
    </div>

    <div class="cw-text cw-text--right">
      <h2 class="cw-title">{sec2.title}</h2>
      <p class="cw-subtitle">{sec2.subtitle}</p>
    </div>

  </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════════
         SEKTION 3 – Ihr Geschmack (Text links, Orbit rechts)
    ═══════════════════════════════════════════════════════════════════ -->
    <section class="cw cw--hidden" id="cinema-welcome-3">
  <div class="cw-inner">

    <div class="cw-text">
      <h2 class="cw-title">{sec3.title}</h2>
      <p class="cw-subtitle">{sec3.subtitle}</p>
    </div>

    <div class="cw-orbit" id="cw-orbit-3">
      {sec3.satellites.map((item, i) => (
        <button
          class={`cw-satellite ${item.displayMode === 'text' ? 'cw-satellite--text' : ''}`}
          data-sat-index={i.toString()}
          data-value={item.value}
          aria-label={item.title}
          type="button"
        >
          {item.displayMode === 'text' ? (
            <span class="cw-satellite-text">{item.title}</span>
          ) : (
            <img src={item.image} alt={item.alt ?? item.title} loading="lazy" />
          )}
          <span class="cw-satellite-label">{item.title}</span>
        </button>
      ))}
      <button class="cw-main" id="cw-main-3" aria-label="Stil auswählen" aria-expanded="false" type="button">
        <img src={sec3.mainCircle.image} alt={sec3.mainCircle.alt} />
        <span class="cw-main-hint">{sec3.mainCircle.hint ?? 'Entdecken'}</span>
      </button>
      <button class="cw-reopen" type="button" aria-label="Optionen erneut anzeigen" title="Optionen erneut anzeigen">
        ↻
      </button>
    </div>

  </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════════
         SEKTION 4 – Ergebnis (personalisiertes Angebot)
         Wird per JS befüllt, sobald alle 3 Auswahlen getroffen sind.
    ═══════════════════════════════════════════════════════════════════ -->
    <section class="cw cw-result cw--hidden" id="cinema-result">
  <div class="cw-result-cards">

    <!-- Karte 1: Bild + Titel + Beschreibung -->
    <div class="cw-result-card" id="cw-card-left">
      <div class="cw-result-card-inner">
        <div class="cw-result-card-back">
          <div class="cw-card-back-ornament"></div>
          <p class="cw-card-back-hint">Ihr Angebot</p>
        </div>
        <div class="cw-result-card-front">
          <div class="cw-result-image-wrap">
            <img id="cw-result-img" src="" alt="" loading="lazy" />
          </div>
          <h3 class="cw-result-title" id="cw-result-title"></h3>
          <p class="cw-result-description" id="cw-result-description"></p>
        </div>
      </div>
    </div>

    <!-- Karte 2: Angebot + Button -->
    <div class="cw-result-card" id="cw-card-right">
      <div class="cw-result-card-inner">
        <div class="cw-result-card-back">
          <div class="cw-card-back-ornament"></div>
          <p class="cw-card-back-hint">Ihre Empfehlung</p>
        </div>
        <div class="cw-result-card-front">
          <ul class="cw-result-offer" id="cw-result-offer" role="list"></ul>
          <a href="#contact" class="cw-result-cta" id="cw-result-cta">Termin jetzt anfragen</a>
        </div>
      </div>
    </div>

  </div>
    </section>
  </div>
</div>

<!-- Satelliten-Daten + Overrides für Client-JS (Build-Time → Runtime) -->
<script is:inline define:vars={{ satelliteData }}>
  window.__cinemaSatelliteData = satelliteData;
</script>

<style>
  .cw-scroll-shell {
    position: relative;
    background: #000;
    width: min(100% - clamp(24px, 5vw, 72px), 1680px);
    margin: 0 auto;
    border-radius: clamp(14px, 1.8vw, 24px);
    overflow: hidden;
  }

  .cw-scroll-shell::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgba(201, 168, 76, 0.9);
    box-shadow:
      inset 0 0 0 1px rgba(201, 168, 76, 0.24),
      0 0 0 1px rgba(201, 168, 76, 0.16),
      0 0 14px rgba(191, 155, 80, 0.22);
    pointer-events: none;
    z-index: 1200;
  }

  .cw-scroll-viewport {
    background: #000;
  }

  .cw--hidden {
    display: none !important;
  }

  /* ═══════════════════════════════════════════════════════════════════
     INTRO BLOCK
  ═══════════════════════════════════════════════════════════════════ */
  .cw-intro {
    position:        relative;
    background:      #000;
    min-height:      100vh;
    display:         flex;
    flex-direction:  column;
    align-items:     center;
    justify-content: center;
    text-align:      center;
    padding:         clamp(60px, 10vh, 110px) clamp(40px, 9vw, 130px);
    gap:             clamp(14px, 2.5vh, 28px);
    box-sizing:      border-box;
  }

  /* ═══════════════════════════════════════════════════════════════════
     ORBIT-SEKTIONEN (gemeinsam)
  ═══════════════════════════════════════════════════════════════════ */
  .cw {
    position:    relative;
    background:  #000;
    min-height:  75vh;
    display:     flex;
    align-items: center;
    overflow:    visible;
    padding:     60px 0;
  }

  .cw-inner {
    width:         100%;
    max-width:     1300px;
    margin:        0 auto;
    padding-left:  clamp(40px, 9vw, 130px);
    padding-right: clamp(10px, 2vw, 30px);
    display:       flex;
    align-items:   center;
    gap:           clamp(30px, 5vw, 60px);
  }

  .cw--reversed .cw-inner {
    flex-direction: row;
    padding-left:  clamp(40px, 9vw, 130px);
    padding-right: clamp(40px, 9vw, 130px);
  }

  /* ═══════════════════════════════════════════════════════════════════
     TEXT
  ═══════════════════════════════════════════════════════════════════ */
  .cw-text {
    flex:      1;
    min-width: 0;
  }

  .cw-text--right {
    text-align:   left;
    padding-left: clamp(20px, 4vw, 60px);
  }

  .cw-title {
    font-family:    'Mayonice', serif;
    font-size:      clamp(2.2rem, 5vw, 3.8rem);
    font-weight:    400;
    color:          #fff;
    line-height:    1.1;
    margin:         0 0 clamp(16px, 3vw, 30px);
    letter-spacing: 0.02em;
    clip-path:      inset(0 100% 0 0);
    opacity:        0;
  }

  .cw-subtitle {
    font-family:    var(--font-body, 'Inter', sans-serif);
    font-size:      clamp(1rem, 2.2vw, 1.45rem);
    font-weight:    300;
    color:          rgba(255,255,255,0.8);
    line-height:    1.55;
    margin:         0;
    clip-path:      inset(0 100% 0 0);
    opacity:        0;
  }

  @keyframes text-reveal {
    0%  { clip-path: inset(0 100% 0 0); opacity: 0; }
    15% { opacity: 1; }
    100%{ clip-path: inset(0 0% 0 0);   opacity: 1; }
  }

  .cw-title.revealed    { animation: text-reveal 1.05s cubic-bezier(0.22, 0.61, 0.36, 1) forwards; }
  .cw-subtitle.revealed { animation: text-reveal 0.95s cubic-bezier(0.22, 0.61, 0.36, 1) forwards; }

  .cw-title.instant,
  .cw-subtitle.instant {
    clip-path: inset(0 0% 0 0);
    opacity:   1;
    animation: none;
  }

  /* ═══════════════════════════════════════════════════════════════════
     ORBIT
  ═══════════════════════════════════════════════════════════════════ */
  .cw-orbit {
    position: relative;
    flex:     0 0 auto;
    width:    420px;
    height:   420px;
    overflow: visible;
  }

  /* ═══════════════════════════════════════════════════════════════════
     HAUPTKREIS
  ═══════════════════════════════════════════════════════════════════ */
  .cw-main {
    position:      absolute;
    top:           50%;
    left:          50%;
    transform:     translate(-50%, -50%);
    width:         200px;
    height:        200px;
    border-radius: 50%;
    border:        2px solid rgba(255,255,255,0.22);
    overflow:      hidden;
    cursor:        pointer;
    background:    #000;
    padding:       0;
    opacity:       0;
    scale:         0.5;
    transition:
      opacity 0.55s ease,
      scale   0.55s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow   0.3s ease,
      border-color 0.3s ease;
  }

  .cw-main--empty {
    background: radial-gradient(ellipse at center, #1a1510 0%, #0d0b08 100%);
    border-color: rgba(191, 155, 80, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cw-main-selected-text {
    display:        none;
    color:          #c9a84c;
    font-family:    Georgia, serif;
    font-size:      1.1rem;
    text-align:     center;
    line-height:    1.3;
    padding:        12px;
    pointer-events: none;
    opacity:        0;
    transition:     opacity 0.4s ease;
  }

  .cw-main-selected-text.visible {
    display: block;
    opacity: 1;
  }

  .cw-main.visible {
    opacity: 1;
    scale:   1;
  }

  .cw-main img {
    width:          100%;
    height:         100%;
    object-fit:     cover;
    filter:         brightness(0.78);
    display:        block;
    pointer-events: none;
    transition:     filter 0.3s ease, transform 0.4s ease, opacity 0.4s ease;
  }

  .cw-main:hover img     { filter: brightness(0.45); transform: scale(1.06); }
  .cw-main:hover         { border-color: rgba(255,255,255,0.5); box-shadow: 0 0 30px rgba(255,255,255,0.12); }

  .cw-main-hint {
    position:        absolute;
    inset:           0;
    display:         flex;
    align-items:     center;
    justify-content: center;
    color:           #fff;
    font-size:       0.68rem;
    letter-spacing:  0.12em;
    text-transform:  uppercase;
    opacity:         0;
    transition:      opacity 0.3s ease;
    pointer-events:  none;
  }

  .cw-main:hover .cw-main-hint { opacity: 0.85; }

  .cw-reopen {
    position: absolute;
    left: 50%;
    top: calc(50% + 126px);
    transform: translateX(-50%);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(201, 168, 76, 0.65);
    background: rgba(8, 6, 4, 0.92);
    color: #c9a84c;
    font-size: 1rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    z-index: 6;
  }

  .cw-reopen.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .cw-reopen:hover {
    border-color: rgba(201, 168, 76, 0.95);
    box-shadow: 0 0 18px rgba(191, 155, 80, 0.3);
    transform: translateX(-50%) scale(1.05);
  }

  /* ═══════════════════════════════════════════════════════════════════
     SATELLITEN
  ═══════════════════════════════════════════════════════════════════ */
  .cw-satellite {
    position:        absolute;
    top:             50%;
    left:            50%;
    width:           95px;
    height:          95px;
    border-radius:   50%;
    overflow:        hidden;
    border:          2px solid rgba(255,255,255,0.18);
    background:      #000;
    display:         block;
    text-decoration: none;
    color:           #fff;
    cursor:          pointer;
    padding:         0;
    font:            inherit;
    transform:       translate(-50%, -50%) scale(0);
    opacity:         0;
    transition:
      transform    0.52s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity      0.4s ease,
      filter       0.3s ease,
      box-shadow   0.3s ease,
      border-color 0.3s ease;
    will-change: transform, opacity;
  }

  /* ── Text-Satelliten (Muse-Sektion): Gold auf Dunkel ── */
  .cw-satellite--text {
    width:         110px;
    height:        110px;
    background:    radial-gradient(ellipse at center, #1a1510 0%, #0d0b08 100%);
    border-color:  rgba(191, 155, 80, 0.35);
    display:       flex;
    align-items:   center;
    justify-content: center;
  }

  .cw-satellite-text {
    color:          #c9a84c;
    font-family:    Georgia, 'Times New Roman', serif;
    font-size:      0.82rem;
    font-weight:    400;
    letter-spacing: 0.02em;
    text-align:     center;
    line-height:    1.3;
    padding:        12px;
    pointer-events: none;
  }

  .cw-satellite--text:hover {
    border-color: rgba(191, 155, 80, 0.7);
    box-shadow:   0 0 24px rgba(191, 155, 80, 0.2);
  }

  .cw-satellite--text:hover .cw-satellite-text {
    color: #e2c970;
  }

  /* Text-Satelliten: Label ausblenden (Text IST das Label) */
  .cw-satellite--text .cw-satellite-label { display: none; }

  /* ── Ausgewählter Satellit ── */
  .cw-satellite.selected {
    border-color: rgba(191, 155, 80, 0.8);
    box-shadow:   0 0 20px rgba(191, 155, 80, 0.3);
  }

  .cw-satellite--text.selected {
    background:   radial-gradient(ellipse at center, #2a2010 0%, #1a1508 100%);
    border-color: rgba(191, 155, 80, 0.9);
    box-shadow:   0 0 28px rgba(191, 155, 80, 0.4);
  }

  .cw-satellite--text.selected .cw-satellite-text {
    color: #e8d07a;
  }

  /*
    Sektion 1 + 3: Satelliten nach LINKS (4 Satelliten)
    Winkel 120°/160°/200°/240°, r=190.
  */
  #cw-orbit  .cw-satellite[data-sat-index="0"],
  #cw-orbit-3 .cw-satellite[data-sat-index="0"] { --sx: -95px;  --sy: -165px; }
  #cw-orbit  .cw-satellite[data-sat-index="1"],
  #cw-orbit-3 .cw-satellite[data-sat-index="1"] { --sx: -179px; --sy:  -65px; }
  #cw-orbit  .cw-satellite[data-sat-index="2"],
  #cw-orbit-3 .cw-satellite[data-sat-index="2"] { --sx: -179px; --sy:   65px; }
  #cw-orbit  .cw-satellite[data-sat-index="3"],
  #cw-orbit-3 .cw-satellite[data-sat-index="3"] { --sx: -95px;  --sy:  165px; }

  /*
    Sektion 2: 6 Text-Satelliten (Muse) – voller Kreis, r=200
    Winkel: 0° / 60° / 120° / 180° / 240° / 300°
  */
  #cw-orbit-2 .cw-satellite[data-sat-index="0"] { --sx:  200px; --sy:    0px; }
  #cw-orbit-2 .cw-satellite[data-sat-index="1"] { --sx:  100px; --sy:  173px; }
  #cw-orbit-2 .cw-satellite[data-sat-index="2"] { --sx: -100px; --sy:  173px; }
  #cw-orbit-2 .cw-satellite[data-sat-index="3"] { --sx: -200px; --sy:    0px; }
  #cw-orbit-2 .cw-satellite[data-sat-index="4"] { --sx: -100px; --sy: -173px; }
  #cw-orbit-2 .cw-satellite[data-sat-index="5"] { --sx:  100px; --sy: -173px; }

  .cw-satellite.visible {
    transform: translate(calc(-50% + var(--sx)), calc(-50% + var(--sy))) scale(1);
    opacity:   1;
  }

  .cw-satellite:hover {
    transform:    translate(calc(-50% + var(--sx)), calc(-50% + var(--sy))) scale(1.3) !important;
    box-shadow:   0 0 28px rgba(255,255,255,0.18);
    border-color: rgba(255,255,255,0.55);
    z-index:      2;
  }

  .cw-satellite--text:hover {
    box-shadow:   0 0 28px rgba(191, 155, 80, 0.25);
    border-color: rgba(191, 155, 80, 0.7);
  }

  .cw-satellite img {
    width:          100%;
    height:         100%;
    object-fit:     cover;
    filter:         brightness(0.78);
    display:        block;
    pointer-events: none;
    transition:     filter 0.3s ease, transform 0.3s ease;
  }

  .cw-satellite:hover img { filter: brightness(0.45); transform: scale(1.08); }

  .cw-satellite-label {
    position:        absolute;
    inset:           0;
    display:         flex;
    align-items:     center;
    justify-content: center;
    color:           #fff;
    font-size:       0.6rem;
    font-weight:     600;
    letter-spacing:  0.09em;
    text-transform:  uppercase;
    text-align:      center;
    padding:         6px;
    opacity:         0;
    transition:      opacity 0.3s ease;
    pointer-events:  none;
  }

  .cw-satellite:hover .cw-satellite-label { opacity: 1; }

  /* Geschwister verblassen beim Hover */
  .cw-orbit:has(.cw-satellite:hover) .cw-satellite:not(:hover) {
    opacity: 0.38;
    filter:  brightness(0.55);
  }

  /* ═══════════════════════════════════════════════════════════════════
     ERGEBNIS-SEKTION
     Schwarz-Weiß-Gold Eleganz.
     Links: Bild + Titel + Beschreibung
     Rechts: Zusammenfassung + Angebot + CTA-Button
  ═══════════════════════════════════════════════════════════════════ */
  /* ══ Ergebnis-Sektion: Karten-Flip ══════════════════════════════════ */
  .cw-result {
    min-height: 100vh;
    padding:    clamp(48px, 8vh, 96px) 0;
    display:    flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .cw-result-cards {
    width:   100%;
    max-width: 1100px;
    padding: 0 clamp(30px, 6vw, 80px);
    display: flex;
    gap:     clamp(24px, 4vw, 48px);
    align-items: stretch;
  }

  /* ── Karte ── */
  .cw-result-card {
    flex:            1;
    perspective:     1200px;
    min-height:      520px;
  }

  .cw-result-card-inner {
    position:         relative;
    width:            100%;
    height:           100%;
    transform-style:  preserve-3d;
    transition:       transform 0.85s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cw-result-card.flipped .cw-result-card-inner {
    transform: rotateY(180deg);
  }

  .cw-result-card-back,
  .cw-result-card-front {
    position:            absolute;
    inset:               0;
    backface-visibility: hidden;
    border-radius:       8px;
    border:              1px solid rgba(191, 155, 80, 0.3);
    overflow:            hidden;
  }

  /* ── Rückseite ── */
  .cw-result-card-back {
    background: radial-gradient(ellipse at 40% 40%, #1a1208 0%, #0a0804 100%);
    display:    flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }

  .cw-card-back-ornament {
    width:  80px;
    height: 80px;
    border: 1px solid rgba(191, 155, 80, 0.4);
    border-radius: 50%;
    position: relative;
  }

  .cw-card-back-ornament::before,
  .cw-card-back-ornament::after {
    content:       '';
    position:      absolute;
    inset:         10px;
    border:        1px solid rgba(191, 155, 80, 0.2);
    border-radius: 50%;
  }

  .cw-card-back-ornament::after {
    inset: 22px;
    background: rgba(191, 155, 80, 0.08);
  }

  .cw-card-back-hint {
    font-family:    'Mayonice', serif;
    font-size:      clamp(1rem, 1.8vw, 1.4rem);
    color:          rgba(191, 155, 80, 0.5);
    letter-spacing: 0.05em;
    margin:         0;
  }

  /* ── Vorderseite ── */
  .cw-result-card-front {
    background:     #080604;
    transform:      rotateY(180deg);
    display:        flex;
    flex-direction: column;
    padding:        clamp(24px, 3vw, 36px);
  }

  /* ── Inhalt links ── */
  .cw-result-image-wrap {
    width:         100%;
    aspect-ratio:  4 / 3;
    border-radius: 4px;
    overflow:      hidden;
    border:        1px solid rgba(191, 155, 80, 0.15);
    margin-bottom: clamp(16px, 2vw, 24px);
    flex-shrink:   0;
  }

  .cw-result-image-wrap img {
    width:      100%;
    height:     100%;
    object-fit: cover;
    filter:     brightness(0.85);
  }

  .cw-result-title {
    font-family:    'Mayonice', serif;
    font-size:      clamp(1.5rem, 2.5vw, 2.2rem);
    font-weight:    400;
    color:          #c9a84c;
    margin:         0 0 clamp(8px, 1.5vw, 14px);
    letter-spacing: 0.02em;
  }

  .cw-result-description {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size:   clamp(0.85rem, 1.3vw, 0.95rem);
    font-weight: 300;
    color:       rgba(255,255,255,0.7);
    line-height: 1.65;
    margin:      0;
  }

  /* ── Inhalt rechts ── */
  #cw-card-right .cw-result-card-front {
    justify-content: center;
  }

  .cw-result-offer {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size:   clamp(0.95rem, 1.5vw, 1.1rem);
    font-weight: 300;
    color:       rgba(255,255,255,0.85);
    line-height: 1.65;
    margin:      0 0 clamp(28px, 4vw, 48px);
    padding:     0;
    list-style:  none;
    display:     flex;
    flex-direction: column;
    gap:         clamp(8px, 1vw, 12px);
  }

  .cw-result-offer li {
    position:       relative;
    padding-left:   clamp(18px, 1.6vw, 22px);
  }

  .cw-result-offer li::before {
    content:        "";
    position:       absolute;
    left:           0;
    top:            0.75em;
    width:          6px;
    height:         6px;
    border-radius:  50%;
    background:     #c9a84c;
    transform:      translateY(-50%);
  }

  .cw-result-offer:empty {
    display: none;
  }

  .cw-result-cta {
    display:         inline-block;
    padding:         clamp(14px, 2vw, 18px) clamp(28px, 4vw, 44px);
    border:          1px solid #c9a84c;
    color:           #c9a84c;
    font-family:     var(--font-body, 'Inter', sans-serif);
    font-size:       clamp(0.8rem, 1.2vw, 0.95rem);
    font-weight:     500;
    letter-spacing:  0.1em;
    text-transform:  uppercase;
    text-decoration: none;
    text-align:      center;
    background:      transparent;
    cursor:          pointer;
    transition:      background 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
    align-self:      flex-start;
  }

  .cw-result-cta:hover {
    background: #c9a84c;
    color:      #000;
    box-shadow: 0 0 30px rgba(191, 155, 80, 0.3);
  }

  /* ═══════════════════════════════════════════════════════════════════
     RESPONSIVE
  ═══════════════════════════════════════════════════════════════════ */
  @media (max-width: 1000px) {
    .cw-scroll-viewport {
      max-height: none;
      overflow: visible;
    }

    .cw-intro {
      padding-left:  clamp(24px, 6vw, 60px);
      padding-right: clamp(24px, 6vw, 60px);
    }

    .cw-inner {
      flex-direction: column;
      padding:        0 clamp(24px, 6vw, 60px);
      gap:            48px;
    }

    .cw--reversed .cw-inner {
      flex-direction: column;
      padding-left:  clamp(24px, 6vw, 60px);
      padding-right: clamp(24px, 6vw, 60px);
    }

    .cw-text,
    .cw-text--right { text-align: center; padding-left: 0; }

    .cw-orbit { width: 340px; height: 340px; }
    .cw-main  { width: 160px; height: 160px; }
    .cw-reopen { top: calc(50% + 102px); }
    .cw-satellite { width: 76px; height: 76px; }
    .cw-satellite--text { width: 90px; height: 90px; }
    .cw-satellite-text { font-size: 0.7rem; padding: 8px; }

    /* r=152 — Sektion 1 + 3 nach links */
    #cw-orbit  .cw-satellite[data-sat-index="0"],
    #cw-orbit-3 .cw-satellite[data-sat-index="0"] { --sx: -76px;  --sy: -132px; }
    #cw-orbit  .cw-satellite[data-sat-index="1"],
    #cw-orbit-3 .cw-satellite[data-sat-index="1"] { --sx: -143px; --sy:  -52px; }
    #cw-orbit  .cw-satellite[data-sat-index="2"],
    #cw-orbit-3 .cw-satellite[data-sat-index="2"] { --sx: -143px; --sy:   52px; }
    #cw-orbit  .cw-satellite[data-sat-index="3"],
    #cw-orbit-3 .cw-satellite[data-sat-index="3"] { --sx: -76px;  --sy:  132px; }

    /* r=152 — Sektion 2 (6 Text-Satelliten) voller Kreis */
    #cw-orbit-2 .cw-satellite[data-sat-index="0"] { --sx:  152px; --sy:    0px; }
    #cw-orbit-2 .cw-satellite[data-sat-index="1"] { --sx:   76px; --sy:  132px; }
    #cw-orbit-2 .cw-satellite[data-sat-index="2"] { --sx:  -76px; --sy:  132px; }
    #cw-orbit-2 .cw-satellite[data-sat-index="3"] { --sx: -152px; --sy:    0px; }
    #cw-orbit-2 .cw-satellite[data-sat-index="4"] { --sx:  -76px; --sy: -132px; }
    #cw-orbit-2 .cw-satellite[data-sat-index="5"] { --sx:   76px; --sy: -132px; }

    /* Ergebnis */
    .cw-result-inner {
      flex-direction: column;
      align-items:    center;
    }

    .cw-result-left {
      flex:      none;
      max-width: 320px;
      width:     100%;
    }

    .cw-result-right {
      padding-top: 0;
      align-items: center;
      text-align:  center;
    }

    .cw-result-cta { align-self: center; }
  }

  @media (max-width: 600px) {
    .cw { min-height: 80dvh; padding: 50px 0; }

    .cw-orbit     { width: 280px; height: 280px; }
    .cw-main      { width: 130px; height: 130px; }
    .cw-reopen    { top: calc(50% + 84px); width: 30px; height: 30px; font-size: 0.92rem; }
    .cw-satellite { width: 62px;  height: 62px;  }
    .cw-satellite--text { width: 74px; height: 74px; }
    .cw-satellite-text { font-size: 0.58rem; padding: 6px; }

    /* r=124 — Sektion 1 + 3 nach links */
    #cw-orbit  .cw-satellite[data-sat-index="0"],
    #cw-orbit-3 .cw-satellite[data-sat-index="0"] { --sx: -62px;  --sy: -107px; }
    #cw-orbit  .cw-satellite[data-sat-index="1"],
    #cw-orbit-3 .cw-satellite[data-sat-index="1"] { --sx: -116px; --sy:  -42px; }
    #cw-orbit  .cw-satellite[data-sat-index="2"],
    #cw-orbit-3 .cw-satellite[data-sat-index="2"] { --sx: -116px; --sy:   42px; }
    #cw-orbit  .cw-satellite[data-sat-index="3"],
    #cw-orbit-3 .cw-satellite[data-sat-index="3"] { --sx: -62px;  --sy:  107px; }

    /* r=124 — Sektion 2 (6 Text-Satelliten) voller Kreis */
    #cw-orbit-2 .cw-satellite[data-sat-index="0"] { --sx:  124px; --sy:    0px; }
    #cw-orbit-2 .cw-satellite[data-sat-index="1"] { --sx:   62px; --sy:  107px; }
    #cw-orbit-2 .cw-satellite[data-sat-index="2"] { --sx:  -62px; --sy:  107px; }
    #cw-orbit-2 .cw-satellite[data-sat-index="3"] { --sx: -124px; --sy:    0px; }
    #cw-orbit-2 .cw-satellite[data-sat-index="4"] { --sx:  -62px; --sy: -107px; }
    #cw-orbit-2 .cw-satellite[data-sat-index="5"] { --sx:   62px; --sy: -107px; }

    /* Ergebnis */
    .cw-result-left { max-width: 100%; }
    .cw-result-image-wrap { aspect-ratio: 3 / 4; }
  }
</style>

<script>
  // ═══════════════════════════════════════════════════════════════════════════
  // CINEMA-WELCOME – Orchestrierung für Intro + 3 Orbit-Sektionen + Ergebnis
  //
  // Neu: Satelliten sind Auswahl-Buttons. Nach der 3. Auswahl erscheint
  // die Ergebnis-Sektion mit einem personalisierten Angebot.
  // ═══════════════════════════════════════════════════════════════════════════

  // ── Gemeinsamer Dimmer ────────────────────────────────────────────────────
  let dimmer = document.getElementById("cinema-dimmer") as HTMLElement | null;
  if (!dimmer) {
    dimmer = document.createElement("div");
    dimmer.id = "cinema-dimmer";
    Object.assign(dimmer.style, {
      position:      "fixed",
      inset:         "0",
      zIndex:        "1001",
      background:    "rgba(0,0,0,0)",
      pointerEvents: "none",
      transition:    "background 1.3s ease",
    });
    document.body.appendChild(dimmer);
  }

  const activeSections = new Set<string>();

  // Externe Controls für Section 2 + 3 (werden nach Initialisierung gesetzt)
  type SectionControls = {
    unlockAndActivate: () => void;
    applyAutoSelected: (value: string, title: string) => void;
  };
  let sec2Controls: SectionControls | null = null;
  let sec3Controls: SectionControls | null = null;

  function activateDimmer(id: string) {
    activeSections.add(id);
    if (dimmer) dimmer.style.background = "rgba(0,0,0,0.80)";
  }

  function deactivateDimmer(id: string) {
    activeSections.delete(id);
    if (activeSections.size === 0 && dimmer) dimmer.style.background = "rgba(0,0,0,0)";
  }

  function setExtraDark(on: boolean) {
    if (!dimmer || activeSections.size === 0) return;
    dimmer.style.background = on ? "rgba(0,0,0,0.91)" : "rgba(0,0,0,0.80)";
  }

  // ── Auswahl-State ───────────────────────────────────────────────────────
  const selections: Record<string, string> = {};

  // ── Ergebnis-Sektion ────────────────────────────────────────────────────
  const resultSection = document.getElementById("cinema-result");
  const cardLeft      = document.getElementById("cw-card-left");
  const cardRight     = document.getElementById("cw-card-right");
  const resultImg     = document.getElementById("cw-result-img") as HTMLImageElement | null;
  const resultTitle   = document.getElementById("cw-result-title");
  const resultDesc    = document.getElementById("cw-result-description");
  const resultOffer   = document.getElementById("cw-result-offer");
  const resultCta     = document.getElementById("cw-result-cta") as HTMLAnchorElement | null;

  // Satellite-Titel für die Zusammenfassung merken
  const selectionTitles: Record<string, string> = {};
  const CONTACT_PREFILL_KEY = "cinemaContactPrefill_v1";

  function checkAndShowResult() {
    if (!selections.event || !selections.muse || !selections.geschmack) return;
    if (!resultSection) return;

    const data = (window as any).__cinemaSatelliteData;
    if (!data) return;

    // Satellite-Defaults für jede Auswahl nachschlagen
    function findDefaults(sectionId: string, value: string) {
      const sec = data.sections.find((s: any) => s.id === sectionId);
      if (!sec) return null;
      const sat = sec.satellites.find((s: any) => s.value === value);
      return sat?.defaults || null;
    }

    const geschmackDef = findDefaults("geschmack", selections.geschmack);
    const eventDef     = findDefaults("event",     selections.event);
    const museDef      = findDefaults("muse",      selections.muse);
    if (!geschmackDef || !eventDef || !museDef) return;

    // Override prüfen: Key = "{geschmack}-{event}-{muse}"
    const overrideKey = `${selections.geschmack}-${selections.event}-${selections.muse}`;
    const override = data.overrides?.[overrideKey];

    let title: string;
    let description: string;
    let offerItems: string[];
    let image: string;
    let imageAlt: string;

    // Helfer: stellt sicher, dass ein Wert ein String-Array mit getrimmten, nicht-leeren Einträgen ist
    const normalizeItems = (raw: unknown): string[] => {
      if (!Array.isArray(raw)) return [];
      const out: string[] = [];
      for (const entry of raw) {
        if (typeof entry !== "string") continue;
        const trimmed = entry.trim();
        if (trimmed) out.push(trimmed);
      }
      return out;
    };

    if (override) {
      title       = override.title;
      description = override.description;
      offerItems  = normalizeItems(override.offerItems);
      image       = override.image || geschmackDef.image || "";
      imageAlt    = override.imageAlt || title;
    } else {
      title       = `${geschmackDef.titlePart} auf ${eventDef.titlePart} für ${museDef.titlePart}`;
      description = [geschmackDef.text, museDef.text, eventDef.text].filter(Boolean).join(" ");
      offerItems  = [
        ...normalizeItems(eventDef.offerItems),
        ...normalizeItems(museDef.offerItems),
        ...normalizeItems(geschmackDef.offerItems),
      ];
      image       = geschmackDef.image || "";
      imageAlt    = title;
    }

    // Ergebnis befüllen
    if (resultImg) {
      resultImg.src = image;
      resultImg.alt = imageAlt;
    }
    if (resultTitle) resultTitle.textContent = title;
    if (resultDesc)  resultDesc.textContent  = description;

    // Zusammenfassung weiterhin für das Kontakt-Prefill aufbauen (nicht mehr sichtbar auf der Karte)
    const skillTitle = selectionTitles.geschmack || selections.geschmack;
    const eventTitle = selectionTitles.event || selections.event;
    const museTitle  = selectionTitles.muse || selections.muse;
    if (resultOffer) {
      resultOffer.innerHTML = "";
      for (const item of offerItems) {
        const li = document.createElement("li");
        li.textContent = item;
        resultOffer.appendChild(li);
      }
    }

    const buildContactPayload = () => ({
      source: "cinema-welcome",
      createdAt: new Date().toISOString(),
      title,
      summary: `\u201E${skillTitle}\u201C auf \u201E${eventTitle}\u201C f\u00fcr \u201E${museTitle}\u201C`,
      offerItems,
      selections: {
        event: selections.event,
        muse: selections.muse,
        geschmack: selections.geschmack,
        eventTitle,
        museTitle,
        skillTitle,
      },
    });

    try {
      sessionStorage.setItem(CONTACT_PREFILL_KEY, JSON.stringify(buildContactPayload()));
    } catch (error) {
      console.warn("[CinemaWelcome] Konnte Kontakt-Prefill nicht speichern:", error);
    }

    if (resultCta && !resultCta.dataset.prefillBound) {
      resultCta.dataset.prefillBound = "1";
      resultCta.addEventListener("click", () => {
        try {
          sessionStorage.setItem(CONTACT_PREFILL_KEY, JSON.stringify(buildContactPayload()));
        } catch (error) {
          console.warn("[CinemaWelcome] Konnte Kontakt-Prefill beim CTA nicht speichern:", error);
        }
      });
    }

    // Ergebnis-Sektion einblenden (vorher display:none, damit keine Page-Scroll-Fläche existierte)
    resultSection.classList.remove("cw--hidden");
    // Karten aufdecken (linke Karte etwas früher)
    if (resultSection) {
      resultSection.style.position = "relative";
      resultSection.style.zIndex   = "1002";
    }
    setTimeout(() => cardLeft?.classList.add("flipped"),  100);
    setTimeout(() => cardRight?.classList.add("flipped"), 350);

    // Zum Ergebnis scrollen
    setTimeout(() => {
      resultSection?.scrollIntoView({ behavior: "smooth", block: "center" });
    }, 400);
  }

  // ── INTRO ────────────────────────────────────────────────────────────────
  const introEl   = document.getElementById("cw-intro");
  const introHead = introEl?.querySelector<HTMLElement>(".cw-title");
  const introSub  = introEl?.querySelector<HTMLElement>(".cw-subtitle");

  if (introEl) {
    const INTRO_KEY = "cinemaIntro_v1";
    let introPlayed       = !!sessionStorage.getItem(INTRO_KEY);
    let introCinemaActive = false;

    function playIntroSequence(instant: boolean) {
      introEl!.style.zIndex = "1002";
      activateDimmer("cw-intro");

      if (instant) {
        introHead?.classList.add("instant");
        introSub?.classList.add("instant");
      } else {
        setTimeout(() => introHead?.classList.add("revealed"), 400);
        setTimeout(() => introSub?.classList.add("revealed"),  1500);
        sessionStorage.setItem(INTRO_KEY, "1");
        introPlayed = true;
      }
    }

    const introObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            if (!introCinemaActive) {
              introCinemaActive = true;
              playIntroSequence(introPlayed);
            } else {
              activateDimmer("cw-intro");
            }
          } else {
            introCinemaActive = false;
            deactivateDimmer("cw-intro");
          }
        });
      },
      { threshold: 0.3 }
    );
    introObserver.observe(introEl);
  }

  // ── Factory-Funktion für eine Orbit-Sektion ───────────────────────────────
  function setupCinemaSection(config: {
    sectionId:      string;
    orbitId:        string;
    mainBtnId:      string;
    sessionKey:     string;
    selectionKey:   string; // "event" | "muse" | "geschmack"
    requiresUnlock?: boolean; // Sektionen 2 + 3: nicht per Observer starten, nur per Auswahl
  }): SectionControls {
    const { sectionId, orbitId, mainBtnId, sessionKey, selectionKey, requiresUnlock } = config;

    const section    = document.getElementById(sectionId)  as HTMLElement | null;
    const orbit      = document.getElementById(orbitId)    as HTMLElement | null;
    const mainBtn    = document.getElementById(mainBtnId)  as HTMLButtonElement | null;
    const titleEl    = section?.querySelector<HTMLElement>(".cw-title");
    const subtitleEl = section?.querySelector<HTMLElement>(".cw-subtitle");
    const reopenBtn  = orbit?.querySelector<HTMLButtonElement>(".cw-reopen") ?? null;
    const satEls     = orbit
      ? Array.from(orbit.querySelectorAll<HTMLElement>(".cw-satellite"))
      : [];

    if (!section || !orbit || !mainBtn) {
      console.warn(`[CinemaWelcome] Elemente für "${sectionId}" nicht gefunden.`);
      return;
    }

    const sec = section!;
    const btn = mainBtn!;

    let animationPlayed        = !!sessionStorage.getItem(sessionKey);
    let satellitesOpen         = false;
    let cinemaActive           = false;
    let isAnimating            = false;
    let locked                 = !!requiresUnlock;
    let currentlyIntersecting  = false;

    function raiseSectionAboveDimmer() {
      sec.style.position = "relative";
      sec.style.zIndex   = "1002";
    }

    function openSatellites(instant = false) {
      if (satellitesOpen) return;
      satellitesOpen = true;
      btn.setAttribute("aria-expanded", "true");
      reopenBtn?.classList.remove("visible");
      // Text-Satellit-Auswahl im Hauptkreis zurücksetzen
      const hint   = btn.querySelector<HTMLElement>(".cw-main-hint");
      const textEl = btn.querySelector<HTMLElement>(".cw-main-selected-text");
      if (hint)   hint.style.display = "";
      if (textEl) { textEl.classList.remove("visible"); textEl.textContent = ""; }
      satEls.forEach((sat, i) => {
        if (instant) sat.classList.add("visible");
        else setTimeout(() => sat.classList.add("visible"), i * 200);
      });
    }

    function getSelectionHref(): string | null {
      const value = selections[selectionKey];
      if (!value) return null;
      if (selectionKey === "muse") return null;
      return `/${value}/`;
    }

    // ── Merge-Animation + Auswahl ─────────────────────────────────────
    function handleSatelliteClick(clickedIdx: number) {
      if (isAnimating || !satellitesOpen) return;
      isAnimating = true;

      const clickedSat = satEls[clickedIdx];
      if (!clickedSat) return;

      // Auswahl speichern
      const value = clickedSat.getAttribute("data-value") || "";
      const title = clickedSat.getAttribute("aria-label") || "";
      selections[selectionKey] = value;
      selectionTitles[selectionKey] = title;

      // AutoSelect: andere Sektionen automatisch befüllen (z.B. Messe → Stand-Attraktion)
      const satData = (window as any).__cinemaSatelliteData;
      const thisSec = satData?.sections.find((s: any) => s.id === selectionKey);
      const thisSatData = thisSec?.satellites.find((s: any) => s.value === value);
      const autoSelectMap: Record<string, string> | undefined = thisSatData?.autoSelect;
      if (autoSelectMap) {
        for (const [secId, autoVal] of Object.entries(autoSelectMap)) {
          const autoSec = satData.sections.find((s: any) => s.id === secId);
          const autoSat = autoSec?.satellites.find((s: any) => s.value === autoVal);
          if (autoSat) {
            selections[secId] = autoVal;
            selectionTitles[secId] = autoSat.title;
          }
        }
      }

      // Visuell markieren
      satEls.forEach(s => s.classList.remove("selected"));
      clickedSat.classList.add("selected");

      const isTextSat = clickedSat.classList.contains("cw-satellite--text");
      const satImg    = clickedSat.querySelector<HTMLImageElement>("img");
      const newSrc    = satImg?.currentSrc || satImg?.src || "";
      const newAlt    = satImg?.alt ?? "";

      // Phase 1: andere Satelliten einfahren (gestaffelt)
      let delay = 0;
      satEls.forEach((sat, i) => {
        if (i === clickedIdx) return;
        setTimeout(() => sat.classList.remove("visible"), delay);
        delay += 100;
      });
      satellitesOpen = false;
      btn.setAttribute("aria-expanded", "false");

      // Phase 2 (t=350): Satellit wächst zum Hauptkreis
      setTimeout(() => {
        clickedSat.style.zIndex     = "5";
        clickedSat.style.transition = "transform 0.7s cubic-bezier(0.4, 0, 0.2, 1)";
        clickedSat.style.transform  = "translate(-50%, -50%) scale(2.1)";

        if (!isTextSat) {
          const mainImg = btn.querySelector<HTMLImageElement>("img");
          if (mainImg) {
            mainImg.style.transition = "opacity 0.45s ease";
            mainImg.style.opacity    = "0";
          }
        }
      }, 350);

      // Phase 3 (t=800): Hauptkreis aktualisieren
      setTimeout(() => {
        if (!isTextSat) {
          const mainImg = btn.querySelector<HTMLImageElement>("img");
          if (mainImg) {
            mainImg.src           = newSrc;
            mainImg.alt           = newAlt;
            mainImg.style.opacity = "";
          }
        } else {
          // Text-Satellit: ausgewählten Text in Hauptkreis schreiben
          const hint = btn.querySelector<HTMLElement>(".cw-main-hint");
          const textEl = btn.querySelector<HTMLElement>(".cw-main-selected-text");
          if (hint) hint.style.display = "none";
          if (textEl) {
            textEl.textContent = title;
            textEl.classList.add("visible");
          }
        }
      }, 800);

      // Phase 4 (t=1050): Satellit ausblenden
      setTimeout(() => {
        clickedSat.style.transition += ", opacity 0.35s ease";
        clickedSat.style.opacity     = "0";
      }, 1050);

      // Phase 5 (t=1400): Aufräumen
      setTimeout(() => {
        clickedSat.style.transition = "none";
        clickedSat.style.transform  = "";
        clickedSat.style.opacity    = "";
        clickedSat.style.zIndex     = "";
        clickedSat.classList.remove("visible");

        if (!isTextSat) {
          const mainImg = btn.querySelector<HTMLImageElement>("img");
          if (mainImg) mainImg.style.transition = "";
        }

        requestAnimationFrame(() => { clickedSat.style.transition = ""; });
        isAnimating = false;
        reopenBtn?.classList.add("visible");

        // Nächste Sektion aktivieren (sequenziell statt via Observer)
        if (selectionKey === "event") {
          const museAutoVal = autoSelectMap?.muse;
          if (museAutoVal && sec2Controls && sec3Controls) {
            // Messe o.ä.: Section 2 überspringen, direkt zu Section 3
            const museSec = satData?.sections.find((s: any) => s.id === "muse");
            const museSat = museSec?.satellites.find((s: any) => s.value === museAutoVal);
            sec2Controls.applyAutoSelected(museAutoVal, museSat?.title || museAutoVal);
            sec3Controls.unlockAndActivate();
          } else if (sec2Controls) {
            sec2Controls.unlockAndActivate();
          }
        } else if (selectionKey === "muse" && sec3Controls) {
          sec3Controls.unlockAndActivate();
        }

        // Nach Auswahl immer automatisch zur nächsten Sektion.
        if (selectionKey === "event") {
          const nextSectionId = autoSelectMap?.muse ? "cinema-welcome-3" : "cinema-welcome-2";
          document.getElementById(nextSectionId)?.scrollIntoView({ behavior: "smooth", block: "center" });
        } else if (selectionKey === "muse") {
          document.getElementById("cinema-welcome-3")?.scrollIntoView({ behavior: "smooth", block: "center" });
        }

        // Nach der Auswahl: Ergebnis prüfen
        checkAndShowResult();
      }, 1400);
    }

    // ── Cinema-Sequenz ───────────────────────────────────────────────
    function playCinemaSequence() {
      raiseSectionAboveDimmer();
      activateDimmer(sectionId);

      setTimeout(() => titleEl?.classList.add("revealed"),    400);
      setTimeout(() => subtitleEl?.classList.add("revealed"), 1500);
      setTimeout(() => btn.classList.add("visible"),          2500);
      setTimeout(() => openSatellites(false),                 3300);

      sessionStorage.setItem(sessionKey, "1");
      animationPlayed = true;
    }

    function instantReveal() {
      raiseSectionAboveDimmer();
      activateDimmer(sectionId);
      titleEl?.classList.add("instant");
      subtitleEl?.classList.add("instant");
      btn.classList.add("visible");
      const selectedTitle = selectionTitles[selectionKey] || selections[selectionKey] || "";
      const hasSelection = Boolean(selections[selectionKey]);
      if (hasSelection) {
        satellitesOpen = false;
        btn.setAttribute("aria-expanded", "false");
        const hint = btn.querySelector<HTMLElement>(".cw-main-hint");
        const textEl = btn.querySelector<HTMLElement>(".cw-main-selected-text");
        if (hint) hint.style.display = "none";
        if (textEl && selectedTitle) {
          textEl.textContent = selectedTitle;
          textEl.classList.add("visible");
        }
        satEls.forEach(sat => sat.classList.remove("visible"));
        reopenBtn?.classList.add("visible");
        return;
      }
      openSatellites(true);
    }

    // ── Von außen aufrufbar: Sektion entsperren + abspielen ──────────
    function unlockAndActivate() {
      locked = false;
      // Sektion ggf. sichtbar machen (vorher display:none, damit vorher keine Page-Scroll-Fläche existierte)
      sec.classList.remove("cw--hidden");
      if (currentlyIntersecting) {
        if (!cinemaActive) {
          cinemaActive = true;
          if (animationPlayed) instantReveal();
          else playCinemaSequence();
        }
        // Bereits aktiv → nichts tun
      } else {
        // Noch nicht im Viewport → hinscrolln; Observer übernimmt den Rest
        sec.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    }

    // ── Von außen aufrufbar: Sektion als auto-gewählt markieren ──────
    // (Hauptkreis zeigt Auswahl, Satelliten erscheinen nicht)
    function applyAutoSelected(value: string, title: string) {
      selections[selectionKey]       = value;
      selectionTitles[selectionKey]  = title;
      locked      = false;
      cinemaActive = true;

      sec.classList.remove("cw--hidden");
      raiseSectionAboveDimmer();
      activateDimmer(sectionId);

      titleEl?.classList.add("instant");
      subtitleEl?.classList.add("instant");
      btn.classList.add("visible");

      // Ausgewählten Text im Hauptkreis zeigen (Text-Satelliten-Stil)
      const hint   = btn.querySelector<HTMLElement>(".cw-main-hint");
      const textEl = btn.querySelector<HTMLElement>(".cw-main-selected-text");
      if (hint)   hint.style.display = "none";
      if (textEl) { textEl.textContent = title; textEl.classList.add("visible"); }

      sessionStorage.setItem(sessionKey, "1");
      animationPlayed = true;
    }

    // ── Event-Listener ───────────────────────────────────────────────
    btn.addEventListener("click", () => {
      if (isAnimating) return;
      const href = getSelectionHref();
      if (!href) return;
      window.location.href = href;
    });

    reopenBtn?.addEventListener("click", () => {
      if (isAnimating || satellitesOpen) return;
      openSatellites(false);
    });

    satEls.forEach((sat, idx) => {
      sat.addEventListener("click", (e) => { e.preventDefault(); handleSatelliteClick(idx); });
      sat.addEventListener("mouseenter", () => setExtraDark(true));
      sat.addEventListener("mouseleave", () => setExtraDark(false));
    });

    // ── IntersectionObserver ─────────────────────────────────────────
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          currentlyIntersecting = entry.isIntersecting;
          if (entry.isIntersecting) {
            if (locked) return; // Warten bis vorherige Sektion eine Auswahl getroffen hat
            if (!cinemaActive) {
              cinemaActive = true;
              if (animationPlayed) {
                instantReveal();
              } else {
                playCinemaSequence();
              }
            } else {
              activateDimmer(sectionId);
            }
          } else {
            cinemaActive = false;
            deactivateDimmer(sectionId);
          }
        });
      },
      { threshold: 0.58 }
    );
    observer.observe(sec);

    return { unlockAndActivate, applyAutoSelected };
  }

  // ── Alle drei Sektionen initialisieren ───────────────────────────────────
  // Section 1 startet per Observer. Sections 2 + 3 warten auf Auswahl in der vorherigen Sektion.
  setupCinemaSection({ sectionId: "cinema-welcome",   orbitId: "cw-orbit",   mainBtnId: "cw-main",   sessionKey: "cinemaWelcome_v1",  selectionKey: "event" });
  sec2Controls = setupCinemaSection({ sectionId: "cinema-welcome-2", orbitId: "cw-orbit-2", mainBtnId: "cw-main-2", sessionKey: "cinemaWelcome2_v1", selectionKey: "muse",      requiresUnlock: true });
  sec3Controls = setupCinemaSection({ sectionId: "cinema-welcome-3", orbitId: "cw-orbit-3", mainBtnId: "cw-main-3", sessionKey: "cinemaWelcome3_v1", selectionKey: "geschmack", requiresUnlock: true });
</script>
