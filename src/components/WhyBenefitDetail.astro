---
import type { WhyBenefit } from '../utils/why';
import Layout from '../layouts/Layout.astro';
import Contact from './Contact.astro';
import FAQ from './FAQ.astro';

const {
  benefits,
  idx,
  basePrefix,
}: {
  benefits: WhyBenefit[];
  idx: number;
  basePrefix: string; // e.g. "/why" or "/berlin/why"
} = Astro.props as any;

const current = benefits[idx];

if (!current) {
  return Astro.redirect('/404');
}

const pageTitle = `${current.title} – Warum Kunstwolff | Kunstwolff`;
const pageDescription = current.text;
const safeBasePrefix = basePrefix.replace(/\/+$/, '');
---

<Layout title={pageTitle} description={pageDescription} image={current.image}>
  <section class="why-detail-hero">
    <div class="why-detail-inner">
      <div class="why-detail-copy">
        <h1>{current.title}</h1>
        <p class="why-detail-text">{current.text}</p>

        <a href="#contact" class="why-detail-cta" aria-label="Kontakt aufnehmen">
          Termin jetzt anfragen
        </a>
      </div>

      <div class="why-detail-image">
        <img src={current.image} alt={current.alt} loading="lazy" />
      </div>
    </div>
  </section>

  <section class="why-detail-next">
    <div class="why-detail-next-inner">
      <h2>Weitere Gründe</h2>
      <div class="why-detail-next-grid">
        {benefits.map((b, i) => (
          <a
            class={i === idx ? 'why-detail-next-card why-detail-next-card--active' : 'why-detail-next-card'}
            href={`${safeBasePrefix}/benefit-${i + 1}/`}
            aria-label={`Mehr zu: ${b.title}`}
          >
            <img src={b.image} alt={b.alt} loading="lazy" />
            <div class="why-detail-next-title">{b.title}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FAQ />
  <Contact />
</Layout>

<style>
  .why-detail-hero {
    padding: 90px 20px 60px;
    background: #f5f5f5;
    color: #000;
  }

  .why-detail-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
  }

  .why-detail-copy h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    line-height: 1.15;
    font-family: "Mayonice", Georgia, serif;
    font-weight: 400;
    margin: 0 0 18px;
    letter-spacing: 0.01em;
  }

  .why-detail-text {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.8;
    margin: 0 0 28px;
    color: #333;
  }

  .why-detail-cta {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 999px;
    background: #000;
    color: #fff;
    text-decoration: none;
    font-family: var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.85rem;
    font-weight: 600;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .why-detail-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
  }

  .why-detail-image img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.10);
  }

  .why-detail-next {
    padding: 60px 20px 80px;
    background: #000;
    color: #fff;
  }

  .why-detail-next-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .why-detail-next h2 {
    text-align: center;
    font-size: clamp(2.0rem, 4vw, 3.0rem);
    margin: 0 0 34px;
    font-family: "Mayonice", Georgia, serif;
    font-weight: 400;
    color: #fff;
  }

  .why-detail-next-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(160px, 1fr));
    gap: 18px;
  }

  .why-detail-next-card {
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .why-detail-next-card:hover {
    transform: translateY(-4px);
    border-color: rgba(201, 168, 76, 0.55);
    background: rgba(201, 168, 76, 0.08);
  }

  .why-detail-next-card--active {
    border-color: rgba(201, 168, 76, 0.95);
    background: rgba(201, 168, 76, 0.18);
  }

  .why-detail-next-card img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    display: block;
  }

  .why-detail-next-title {
    padding: 14px 14px 16px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    color: #fff;
  }

  @media (max-width: 980px) {
    .why-detail-inner {
      grid-template-columns: 1fr;
    }

    .why-detail-next-grid {
      grid-template-columns: repeat(2, minmax(160px, 1fr));
    }
  }

  @media (max-width: 520px) {
    .why-detail-next-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

