---
import { getAllFAQs, getFAQsByCity, getFAQsByCategories, matchesFAQContext, type FAQItem } from '../utils/faq';

const { 
  categories = [],
  city = '',
  faqs = [],
  interactive = false,
  maxItems = 4,
} = Astro.props as { 
  categories?: string[]; 
  city?: string;
  faqs?: FAQItem[]; 
  interactive?: boolean;
  maxItems?: number;
};

let list: FAQItem[];

if (faqs.length > 0) {
  // Wenn FAQs explizit übergeben werden, nutze diese
  list = faqs;
} else if (categories.length > 0 && city) {
  // Wenn Stadt + Kategorien übergeben werden, zuerst nach Stadt filtern, dann nach Kategorien
  const cityFaqs = getFAQsByCity(city);
  list = cityFaqs.filter((faq) => matchesFAQContext(faq, { categories, city }));

  // Fallback: wenn in der Stadt keine Kategorie-FAQs gefunden wurden, zumindest Kategorie-FAQs anzeigen
  if (list.length === 0) {
    list = getFAQsByCategories(categories).filter((faq) => matchesFAQContext(faq, { categories, city }));
  }
} else if (categories.length > 0) {
  // Wenn Kategorien übergeben werden, filtere danach
  list = getFAQsByCategories(categories).filter((faq) => matchesFAQContext(faq, { categories }));
} else if (city) {
  // Wenn Stadt übergeben wird, filtere danach
  list = getFAQsByCity(city).filter((faq) => matchesFAQContext(faq, { city }));
} else {
  // Sonst alle FAQs laden
  list = getAllFAQs();
}

// Fallback auf Default-FAQs wenn keine FAQs gefunden
const DEFAULT_FAQS: FAQItem[] = [
  {
    question: "Wie buche ich einen Schnellzeichner von Kunstwolff?",
    answer: "Sie können uns direkt über das Kontaktformular auf der Website anfragen oder uns telefonisch erreichen. Wir klären alle Details persönlich."
  },
  {
    question: "Welche Eventtypen decken Sie ab?",
    answer: "Wir arbeiten auf Firmenfeiern, Messen, Hochzeiten, Geburtstagen und internationalen Events – sowohl live vor Ort als auch digital."
  },
  {
    question: "Wie lange dauert eine Live-Zeichnung?",
    answer: "Die Dauer hängt vom Event ab. In der Regel zeichnen wir 5–10 Minuten pro Gast. Bei großen Events stimmen wir vorher ein flexibles Timing ab."
  },
  {
    question: "Kann das Event gebrandet werden?",
    answer: "Ja, wir integrieren Logos, Hashtags oder Event-Mottos direkt in die Zeichnungen – ideal für Corporate Events."
  },
  {
    question: "Sind Ihre Schnellzeichner auch international verfügbar?",
    answer: "Ja! Wir haben bereits Events weltweit betreut. Fragen Sie einfach nach Verfügbarkeit und Reiseoptionen."
  }
];

const finalList = list.length > 0 ? list : DEFAULT_FAQS;
const visibleFaqs = interactive ? finalList : finalList.slice(0, maxItems);
const suggestedTags = [
  'Buchung',
  'Preise',
  'Ablauf',
  'Firmenevent',
  'Hochzeit',
  'Branding',
  'International',
  'Verfügbarkeit',
];

// JSON-LD für FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": visibleFaqs.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section id="faq" class:list={['faq-section', interactive && 'faq-section--interactive']} data-faq-component>
  <div class="faq-container">
    <h2>Häufige Fragen (FAQ)</h2>
    {interactive && <div class="faq-controls">
      <label class="faq-search-wrap" for="faq-search-input">
        <span>Schnell nach Antworten suchen</span>
        <input
          id="faq-search-input"
          class="faq-search-input"
          type="search"
          placeholder="Suchbegriff eingeben, z. B. Buchung oder Hochzeit"
          autocomplete="off"
        />
      </label>

      <div class="faq-tags" aria-label="Vorgeschlagene FAQ-Themen">
        {suggestedTags.map((tag) => (
          <button type="button" class="faq-tag" data-faq-tag={tag}>
            {tag}
          </button>
        ))}
      </div>
    </div>}

    <div class="faq-grid" data-faq-grid>
      {visibleFaqs.map((faq) => (
        <details
          class="faq-item"
          data-faq-searchable={`${faq.question} ${faq.answer} ${(faq.categories ?? []).join(' ')} ${(faq.tags?.skills ?? []).join(' ')} ${(faq.tags?.events ?? []).join(' ')} ${(faq.tags?.landings ?? []).join(' ')}`.toLowerCase()}
        >
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>

    <p data-faq-empty-state class="faq-empty-state" hidden>
      Keine passende Antwort gefunden?
      <a href="/contact">Kontaktieren Sie uns direkt</a>
      und wir helfen Ihnen gerne weiter.
    </p>

    {!interactive && finalList.length > visibleFaqs.length && (
      <p class="faq-more-link">
        Weitere Fragen finden Sie auf der <a href="/faq">FAQ-Seite</a>.
      </p>
    )}
  </div>

  {interactive && (
    <script type="application/ld+json">
      {JSON.stringify(faqSchema)}
    </script>
  )}
</section>

<script is:inline>
  const faqComponents = document.querySelectorAll("[data-faq-component]");

  faqComponents.forEach((faqComponent) => {
    const faqSearchInput = faqComponent.querySelector("#faq-search-input");
    const faqGrid = faqComponent.querySelector("[data-faq-grid]");
    const faqEmptyState = faqComponent.querySelector("[data-faq-empty-state]");
    const faqTagButtons = faqComponent.querySelectorAll("[data-faq-tag]");

    if (!(faqSearchInput instanceof HTMLInputElement) || !faqGrid) return;

    const normalizeFaqTerm = (value) => (value || "").toLowerCase().trim();

    const filterFaqItems = (term) => {
      const normalizedTerm = normalizeFaqTerm(term);
      const faqItems = Array.from(faqGrid.querySelectorAll(".faq-item"));
      let visibleItems = 0;

      faqItems.forEach((item) => {
        const searchableText = item.getAttribute("data-faq-searchable") || "";
        const isVisible =
          normalizedTerm.length === 0 || searchableText.includes(normalizedTerm);

        item.hidden = !isVisible;
        if (isVisible) visibleItems += 1;
      });

      if (faqEmptyState) {
        faqEmptyState.hidden = visibleItems > 0;
      }

      faqTagButtons.forEach((button) => {
        const tag = normalizeFaqTerm(button.getAttribute("data-faq-tag"));
        button.classList.toggle("is-active", normalizedTerm.length > 0 && tag === normalizedTerm);
      });
    };

    faqSearchInput.addEventListener("input", (event) => {
      const input = event.target;
      if (!(input instanceof HTMLInputElement)) return;
      filterFaqItems(input.value);
    });

    faqTagButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!(button instanceof HTMLButtonElement)) return;
        const tag = button.getAttribute("data-faq-tag") || "";
        faqSearchInput.value = tag;
        faqSearchInput.focus();
        filterFaqItems(tag);
      });
    });
  });
</script>

<style>
.faq-section {
  padding: 80px 20px;
  background: #000;
}

.faq-section:not(.faq-section--interactive) {
  padding: 40px 20px;
}

.faq-container {
  max-width: 900px;
  margin: 0 auto;
}

.faq-container h2 {
  text-align: center;
  font-size: clamp(2.4rem, 5vw, 3.6rem);
  margin-bottom: 40px;
  color: #fff;
  font-family: "Mayonice", Georgia, serif;
  font-weight: 400;
  line-height: 1.25;
  letter-spacing: 0.01em;
}

.faq-section:not(.faq-section--interactive) .faq-container h2 {
  font-size: clamp(1.8rem, 3.5vw, 2.4rem);
  margin-bottom: 24px;
}

.faq-controls {
  margin-bottom: 26px;
}

.faq-search-wrap {
  display: grid;
  gap: 10px;
}

.faq-search-wrap span {
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.72);
}

.faq-search-input {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #2e2e2e;
  border-radius: 999px;
  background: #141414;
  color: #f5f5f5;
  padding: 14px 18px;
  font-size: 1rem;
}

.faq-search-input:focus {
  outline: none;
  border-color: rgba(191, 155, 80, 0.8);
  box-shadow: 0 0 0 3px rgba(191, 155, 80, 0.18);
}

.faq-tags {
  margin-top: 14px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.faq-tag {
  border: 1px solid #383838;
  border-radius: 999px;
  background: #111;
  color: #d8d8d8;
  padding: 8px 14px;
  font-size: 0.9rem;
  cursor: pointer;
  transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
}

.faq-tag:hover,
.faq-tag.is-active {
  border-color: rgba(191, 155, 80, 0.9);
  color: #fff;
  background: rgba(191, 155, 80, 0.18);
}

.faq-grid {
  display: grid;
  gap: 20px;
}

.faq-item summary {
  cursor: pointer;
  font-weight: 600;
  font-size: 1.1rem;
  padding: 15px 20px;
  background: #1c1c1c;
  color: #f5f5f5;
  border-radius: 8px;
  border: 1px solid #2b2b2b;
  transition: background 0.3s ease;
}

.faq-item[open] summary {
  background: #252525;
}

.faq-item p {
  padding: 15px 20px;
  margin: 0;
  font-size: 1rem;
  color: #d0d0d0;
  background: #191919;
  border: 1px solid #2b2b2b;
  border-top: none;
  border-radius: 0 0 8px 8px;
}

.faq-empty-state {
  margin-top: 20px;
  padding: 18px 20px;
  border-radius: 12px;
  border: 1px solid rgba(191, 155, 80, 0.4);
  background: rgba(191, 155, 80, 0.08);
  color: #ececec;
}

.faq-empty-state a {
  color: #d7b96a;
  text-decoration: none;
  border-bottom: 1px solid rgba(215, 185, 106, 0.65);
}

.faq-more-link {
  margin-top: 16px;
  color: #c7c7c7;
  font-size: 0.95rem;
}

.faq-more-link a {
  color: #d7b96a;
  text-decoration: none;
  border-bottom: 1px solid rgba(215, 185, 106, 0.65);
}
</style>