---
import { getAllFAQs, getFAQsByCategory, getFAQsByCity, getFAQsByCategories, type FAQItem } from '../utils/faq';

const { 
  categories = [],
  city = '',
  faqs = [],
} = Astro.props as { 
  categories?: string[]; 
  city?: string;
  faqs?: FAQItem[]; 
};

let list: FAQItem[];

if (faqs.length > 0) {
  // Wenn FAQs explizit übergeben werden, nutze diese
  list = faqs;
} else if (categories.length > 0 && city) {
  // Wenn Stadt + Kategorien übergeben werden, zuerst nach Stadt filtern, dann nach Kategorien
  const cityFaqs = getFAQsByCity(city);
  const categoryKeys = categories.map((value) => value.trim().toLowerCase());

  list = cityFaqs.filter((faq) =>
    faq.categories?.some((cat) => categoryKeys.includes(cat.trim().toLowerCase())),
  );

  // Fallback: wenn in der Stadt keine Kategorie-FAQs gefunden wurden, zumindest Kategorie-FAQs anzeigen
  if (list.length === 0) {
    list = getFAQsByCategories(categories);
  }
} else if (categories.length > 0) {
  // Wenn Kategorien übergeben werden, filtere danach
  list = getFAQsByCategories(categories);
} else if (city) {
  // Wenn Stadt übergeben wird, filtere danach
  list = getFAQsByCity(city);
} else {
  // Sonst alle FAQs laden
  list = getAllFAQs();
}

// Fallback auf Default-FAQs wenn keine FAQs gefunden
const DEFAULT_FAQS: FAQItem[] = [
  {
    question: "Wie buche ich einen Schnellzeichner von Kunstwolff?",
    answer: "Sie können uns direkt über das Kontaktformular auf der Website anfragen oder uns telefonisch erreichen. Wir klären alle Details persönlich."
  },
  {
    question: "Welche Eventtypen decken Sie ab?",
    answer: "Wir arbeiten auf Firmenfeiern, Messen, Hochzeiten, Geburtstagen und internationalen Events – sowohl live vor Ort als auch digital."
  },
  {
    question: "Wie lange dauert eine Live-Zeichnung?",
    answer: "Die Dauer hängt vom Event ab. In der Regel zeichnen wir 5–10 Minuten pro Gast. Bei großen Events stimmen wir vorher ein flexibles Timing ab."
  },
  {
    question: "Kann das Event gebrandet werden?",
    answer: "Ja, wir integrieren Logos, Hashtags oder Event-Mottos direkt in die Zeichnungen – ideal für Corporate Events."
  },
  {
    question: "Sind Ihre Schnellzeichner auch international verfügbar?",
    answer: "Ja! Wir haben bereits Events weltweit betreut. Fragen Sie einfach nach Verfügbarkeit und Reiseoptionen."
  }
];

const finalList = list.length > 0 ? list : DEFAULT_FAQS;

// JSON-LD für FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": finalList.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<section id="faq" class="faq-section">
  <div class="faq-container">
    <h2>Häufige Fragen (FAQ)</h2>

    <div class="faq-grid">
      {finalList.map((faq, idx) => (
        <details class="faq-item">
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>

  <script type="application/ld+json">
    {JSON.stringify(faqSchema)}
  </script>
</section>

<style>
.faq-section {
  padding: 80px 20px;
  background: #000;
}

.faq-container {
  max-width: 900px;
  margin: 0 auto;
}

.faq-container h2 {
  text-align: center;
  font-size: clamp(2.4rem, 5vw, 3.6rem);
  margin-bottom: 40px;
  color: #fff;
  font-family: "Mayonice", Georgia, serif;
  font-weight: 400;
  line-height: 1.25;
  letter-spacing: 0.01em;
}

.faq-grid {
  display: grid;
  gap: 20px;
}

.faq-item summary {
  cursor: pointer;
  font-weight: 600;
  font-size: 1.1rem;
  padding: 15px 20px;
  background: #1c1c1c;
  color: #f5f5f5;
  border-radius: 8px;
  border: 1px solid #2b2b2b;
  transition: background 0.3s ease;
}

.faq-item[open] summary {
  background: #252525;
}

.faq-item p {
  padding: 15px 20px;
  margin: 0;
  font-size: 1rem;
  color: #d0d0d0;
  background: #191919;
  border: 1px solid #2b2b2b;
  border-top: none;
  border-radius: 0 0 8px 8px;
}
</style>