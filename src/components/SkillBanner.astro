---
type Skill = {
  title?: string;
  image?: string;
  link?: string;
  alt?: string;
};

// Astro.props enthält die skills, die wir aus der Landingpage-JSON oder von einer Seite übergeben
const { skills = [], items = [] } = Astro.props as { skills?: Skill[]; items?: Skill[] };
const rawItems: Skill[] = (skills && skills.length) ? skills : items;

const FALLBACK_SKILLS: Required<Skill>[] = [
  {
    title: "Schnellzeichner",
    image: "/img/UnsereFähigkeitenBilder/Hochzeitsmaler.jpg",
    link: "/schnellzeichner/",
    alt: "Live Schnellzeichner",
  },
  {
    title: "Szenenmaler",
    image: "/img/UnsereFähigkeitenBilder/Hochzeitsmaler.jpg",
    link: "/szenenmaler/",
    alt: "Szenenmalerei",
  },
];

const DEFAULT_TITLE = "Unser Können";
const DEFAULT_IMAGE = "/img/samples/sample1.jpeg"; // generic fallback for stray extras
const DEFAULT_LINK = "";

const normalizedItems: Required<Skill>[] = rawItems.map((skill) => ({
  title: skill.title ?? DEFAULT_TITLE,
  image: skill.image ?? DEFAULT_IMAGE,
  link: skill.link ?? DEFAULT_LINK,
  alt: skill.alt ?? skill.title ?? DEFAULT_TITLE,
}));

const list: Required<Skill>[] =
  normalizedItems.length > 0
    ? normalizedItems
    : FALLBACK_SKILLS.map((skill) => ({
    title: skill.title ?? DEFAULT_TITLE,
    image: skill.image ?? DEFAULT_IMAGE,
    link: skill.link ?? DEFAULT_LINK,
    alt: skill.alt ?? skill.title ?? DEFAULT_TITLE,
  }));
---

<section class="skills-section">
  <div class="skills-grid">
    {list.map((skill) => (
      <div class="skill-item">
        {skill.link ? (
          <a class="skill-link" href={skill.link} target="_blank" rel="noopener noreferrer">
            <img
              src={skill.image}
              alt={skill.alt ?? skill.title}
              class="skill-image"
              loading="lazy"
            />
            <div class="skill-label">{skill.title}</div>
          </a>
        ) : (
          <>
            <img
              src={skill.image}
              alt={skill.alt ?? skill.title}
              class="skill-image"
              loading="lazy"
            />
            <div class="skill-label">{skill.title}</div>
          </>
        )}
      </div>
    ))}
  </div>
</section>

<style>
.skills-section {
  --skill-size: 220px;
  --skill-gap: 36px;
  padding: clamp(58px, 9vw, 88px) 20px 34px;
  background: #000000;
}

.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(var(--skill-size), var(--skill-size)));
  gap: var(--skill-gap);
  justify-content: center;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
}

.skill-item {
  position: relative;
  width: var(--skill-size);
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  overflow: hidden;
}

.skill-link {
  display: block;
  width: 100%;
  height: 100%;
  color: inherit;
  text-decoration: none;
  position: relative;
}

.skill-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: brightness(0.85);
  transition: filter 0.3s ease, transform 0.3s ease;
}

.skill-label {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 700;
  letter-spacing: 0.08em;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.skill-item:hover .skill-image {
  filter: brightness(0.45);
  transform: scale(1.05);
}

.skill-item:hover .skill-label {
  opacity: 1;
}

@media (max-width: 900px) {
  .skills-section {
    --skill-size: 190px;
    --skill-gap: 26px;
    padding-top: clamp(48px, 7.5vw, 68px);
  }
}

@media (max-width: 560px) {
  .skills-section {
    --skill-size: 160px;
    --skill-gap: 20px;
    padding-top: 44px;
  }
}
</style> 