---
import { cityComboPath, skillSlugFromLink } from "../utils/comboUrls";

type Skill = {
  title?: string;
  image?: string;
  link?: string;
  alt?: string;
};

// Astro.props enthält die skills, die wir aus der Landingpage-JSON oder von einer Seite übergeben
const {
  skills = [],
  items = [],
  introTitle = "Welcher Geschmack darf's sein?",
  introText = "Sie suchen Kunst und Unterhaltung für Ihren besonderen Anlass? Da sind sie hier goldrichtig. Wir bieten mehr als nur einen Live Künstler. Finden Sie in unserem Repertoire Zeichnungen, die natürliche Icebreaker bieten, persönliche Kunstwerke die permanente Erinnerungen schaffen, bis hin zu kompletten Gemälden die Sie beim Entstehen beobachten konnten.",
  showIntro = true,
  currentLanding = "",
} = Astro.props as {
  skills?: Skill[];
  items?: Skill[];
  introTitle?: string;
  introText?: string;
  showIntro?: boolean;
  currentLanding?: string;
};
const rawItems: Skill[] = skills && skills.length ? skills : items;

/**
 * Steht der Banner auf einer Stadtseite, zeigen die Skill-Kacheln auf die
 * Kombi-Seite dieser Stadt statt auf die allgemeine Skill-Seite.
 *
 * Die Adresse baut `cityComboPath` – früher wurde hier `link + '/' + stadt`
 * zusammengeklebt, was seit der flachen Ort-Kombi falsch wäre.
 */
const adjustSkillLink = (originalLink: string): string => {
  if (!currentLanding) return originalLink;
  return cityComboPath(skillSlugFromLink(originalLink), currentLanding);
};

const FALLBACK_SKILLS: Required<Skill>[] = [
  {
    title: "Schnellzeichner",
    image: "/img/UnsereFähigkeitenBilder/Schnellzeichner/IMG_20240528_143426.webp",
    link: "/schnellzeichner-karikaturist/",
    alt: "Live Schnellzeichner",
  },
  {
    title: "Szenenmaler",
    image: "/img/UnsereFähigkeitenBilder/Szenenmaler/Event-Illustrationen.webp",
    link: "/szenenmaler/",
    alt: "Szenenmalerei",
  },
];

const DEFAULT_TITLE = "Unser Können";
const DEFAULT_IMAGE = "/img/samples/sample1.webp"; // generic fallback for stray extras
const DEFAULT_LINK = "";

const normalizedItems: Required<Skill>[] = rawItems.map((skill) => ({
  title: skill.title ?? DEFAULT_TITLE,
  image: skill.image ?? DEFAULT_IMAGE,
  link: adjustSkillLink(skill.link ?? DEFAULT_LINK),
  alt: skill.alt ?? skill.title ?? DEFAULT_TITLE,
}));

const list: Required<Skill>[] =
  normalizedItems.length > 0
    ? normalizedItems
    : FALLBACK_SKILLS.map((skill) => ({
        title: skill.title ?? DEFAULT_TITLE,
        image: skill.image ?? DEFAULT_IMAGE,
        link: adjustSkillLink(skill.link ?? DEFAULT_LINK),
        alt: skill.alt ?? skill.title ?? DEFAULT_TITLE,
      }));

const leftSkill = list[0] ?? FALLBACK_SKILLS[0];
const rightSkill = list[1] ?? FALLBACK_SKILLS[1] ?? FALLBACK_SKILLS[0];
---

<section class="skills-section" id="skills-section-banner">
  <div class="skills-columns">
    <div class="skills-col skills-col-left">
      <div class="skill-item" data-flash-index="0">
        {
          leftSkill.link ? (
            <a
              class="skill-link"
              href={leftSkill.link}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={leftSkill.image}
                alt={leftSkill.alt ?? leftSkill.title}
                class="skill-image"
                loading="lazy"
              />
              <div class="skill-label">{leftSkill.title}</div>
            </a>
          ) : (
            <>
              <img
                src={leftSkill.image}
                alt={leftSkill.alt ?? leftSkill.title}
                class="skill-image"
                loading="lazy"
              />
              <div class="skill-label">{leftSkill.title}</div>
            </>
          )
        }
      </div>
    </div>

    <div class="skills-col skills-col-center">
      {
        showIntro && (
          <div class="skills-intro">
            <h2>{introTitle}</h2>
            <p>{introText}</p>
          </div>
        )
      }

      <slot />
    </div>

    <div class="skills-col skills-col-right">
      <div class="skill-item" data-flash-index="1">
        {
          rightSkill.link ? (
            <a
              class="skill-link"
              href={rightSkill.link}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={rightSkill.image}
                alt={rightSkill.alt ?? rightSkill.title}
                class="skill-image"
                loading="lazy"
              />
              <div class="skill-label">{rightSkill.title}</div>
            </a>
          ) : (
            <>
              <img
                src={rightSkill.image}
                alt={rightSkill.alt ?? rightSkill.title}
                class="skill-image"
                loading="lazy"
              />
              <div class="skill-label">{rightSkill.title}</div>
            </>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .skills-section {
    --skill-size: 220px;
    /* Abstand der Kreise nach innen (Richtung Mitte): kleiner = weniger nach innen */
    --skills-circle-inner-offset: 30px;
    /* EINZIGER Regler: 1 = normal, 1.1 = +10%, 0.9 = -10% */
    --skills-padding-factor: 1.2;
    /* Steuert ausschließlich den oberen Abstand der gesamten Skill-Section */
    --skills-padding-top: clamp(
      calc(72px * var(--skills-padding-factor)),
      calc(10vw * var(--skills-padding-factor)),
      calc(102px * var(--skills-padding-factor))
    );
    padding: var(--skills-padding-top) 20px 24px;
    background: #000000;
  }

  .skills-columns {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .skills-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .skills-col-left,
  .skills-col-right {
    flex: 0 0 25%;
    max-width: 25%;
  }

  .skills-col-left {
    align-items: flex-start;
  }

  .skills-col-right {
    align-items: flex-end;
  }

  .skills-col-center {
    flex: 0 0 50%;
    max-width: 50%;
    min-width: 0;
    padding: 0 20px;
  }

  .skills-intro {
    max-width: 100%;
    margin: 0;
    text-align: center;
    color: #fff;
  }

  .skills-intro h2 {
    margin: 0;
  }

  .skills-intro p {
    margin: 12px 0 0;
    line-height: 1.6;
    opacity: 0.9;
  }

  .skills-mini-reviews {
    margin: 40px 0;
    width: 100%;
  }

  .skill-item {
    position: relative;
    width: var(--skill-size);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
  }

  .skills-col-left .skill-item {
    transform: translateX(var(--skills-circle-inner-offset));
  }

  .skills-col-right .skill-item {
    transform: translateX(calc(var(--skills-circle-inner-offset) * -1));
  }

  .skill-link {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
    position: relative;
  }

  .skill-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.85);
    transition:
      filter 0.3s ease,
      transform 0.3s ease;
  }

  .skill-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 700;
    letter-spacing: 0.08em;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .skill-item:hover .skill-image {
    filter: brightness(0.45);
    transform: scale(1.05);
  }

  .skill-item:hover .skill-label {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .skills-section {
      --skill-size: 190px;
      --skills-circle-inner-offset: 18px;
      --skills-padding-top: clamp(
        calc(58px * var(--skills-padding-factor)),
        calc(8.5vw * var(--skills-padding-factor)),
        calc(78px * var(--skills-padding-factor))
      );
    }
  }

  /* ── Aufleuchten-Animation ──────────────────────────────────────────────
     Kurzer Helligkeits-Flash + weißer Glow-Ring ums Bild.
     Läuft einmal pro Kreis, gestaffelt nach data-flash-index.
  ─────────────────────────────────────────────────────────────────────── */
  /* Brightness-Blitz auf dem Bild */
  @keyframes skill-flash {
    0%   { filter: brightness(0.85); }
    30%  { filter: brightness(2.0); }
    60%  { filter: brightness(1.4); }
    100% { filter: brightness(0.85); }
  }

  /* Heiligenschein-Ring auf dem Kreis selbst – box-shadow überlebt overflow:hidden */
  @keyframes skill-glow {
    0%   { box-shadow: 0 0 0   0px rgba(255, 240, 200, 0); }
    30%  { box-shadow: 0 0 18px 10px rgba(255, 240, 200, 0.85); }
    60%  { box-shadow: 0 0 12px  6px rgba(255, 240, 200, 0.4); }
    100% { box-shadow: 0 0 0   0px rgba(255, 240, 200, 0); }
  }

  /* Klasse wird via JS gesetzt */
  .skill-item.is-flashing {
    animation: skill-glow 0.9s ease-out forwards;
  }
  .skill-item.is-flashing .skill-image {
    animation: skill-flash 0.9s ease-out forwards;
    transition: none;
  }

  @media (max-width: 560px) {
    .skills-section {
      --skill-size: 160px;
      --skills-circle-inner-offset: 12px;
      --skills-padding-top: calc(52px * var(--skills-padding-factor));
    }

    .skills-col-center {
      padding: 0 12px;
    }
  }
</style>

<script>
  // ── Skill-Flash-Intro-Animation ─────────────────────────────────────────
  // Feuert NUR EINMAL pro Session (sessionStorage-Flag), sobald der Banner
  // das erste Mal ins Sichtfeld scrollt. Die Kreise leuchten nacheinander auf.
  // ──────────────────────────────────────────────────────────────────────────

  const FLASH_KEY = "skillBannerFlashed_v4";
  // Pause nach dem Scroll bevor die erste Animation startet
  const INITIAL_DELAY_MS = 500;
  // Abstand zwischen den Kreisen
  const STAGGER_MS = 700;

  function triggerFlash() {
    // Abbruch wenn schon in dieser Session gefeuert
    if (sessionStorage.getItem(FLASH_KEY)) return;
    sessionStorage.setItem(FLASH_KEY, "1");

    const section = document.getElementById("skills-section-banner");
    if (!section) return;

    // Alle Kreise nach ihrem data-flash-index sortieren und gestaffelt starten
    const items = Array.from(
      section.querySelectorAll<HTMLElement>(".skill-item[data-flash-index]")
    ).sort(
      (a, b) =>
        Number(a.dataset.flashIndex) - Number(b.dataset.flashIndex)
    );

    items.forEach((item, i) => {
      setTimeout(() => {
        item.classList.add("is-flashing");

        // Nach der Animation Klasse wieder entfernen (damit hover-Effekte
        // nicht durch verbleibende Styles gestört werden)
        item.addEventListener(
          "animationend",
          () => item.classList.remove("is-flashing"),
          { once: true }
        );
      }, INITIAL_DELAY_MS + i * STAGGER_MS);
    });
  }

  // IntersectionObserver: feuert wenn 30% der Section sichtbar sind
  const section = document.getElementById("skills-section-banner");
  if (section) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            triggerFlash();
            observer.disconnect(); // nie wieder beobachten nötig
          }
        });
      },
      { threshold: 0.1 }
    );
    observer.observe(section);
  }
</script>
