---
import "../styles/global.css";
import "../styles/global_nav.css";
import "../styles/global_footer.css";
import "../styles/startpage.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">

	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Kunstwolff - Eventkünstler seit über 20 Jahren</title>

		<!-- Meta-Tags (im <head>) -->
		<meta
			name="description"
			content="Kunstwolff - Kreative Event-Kunst & Live-Performance für Ihr Event seit über 20 Jahren."
		/>
	</head>

	
	<body>
		<Header />
		<slot />
		<Footer />
	</body>

</html>



<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: rgb(103, 103, 134);
	}
</style>
