---
import "../styles/global.css";
import Header from "../components/header/Header.astro";
import Footer from "../components/Footer.astro";
import LangSwitcher from "../components/LangSwitcher.astro";
import type { LangAlternate } from "../components/LangSwitcher.astro";
import { isPageHiddenByPath } from "../utils/pageVisibility";
import { DEFAULT_LOCALE } from "../i18n/config";

const {
  title = "Kunstwolff – Eventkünstler seit über 25 Jahren",
  description = "Kunstwolff – Kreative Event-Kunst & Live-Performance für Ihr Event seit über 25 Jahren.",
  image,
  noindex = false,
  // i18n (Phase 1): Standard = Deutsch, keine Alternativen → bestehende Seiten
  // rendern byte-identisch (kein zusätzliches Markup). Nur übersetzte Seiten
  // übergeben `lang` + `alternates`.
  lang = "de",
  alternates = [] as LangAlternate[],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// og:image-Fallback: Seiten ohne eigenes Titelbild (Kontakt, FAQ, Impressum …)
// bekommen das Standard-Titelbild, damit die Social-Vorschau nie leer ist.
//
// WebP, nicht AVIF (2026-08-05). Bis dahin stand hier
// `/img/Titelbild/default/titelbild.avif` – Facebook, LinkedIn und X lesen AVIF
// für `og:image` nicht zuverlässig, die Standard-Vorschau blieb dort also leer.
// `/img/og/og-default.webp` ist dieselbe Aufnahme, nur umkodiert: gleiche Maße
// (1180×818), nichts beschnitten, nichts skaliert.
const DEFAULT_OG_IMAGE = "/img/og/og-default.webp";
const ogImage = Astro.site ? new URL(image ?? DEFAULT_OG_IMAGE, Astro.site).href : undefined;

// ─── Robots-Meta: Production-Host-Whitelist + Page-Visibility ────────────────
// Eine Seite bekommt noindex/nofollow, wenn EINE der drei Bedingungen zutrifft:
//   (1) explizite `noindex`-Prop vom aufrufenden Layout (z.B. EventLayout)
//   (2) der Pfad ist in `public/config/page-visibility.json` als hidden
//       markiert (Admin-Tool steuert das); Sitemap-Filter in astro.config.mjs
//       blendet dieselben Pfade aus dem sitemap.xml aus
//   (3) der aktuelle Host ist NICHT in der Production-Whitelist
//       (kunstwolff.de + www.kunstwolff.de). Dadurch wird die Vercel-Stage
//       (`kunstwolff.vercel.app`), Branch-Previews und der Dev-Server
//       automatisch noindex – Crawler-Trap LIVE-3 entschärft, siehe
//       memory/seo.md.
// Wenn `Astro.site` undefined ist (defensive: jemand zerschießt die Konfig)
// → ebenfalls noindex.
const PRODUCTION_HOSTS = new Set(["kunstwolff.de", "www.kunstwolff.de"]);
const isProductionHost =
  !!Astro.site && PRODUCTION_HOSTS.has(Astro.site.host);
const shouldNoindex =
  noindex || isPageHiddenByPath(Astro.url.pathname) || !isProductionHost;
const robotsContent = shouldNoindex ? "noindex, nofollow" : "index, follow";

// ─── hreflang nur auf indexierbaren Seiten ───────────────────────────────────
// Eine `noindex`-Seite, die Sprachalternativen bewirbt, ist ein Widerspruch:
// Google liest „nimm mich nicht auf" und gleichzeitig „hier sind meine
// Sprachfassungen". Konkreter Fall bis 2026-08-05: `/fr/belgique/` stand auf
// `index, follow` und verwies per `hreflang="de"` auf `/belgique/`, das selbst
// ausgeblendet war — die einzige beworbene Alternative war unerreichbar.
const showAlternates = !shouldNoindex && alternates.length > 1;

// `x-default` = die Fassung für alle Sprachen, die wir NICHT anbieten. Das ist
// die deutsche: sie ist die Ausgangssprache und die einzige vollständige.
const xDefaultHref = showAlternates
  ? alternates.find((a) => a.locale === DEFAULT_LOCALE)?.href
  : undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<!-- Mayonice sofort laden: preload umgeht die CSS-@import-Kaskade
		     (HTML → CSS → @import swiper → @font-face → Download).
		     Ohne preload entdeckt der Browser die Font erst nach allen @imports. -->
		<link rel="preload" href="/fonts/mayonice/Mayonice.woff2" as="font" type="font/woff2" crossorigin />
		{/* Inter wird seit 2026-07-31 selbst ausgeliefert (siehe global.css).
		    Vorher standen hier zwei preconnects und ein Stylesheet von Google –
		    damit ging die IP jedes Besuchers an Google, ohne Einwilligung.
		    Preload aus demselben Grund wie bei Mayonice: die @font-face steht
		    hinter mehreren CSS-@imports und würde sonst spät entdeckt. */}
		<link rel="preload" href="/fonts/inter/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/webp" href="/img/logo/logo_transparent.webp" />
		<link rel="apple-touch-icon" href="/img/logo/logo_transparent.webp" />
		<link rel="canonical" href={canonicalURL} />
		{/* i18n (Phase 1): hreflang-Alternativen nur wenn vorhanden UND die Seite
		     indexierbar ist – deutsche Seiten ohne Übersetzung bleiben
		     unverändert. Siehe `showAlternates` oben. */}
		{showAlternates && alternates.map((a) => (
			<link rel="alternate" hreflang={a.locale} href={new URL(a.href, Astro.site).href} />
		))}
		{xDefaultHref && (
			<link rel="alternate" hreflang="x-default" href={new URL(xDefaultHref, Astro.site).href} />
		)}
		<meta name="robots" content={robotsContent} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content="website" />
		{ogImage && <meta property="og:image" content={ogImage} />}
		{/* Twitter/X liest Open Graph nur teilweise mit: ohne `twitter:card`
		     zeigt es einen nackten Link statt einer Vorschaukarte. Die Inhalte
		     sind dieselben wie bei OG – doppelt gepflegt wird hier nichts. */}
		<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}
	</head>

	<body data-nav-tone="dark">
		<Header />
		<LangSwitcher alternates={alternates} />
		<slot />
		<Footer />
	</body>
</html>
