---
import Footer from "../components/Footer.astro";
import Header from "../components/header/Header.astro";
import "../styles/global.css";

const {
	title = "Schnellzeichner für Events buchen | Kunstwolff",
	description = "Schnellzeichner für Firmenfeiern, Messen & Hochzeiten. Live Karikaturen und digitale Portraits als Highlight für Ihr Event. Jetzt Kunstwolff buchen!",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
        <meta name="description" content={description} />

		<!-- Meta-Tags (im <head>) -->
		
	</head>

	<body data-nav-tone="light">
		<Header />
		<slot />
		<Footer />
	</body>
</html>