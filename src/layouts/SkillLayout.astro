---
import Layout from "./Layout.astro";
import "../styles/global.css";

const {
	title = "Event-Künstler buchen | Kunstwolff",
	description = "Professionelle Event-Künstler für Firmenfeiern, Messen & Hochzeiten. Live-Kunst als Highlight für Ihr Event. Jetzt Kunstwolff buchen!",
	image,
} = Astro.props;
---

	<Layout title={title} description={description} image={image}>
    <slot />
  </Layout>
