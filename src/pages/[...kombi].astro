---
/**
 * [...kombi].astro
 *
 * Dynamische Route für zwei Seiten-Typen:
 *
 * 1. pageType === 'landing'  → Skill+Stadt-Seiten: /berlin-schnellzeichner-karikaturist/, /frankfurt-szenenmaler/, ...
 *    SkillLayout mit SkillHero, Slideshow, Why, FAQ, Contact
 *
 * 2. pageType === 'event'    → Skill+Event-Seiten: /schnellzeichner-karikaturist/firmenfeier/, /szenenmaler/hochzeit/, ...
 *    EventLayout mit EventHero (skill-spezifisch), Slideshow, Ablauf, Pakete, EventSkills, Referenzen, FAQ, Contact
 *
 * ⚠️ **Warum eine Rest-Route (`[...kombi]`) und nicht mehr `[skill]/[landing]`:**
 * Seit dem 01.08.2026 sind die beiden Typen **verschieden tief** – Orte flach,
 * Anlässe hierarchisch (Begründung in `utils/comboUrls.ts`). Eine Ordner-Route
 * kann immer nur eine Tiefe erzeugen; eine Rest-Route darf den Schrägstrich
 * selbst setzen und deckt damit beide Formen aus **einer** Datei ab. Ohne das
 * müsste dieselbe Sektions-Verkabelung zweimal dastehen und würde driften.
 *
 * `skill` und `landing` kommen deshalb als **Props**, nicht mehr aus
 * `Astro.params` – aus `berlin-schnellzeichner-karikaturist` liesse sich die
 * Grenze zwischen Ort und Skill nicht zuverlässig zurückrechnen (beide
 * enthalten Bindestriche). getStaticPaths weiss es, also gibt es sie weiter.
 *
 * getStaticPaths() generiert:
 *   - Alle Skills × alle Städte  → pageType: 'landing', flache Adresse
 *   - Alle Skills × alle Events  → pageType: 'event',   hierarchische Adresse
 */

// ── Gemeinsame Imports ─────────────────────────────────────────────────────────
import EventLayout from '../layouts/EventLayout.astro';
import Contact from '../components/Contact.astro';
import FAQ from '../components/FAQ.astro';
import Slideshow from '../components/slideshows/Slideshow.astro';
import { getLandingSlugs } from '../utils/landings';
import { getCityDisplayName } from '../utils/cityNames';
import { getSkillBySlug, getSkillSlugs, skillContentKey } from '../utils/skills';
import { cityComboSlug, cityComboPath, eventComboPath } from '../utils/comboUrls';
import {
  MIN_LANDING_SLIDES,
  getCitySlides,
  getDefaultSlides,
  getSkillSlidesForCity,
  supplementWithDefaultSlides,
} from '../utils/slideImages';

// ── Landing-spezifische Imports ───────────────────────────────────────────────
import SkillHero from '../components/hero/SkillHero.astro';
import Landingsection from '../components/Landingsection.astro';
import Why from '../components/Why.astro';
import LandingErinnerungen from '../components/LandingErinnerungen.astro';
import SkillLayout from '../layouts/SkillLayout.astro';
import { resolveTitleImage } from '../utils/titleImages';
import { resolveHeroBg } from '../utils/heroBg';
import { getReviewsByLandingAndSkill } from '../utils/reviews';

// ── Event-spezifische Imports ─────────────────────────────────────────────────
import EventHero from '../components/events/EventHero.astro';
import EventSkills from '../components/events/EventSkills.astro';
import LandingIntro from '../components/LandingIntro.astro';
import ComboBenefits from '../components/combo/ComboBenefits.astro';
import EventTeaser from '../components/combo/EventTeaser.astro';
import { getSkillEventContent } from '../utils/comboContent';
import {
  getEventSlugs,
  getEventBySlug,
  getEventContent,
  getEventSlides,
  resolveEventTitleImage,
} from '../utils/events';
import { isComponentEnabled, resolveSectionOrder, type PageType } from '../utils/componentConfig';

// ── getStaticPaths: alle Skill+Stadt + Skill+Event Kombinationen ──────────────
export async function getStaticPaths() {
  const skills = getSkillSlugs();
  const landings = getLandingSlugs();
  const events = getEventSlugs();

  // Skill × Stadt → pageType: 'landing', FLACHE Adresse (/berlin-szenenmaler/)
  const cityPaths = skills.flatMap((skill) =>
    landings.map((landing) => ({
      params: { kombi: cityComboSlug(skill, landing) },
      props: { pageType: 'landing' as const, skill, landing },
    }))
  );

  // Skill × Event → pageType: 'event', HIERARCHISCH (/szenenmaler/hochzeit/)
  const eventPaths = skills.flatMap((skill) =>
    events.map((landing) => ({
      params: { kombi: `${skill}/${landing}` },
      props: { pageType: 'event' as const, skill, landing },
    }))
  );

  return [...cityPaths, ...eventPaths];
}

// ── Props ─────────────────────────────────────────────────────────────────────
// Nicht aus Astro.params: die flache Adresse ist nicht zerlegbar (siehe oben).
const {
  pageType,
  skill,
  landing,
} = Astro.props as { pageType: 'landing' | 'event'; skill: string; landing: string };

const pt: PageType = pageType === 'event' ? 'skill-event' : 'skill-landing';

// Skill ist für beide Typen nötig
const skillData = getSkillBySlug(skill ?? '');

if (!skillData) {
  return Astro.redirect('/404');
}

/**
 * `skill` ist die ADRESSE, `skillKey` der INHALT.
 *
 * Seit „Schnellzeichner" auf `/schnellzeichner-karikaturist/` liegt, sind das
 * zwei verschiedene Zeichenketten. Ordner und Dateien (Titelbild, hero-bg, Why,
 * Erinnerungen, Kombitexte, Bild-Tags) heißen nach dem TITEL — so legen die
 * Sync-Skripte sie an. URLs (Breadcrumb, Schema, Städte-Links, Nachbar-Skills)
 * heißen nach dem `link`. Wer die beiden vertauscht, bekommt keine
 * Fehlermeldung, sondern eine leere Sektion.
 */
const skillKey = skillContentKey(skillData.title);

// ─────────────────────────────────────────────────────────────────────────────
// SKILL+LANDING-Seite: bestehende Logik unverändert
// ─────────────────────────────────────────────────────────────────────────────
let landingSlides: Awaited<ReturnType<typeof supplementWithDefaultSlides>> | undefined;
let reviews: unknown[] = [];
let skillCityTitleImage = '';
let skillCityHeroBg: string | null = null;
let skillCityPageTitle = '';
let skillCityDescription = '';
let skillCityBreadcrumb: unknown;
let cityName = '';

// WEB-012: Schema-URLs aus Astro.site (= SITE_URL) statt hardcoded kunstwolff.de.
const site = Astro.site?.origin ?? 'https://kunstwolff.de';

if (pageType === 'landing') {
  const rawCitySlides = getCitySlides(landing ?? '');
  const defaultSlides = getDefaultSlides();
  // Erst nach Skill filtern, DANN auffüllen – sonst werden die Nachfüller von
  // der Slideshow gleich wieder aussortiert und die Galerie bleibt leer.
  landingSlides = getSkillSlidesForCity(
    rawCitySlides,
    defaultSlides,
    skillData.title,
    MIN_LANDING_SLIDES,
  );
  reviews = getReviewsByLandingAndSkill(landing ?? '', skillData.title);
  skillCityTitleImage = resolveTitleImage({ skill: skillKey, landing });
  skillCityHeroBg = resolveHeroBg({ skill: skillKey, landing });

  cityName = getCityDisplayName(landing ?? '');
  skillCityPageTitle = `${skillData.title} ${cityName} buchen | Kunstwolff`;
  // Pro Stadt individualisierte Description (kein Duplicate über 35 Städte,
  // ≤ 155 Zeichen). Löst das Doorway-Page-Signal der identischen Skill-Description.
  skillCityDescription =
    `${skillData.title} in ${cityName} buchen – Live-Kunst als Highlight für Firmenfeier, Messe & Hochzeit. Jetzt bei Kunstwolff anfragen.`;

  skillCityBreadcrumb = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: skillData.title, item: `${site}/${skill}/` },
      { '@type': 'ListItem', position: 3, name: `${skillData.title} ${cityName}`, item: `${site}${cityComboPath(skill, landing)}` },
    ],
  };
}

// ─────────────────────────────────────────────────────────────────────────────
// SKILL+EVENT-Seite: neue Logik
// ─────────────────────────────────────────────────────────────────────────────
let eventData: Awaited<ReturnType<typeof getEventBySlug>> | undefined;
let eventContent: Awaited<ReturnType<typeof getEventContent>> | undefined;
let eventSlides: Awaited<ReturnType<typeof supplementWithDefaultSlides>> | undefined;
let eventTitleImage = '';
let eventPageTitle = '';
let eventPageDescription = '';
let eventBreadcrumb: unknown;

if (pageType === 'event') {
  eventData = getEventBySlug(landing ?? '');

  if (!eventData) {
    return Astro.redirect('/404');
  }

  eventContent = getEventContent(landing ?? '');
  const rawEventSlides = getEventSlides(landing ?? '');
  const defaultSlides = getDefaultSlides();
  // Gleiche Falle wie bei den Stadt-Kombis: erst nach Skill filtern, dann auffüllen.
  eventSlides = getSkillSlidesForCity(
    rawEventSlides,
    defaultSlides,
    skillData.title,
    MIN_LANDING_SLIDES,
  );
  eventTitleImage = resolveEventTitleImage(landing ?? '');

  // Titel: "{Skill} für {Event}" z.B. "Schnellzeichner für Firmenfeiern"
  eventPageTitle = `${skillData.title} für ${eventData.title} buchen | Kunstwolff`;
  eventPageDescription =
    skillData.description ||
    `${skillData.title} für ${eventData.title}: Live-Kunst als Highlight für Ihre Veranstaltung. Jetzt Kunstwolff anfragen!`;

  eventBreadcrumb = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: skillData.title, item: `${site}/${skill}/` },
      { '@type': 'ListItem', position: 3, name: `${skillData.title} – ${eventData.title}`, item: `${site}${eventComboPath(skill, landing)}` },
    ],
  };
}

// Seitenspezifische Variable aus dem jeweiligen Zweig zusammenführen
const finalHeroTitle =
  pageType === 'landing'
    ? `Live ${skillData.title} in ${cityName}`
    : (eventData ? `${skillData.title} für ${eventData.title}` : skillData.title);

// ── Sektions-Stack: Reihenfolge + Sichtbarkeit aus components.json, Props von
//    hier. Pro Branch (Skill+Stadt vs. Skill+Event) eigene Registry.
let sectionOrder: string[] = [];
let registry: Record<string, any> = {};
let sectionProps: Record<string, Record<string, any> | false> = {};

if (pageType === 'landing' && landingSlides) {
  registry = {
    skillHero: SkillHero,
    slideshow: Slideshow,
    why: Why,
    erinnerungen: LandingErinnerungen,
    contact: Contact,
    faq: FAQ,
    landingsection: Landingsection,
  };
  sectionProps = {
    skillHero: {
      title: finalHeroTitle,
      reviews: reviews as any,
      titleImage: skillCityTitleImage,
      skillName: skillData.title,
      backgroundImage: skillCityHeroBg,
    },
    slideshow: { items: landingSlides, filteredCategories: [skillData.title] },
    why: { skill: skillKey, landing },
    erinnerungen: { skill: skillKey, landing },
    contact: {},
    faq: { city: landing, categories: [skillData.title] },
    // Adresse, kein Inhalts-Schlüssel: die Städte-Links zeigen auf die Kombis.
    landingsection: { skillSlug: skill },
  };
  sectionOrder = resolveSectionOrder('skill-landing', landing ?? '', registry);
} else if (pageType === 'event' && eventData && eventContent && eventSlides) {
  // Skill-zentrische Kombiseite: eigener Lead + „Warum"-Block statt der voll
  // duplizierten Event-Sektionen (Ablauf/Pakete/Referenzen) → kein Duplicate
  // Content. Event-Details verlinken wir per EventTeaser auf /<event>.
  // Die Kombitexte liegen unter `schnellzeichner/messe` – Inhalts-Schlüssel, nicht URL.
  const combo = getSkillEventContent(skillKey, landing ?? '', skillData.title, eventData.title);
  registry = {
    eventHero: EventHero,
    comboLead: LandingIntro,
    comboBenefits: ComboBenefits,
    slideshow: Slideshow,
    eventSkills: EventSkills,
    eventTeaser: EventTeaser,
    faq: FAQ,
    contact: Contact,
  };
  sectionProps = {
    eventHero: {
      titleImage: eventTitleImage,
      title: finalHeroTitle,
      subtitle: eventPageDescription,
      eventLabel: `${skillData.title} · ${eventData.title}`,
    },
    comboLead: { text: combo.lead },
    comboBenefits: { title: combo.benefitsTitle, benefits: combo.benefits },
    slideshow: { items: eventSlides, filteredCategories: [skillData.title] },
    eventSkills: eventContent.skills?.enabled
      ? {
          title: eventContent.skills.title,
          eventSlug: landing ?? '',
          categories: eventData.categories,
          currentSkill: skill ?? '',
        }
      : false,
    eventTeaser: { eventTitle: eventData.title, eventSlug: landing ?? '' },
    faq: { categories: [skillData.title], event: landing ?? '' },
    contact: {},
  };
  sectionOrder = resolveSectionOrder('skill-event', landing ?? '', registry);
}
---

{pageType === 'landing' && landingSlides && (
  <!-- ══════════════════════════════════════════════════
       SKILL+STADT-SEITE – bestehende Struktur unverändert
  ══════════════════════════════════════════════════ -->
  <SkillLayout title={skillCityPageTitle} description={skillCityDescription} image={skillCityTitleImage}>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(skillCityBreadcrumb)} />
    {sectionOrder.map((id) => {
      if (!isComponentEnabled(pt, landing ?? '', id)) return null;
      const props = sectionProps[id];
      if (props === false) return null;
      const Section = registry[id];
      return <Section {...props} />;
    })}

    <script>import "../scripts/formspree.js";</script>
  </SkillLayout>
)}

{pageType === 'event' && eventData && eventContent && eventSlides && (
  <!-- ══════════════════════════════════════════════════
       SKILL+EVENT-SEITE – EventLayout mit Skill-Kontext
  ══════════════════════════════════════════════════ -->
  <EventLayout title={eventPageTitle} description={eventPageDescription} image={eventTitleImage}>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(eventBreadcrumb)} />

    {sectionOrder.map((id) => {
      if (!isComponentEnabled(pt, landing ?? '', id)) return null;
      const props = sectionProps[id];
      if (props === false) return null;
      const Section = registry[id];
      return <Section {...props} />;
    })}

    <script>import "../scripts/formspree.js";</script>
  </EventLayout>
)}
