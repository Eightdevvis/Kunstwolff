---
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import SkillHero from '../components/hero/SkillHero.astro';
import Landingsection from '../components/Landingsection.astro';
import Slideshow from '../components/slideshows/Slideshow.astro';
import Why from '../components/Why.astro';
import SkillLayout from '../layouts/SkillLayout.astro';
import { getSkillBySlug, getSkillSlugs } from '../utils/skills';
import { getSkillSlides } from '../utils/slideImages';
import { getAllReviews } from '../utils/reviews';
import { resolveTitleImage } from '../utils/titleImages';
import { resolveHeroBg } from '../utils/heroBg';
import { isComponentEnabled, resolveSectionOrder, type PageType } from '../utils/componentConfig';

export async function getStaticPaths() {
  const slugs = getSkillSlugs();
  return slugs.map((skill) => ({ params: { skill } }));
}

const { skill } = Astro.params;
const skillData = getSkillBySlug(skill ?? '');

if (!skillData) {
  return Astro.redirect('/404');
}

// Über den Tag, nicht über die Startseiten-Auswahl (siehe getSkillSlides).
const allSlideshow = getSkillSlides(skillData.title);
const allReviews = getAllReviews();

const titleImage = resolveTitleImage({ skill });
const heroBg = resolveHeroBg({ skill });

const heroTitle = skillData.heroTitle || `Live ${skillData.title} für Events`;
const pageTitle = skillData.title + ' für Events buchen | Kunstwolff';
const pageDescription = skillData.description || `${skillData.title} für Firmenfeiern, Messen & Hochzeiten. Live-Kunst als Highlight für Ihr Event. Jetzt Kunstwolff buchen!`;

// WEB-012: Schema-URLs aus Astro.site (= SITE_URL) statt hardcoded kunstwolff.de.
const site = Astro.site?.origin ?? 'https://kunstwolff.de';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": heroTitle,
  "description": pageDescription,
  "url": `${site}/${skill}/`,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Kunstwolff",
    "url": site
  },
  "areaServed": ["DE", "AT", "CH", "LU", "BE"],
  "serviceType": skillData.title
};

// ── Sektions-Stack aus components.json (skill.order) ──────────────────────────
const PAGE_TYPE: PageType = 'skill';
const registry: Record<string, any> = {
  skillHero: SkillHero,
  slideshow: Slideshow,
  why: Why,
  contact: Contact,
  faq: FAQ,
  landingsection: Landingsection,
};
const sectionProps: Record<string, Record<string, any> | false> = {
  skillHero: {
    title: heroTitle,
    reviews: allReviews,
    titleImage,
    skillName: skillData.title,
    backgroundImage: heroBg,
  },
  // Kein `filteredCategories` mehr: die Liste ist schon über den Tag gewählt.
  slideshow: { items: allSlideshow },
  why: { skill },
  contact: {},
  faq: { categories: [skillData.title] },
  landingsection: { site: skill },
};
const sectionOrder = resolveSectionOrder(PAGE_TYPE, skill ?? '', registry);
---
<SkillLayout title={pageTitle} description={pageDescription} image={titleImage}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
	{sectionOrder.map((id) => {
		if (!isComponentEnabled(PAGE_TYPE, skill ?? '', id)) return null;
		const props = sectionProps[id];
		if (props === false) return null;
		const Section = registry[id];
		return <Section {...props} />;
	})}

	<script>import "../scripts/formspree.js";</script>
</SkillLayout>
