---
import { getWhyBenefits } from '../../utils/why';
import WhyBenefitDetail from '../../components/WhyBenefitDetail.astro';

const BENEFIT_SLUGS = ['benefit-1', 'benefit-2', 'benefit-3', 'benefit-4'] as const;

export function getStaticPaths() {
  return BENEFIT_SLUGS.map((benefit) => ({
    params: { benefit },
  }));
}

const { benefit } = Astro.params as { benefit?: string };
const idx = benefit ? BENEFIT_SLUGS.indexOf(benefit as any) : -1;

if (idx < 0) {
  return Astro.redirect('/404');
}

const benefits = getWhyBenefits();
---
<WhyBenefitDetail benefits={benefits} idx={idx} basePrefix="/why" />

