---
import SchnellzeichnerHero from '../../components/hero/SchnellzeichnerHero.astro';
import Landingsection from '../../components/Landingsection.astro';
import Slideshow from '../../components/slideshows/Slideshow.astro';
import SchnellzeichnerLayout from '../../layouts/SchnellzeichnerLayout.astro';
import {
  MIN_LANDING_SLIDES,
  getCitySlides,
  getDefaultSlides,
  supplementWithDefaultSlides,
} from '../../utils/slideImages';

// getStaticPaths liefert alle möglichen Landingpages
export async function getStaticPaths() {
  const landingDir = path.resolve('./src/content/landing');
  const files = fs.readdirSync(landingDir);

  const paths = files
    .filter((f) => f.endsWith('.json'))
    .map((f) => ({ params: { landing: f.replace('.json', '') } }));

  return paths;
}

import fs from 'fs';
import path from 'path';

// Props pro Seite laden
const { landing } = Astro.params;
const landingDir = path.resolve('./src/content/landing');
const landingFile = path.join(landingDir, `${landing}.json`);

const data = JSON.parse(fs.readFileSync(landingFile, 'utf-8'));
const citySlides = getCitySlides(landing);
const defaultSlides = getDefaultSlides();
const landingSlides = supplementWithDefaultSlides(citySlides, defaultSlides, MIN_LANDING_SLIDES);

---

<SchnellzeichnerLayout title="Schnellzeichner">
 <SchnellzeichnerHero reviews={data.reviews} titleImage={data.titleImage} />

 <Slideshow items={landingSlides} filteredCategories={["Schnellzeichner"]} />
 Leistungen
 About
 GroßeReviews
 CTA
  <Landingsection site="schnellzeichner"/>

</SchnellzeichnerLayout>