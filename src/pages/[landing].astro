---
/**
 * [landing].astro
 *
 * Dynamische Route für zwei Seiten-Typen:
 *
 * 1. pageType === 'landing'  → Stadtseiten: /berlin/, /frankfurt/, ...
 *    Wie bisher: Layout mit Opener, Slideshow, Why, FAQ, Contact
 *
 * 2. pageType === 'event'    → Event-Seiten: /firmenfeier/, /messe/, /hochzeit/, /private-feier/
 *    Neues EventLayout mit EventHero, Slideshow, Ablauf, Pakete, Skills, Referenzen, FAQ, Contact
 *
 * Routing-Trick: Beide Typen teilen denselben URL-Slot [landing].
 * getStaticPaths() gibt alle Stadt-Slugs + Event-Slugs zurück, jeweils mit
 * `pageType` als Prop um in der Template-Logik zu unterscheiden.
 * Stadt-Slugs und Event-Slugs überschneiden sich nicht (berlin ≠ firmenfeier).
 */

// ── Gemeinsame Imports ─────────────────────────────────────────────────────────
import Layout from '../layouts/Layout.astro';
import EventLayout from '../layouts/EventLayout.astro';
import Contact from '../components/Contact.astro';
import FAQ from '../components/FAQ.astro';
import Slideshow from '../components/slideshows/Slideshow.astro';
import CinemaWelcome from '../components/CinemaWelcome.astro';
import HomepageReviews from '../components/HomepageReviews.astro';
import Eventtypes from '../components/Eventtypes.astro';
import { isComponentEnabled, resolveSectionOrder, type PageType } from '../utils/componentConfig';
import {
  MIN_LANDING_SLIDES,
  getCitySlides,
  getDefaultSlides,
  supplementWithDefaultSlides,
} from '../utils/slideImages';

// ── Landing-spezifische Imports ───────────────────────────────────────────────
import Opener from '../components/hero/Opener.astro';
import Landingsection from '../components/Landingsection.astro';
import Why from '../components/Why.astro';
import LandingIntro from '../components/LandingIntro.astro';
import { getLandingBySlug, getLandingSlugs } from '../utils/landings';
import { getLandingHeading, getLandingIntro } from '../utils/siteTexts';

// ── Event-spezifische Imports ─────────────────────────────────────────────────
import EventHero from '../components/events/EventHero.astro';
import EventAblauf from '../components/events/EventAblauf.astro';
import EventPakete from '../components/events/EventPakete.astro';
import EventSkills from '../components/events/EventSkills.astro';
import EventReferenzen from '../components/events/EventReferenzen.astro';
import {
  getEventSlugs,
  getEventBySlug,
  getEventContent,
  getEventSlides,
  resolveEventTitleImage,
} from '../utils/events';

// ── getStaticPaths: alle Stadt- + Event-Slugs ────────────────────────────────
export async function getStaticPaths() {
  // Stadtseiten: pageType 'landing'
  const cityPaths = getLandingSlugs().map((slug) => ({
    params: { landing: slug },
    props: { pageType: 'landing' as const },
  }));

  // Event-Seiten: pageType 'event'
  const eventPaths = getEventSlugs().map((slug) => ({
    params: { landing: slug },
    props: { pageType: 'event' as const },
  }));

  return [...cityPaths, ...eventPaths];
}

// ── Params & Props ────────────────────────────────────────────────────────────
const { landing } = Astro.params;
const { pageType } = Astro.props as { pageType: 'landing' | 'event' };

// Component-Visibility
const pt: PageType = pageType === 'event' ? 'event' : 'landing';

// WEB-012: Schema-URLs aus Astro.site (= SITE_URL) statt hardcoded kunstwolff.de.
const site = Astro.site?.origin ?? 'https://kunstwolff.de';

// ─────────────────────────────────────────────────────────────────────────────
// LANDING-Seite: Bestehende Logik unverändert
// ─────────────────────────────────────────────────────────────────────────────
let landingData: Awaited<ReturnType<typeof getLandingBySlug>> | undefined;
let landingSlides: Awaited<ReturnType<typeof supplementWithDefaultSlides>> | undefined;
let landingPageTitle = '';
let landingPageDescription = '';
let landingHeading = '';
let landingIntro = '';
let breadcrumbSchema: unknown;

if (pageType === 'landing') {
  landingData = getLandingBySlug(landing ?? '');
  const citySlides = getCitySlides(landing ?? '');
  const defaultSlides = getDefaultSlides();
  landingSlides = supplementWithDefaultSlides(citySlides, defaultSlides, MIN_LANDING_SLIDES);

  const cityName = (landing ?? '').charAt(0).toUpperCase() + (landing ?? '').slice(1);
  landingHeading = getLandingHeading(landing ?? '', `Eventkünstler in ${cityName}`);
  landingIntro = getLandingIntro(landing ?? '', cityName);
  landingPageTitle = `Eventkünstler ${cityName} – Live-Kunst & Performance | Kunstwolff`;
  landingPageDescription = `Kunstwolff in ${cityName}: Professionelle Eventkünstler für Firmenfeiern, Messen & Hochzeiten. Schnellzeichner, Szenenmaler & mehr.`;

  breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: `Eventkünstler ${cityName}`, item: `${site}/${landing}/` },
    ],
  };
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENT-Seite: Neue Logik
// ─────────────────────────────────────────────────────────────────────────────
let eventData: Awaited<ReturnType<typeof getEventBySlug>> | undefined;
let eventContent: Awaited<ReturnType<typeof getEventContent>> | undefined;
let eventSlides: Awaited<ReturnType<typeof getEventSlides>> | undefined;
let eventTitleImage = '';
let eventPageTitle = '';
let eventPageDescription = '';
let eventBreadcrumbSchema: unknown;

if (pageType === 'event') {
  eventData = getEventBySlug(landing ?? '');

  if (!eventData) {
    // Sollte nicht passieren (getStaticPaths kennt nur valide Slugs), aber sicher ist sicher
    return Astro.redirect('/404');
  }

  eventContent = getEventContent(landing ?? '');
  const rawEventSlides = getEventSlides(landing ?? '');
  const defaultSlides = getDefaultSlides();
  // Fülle event-Slides mit default-Slides auf (Minimum: 6)
  eventSlides = supplementWithDefaultSlides(rawEventSlides, defaultSlides, MIN_LANDING_SLIDES);
  eventTitleImage = resolveEventTitleImage(landing ?? '');

  eventPageTitle = `${eventData.heroTitle ?? eventData.title} | Kunstwolff`;
  eventPageDescription = eventData.description ?? `Kunstwolff – Live-Kunst für ${eventData.title}. Professionelle Eventkünstler für unvergessliche Momente.`;

  eventBreadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: eventData.title, item: `${site}/${landing}/` },
    ],
  };
}

// ── Sektions-Stack: Reihenfolge + Sichtbarkeit aus components.json, Props von
//    hier. Pro Branch (Stadt vs. Event) eigene Registry; resolveSectionOrder
//    validiert die order gegen die Registry beim Build.
let sectionOrder: string[] = [];
let registry: Record<string, any> = {};
let sectionProps: Record<string, Record<string, any> | false> = {};

if (pageType === 'landing' && landingData && landingSlides) {
  registry = {
    opener: Opener,
    landingIntro: LandingIntro,
    homepageReviews: HomepageReviews,
    slideshow: Slideshow,
    cinemaWelcome: CinemaWelcome,
    eventtypes: Eventtypes,
    why: Why,
    contact: Contact,
    faq: FAQ,
    landingsection: Landingsection,
  };
  sectionProps = {
    opener: {
      titleImage: landingData.titleImage,
      titleImageAlt: landingData.title,
      titleImagePosition: landingData.titleImagePosition,
      heading: landingHeading,
    },
    landingIntro: { text: landingIntro },
    homepageReviews: {},
    slideshow: { items: landingSlides },
    cinemaWelcome: {},
    eventtypes: {},
    why: { landing },
    contact: {},
    faq: { city: landing },
    landingsection: {},
  };
  sectionOrder = resolveSectionOrder('landing', landing ?? '', registry);
} else if (pageType === 'event' && eventData && eventContent && eventSlides) {
  registry = {
    eventHero: EventHero,
    slideshow: Slideshow,
    eventAblauf: EventAblauf,
    eventPakete: EventPakete,
    eventSkills: EventSkills,
    eventReferenzen: EventReferenzen,
    faq: FAQ,
    contact: Contact,
  };
  sectionProps = {
    eventHero: {
      titleImage: eventTitleImage,
      title: eventData.heroTitle ?? eventData.title,
      subtitle: eventData.description,
      eventLabel: eventData.title,
    },
    slideshow: { items: eventSlides },
    // Sichtbarkeit = allein der Stack (_order) + Inhalt. Kein separates
    // `enabled`-Flag mehr (fiel im Admin weg, damit „im Stack" = „auf der Seite").
    eventAblauf:
      (eventContent.ablauf?.steps?.length ?? 0) > 0
        ? { title: eventContent.ablauf.title, steps: eventContent.ablauf.steps }
        : false,
    eventPakete:
      (eventContent.pakete?.items?.length ?? 0) > 0
        ? { title: eventContent.pakete.title, items: eventContent.pakete.items }
        : false,
    eventSkills: {
      title: eventContent.skills?.title ?? '',
      eventSlug: landing ?? '',
      categories: eventData.categories,
    },
    eventReferenzen:
      (eventContent.referenzen?.logos?.length ?? 0) > 0
        ? {
            title: eventContent.referenzen.title,
            text: eventContent.referenzen.text,
            logos: eventContent.referenzen.logos,
          }
        : false,
    faq: {},
    contact: {},
  };
  sectionOrder = resolveSectionOrder('event', landing ?? '', registry);
}
---

{pageType === 'landing' && landingData && landingSlides && (
  <!-- ══════════════════════════════════════════════════
       STADTSEITE – bestehende Struktur unverändert
  ══════════════════════════════════════════════════ -->
  <Layout title={landingPageTitle} description={landingPageDescription} image={landingData.titleImage}>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {sectionOrder.map((id) => {
      if (!isComponentEnabled(pt, landing ?? '', id)) return null;
      const props = sectionProps[id];
      if (props === false) return null;
      const Section = registry[id];
      return <Section {...props} />;
    })}
    <script>import "../scripts/formspree.js";</script>
  </Layout>
)}

{pageType === 'event' && eventData && eventContent && eventSlides && (
  <!-- ══════════════════════════════════════════════════
       EVENT-SEITE – eigenes EventLayout
  ══════════════════════════════════════════════════ -->
  <EventLayout title={eventPageTitle} description={eventPageDescription} image={eventTitleImage}>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(eventBreadcrumbSchema)} />

    {sectionOrder.map((id) => {
      if (!isComponentEnabled(pt, landing ?? '', id)) return null;
      const props = sectionProps[id];
      if (props === false) return null;
      const Section = registry[id];
      return <Section {...props} />;
    })}

    <script>import "../scripts/formspree.js";</script>
  </EventLayout>
)}
