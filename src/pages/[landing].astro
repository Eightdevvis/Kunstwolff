---
import Layout from '../layouts/Layout.astro';
import Skills from '../components/SkillBanner.astro';
import Slideshow from '../components/slideshows/Slideshow.astro';
import Opener from '../components/hero/Opener.astro';
import Landingsection from '../components/Landingsection.astro';
import Why from '../components/Why.astro';
import Contact from '../components/Contact.astro';
import FAQ from '../components/FAQ.astro';
import { getSharedSkills } from '../utils/skills';
import { getReviewsByLanding } from '../utils/reviews';
import { getLandingBySlug, getLandingSlugs } from '../utils/landings';
import {
  MIN_LANDING_SLIDES,
  getCitySlides,
  getDefaultSlides,
  supplementWithDefaultSlides,
} from '../utils/slideImages';

// getStaticPaths liefert alle möglichen Landingpages
export async function getStaticPaths() {
  return getLandingSlugs().map((landing) => ({ params: { landing } }));
}

// Props pro Seite laden
const { landing } = Astro.params;
const landingData = getLandingBySlug(landing ?? '');
const skills = getSharedSkills();
const citySlides = getCitySlides(landing);
const defaultSlides = getDefaultSlides();
const landingSlides = supplementWithDefaultSlides(citySlides, defaultSlides, MIN_LANDING_SLIDES);
const reviews = getReviewsByLanding(landing);

const cityName = (landing ?? '').charAt(0).toUpperCase() + (landing ?? '').slice(1);
const pageTitle = `Eventkünstler ${cityName} – Live-Kunst & Performance | Kunstwolff`;
const pageDescription = `Kunstwolff in ${cityName}: Professionelle Eventkünstler für Firmenfeiern, Messen & Hochzeiten. Schnellzeichner, Szenenmaler & mehr.`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://kunstwolff.de/" },
    { "@type": "ListItem", "position": 2, "name": `Eventkünstler ${cityName}`, "item": `https://kunstwolff.de/${landing}/` }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} image={landingData.titleImage}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Opener titleImage={landingData.titleImage} titleImageAlt={landingData.title} />
  <Skills skills={skills} reviews={reviews} currentLanding={landing} />
  <Slideshow items={landingSlides} />
  <Why landing={landing} />
  <Contact />
  <FAQ city={landing} />
  <Landingsection/>
  <script src="../scripts/formspree.js"></script>
</Layout>
