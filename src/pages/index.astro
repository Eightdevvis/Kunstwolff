---
import Opener from "../components/hero/Opener.astro";
import LandingIntro from "../components/LandingIntro.astro";
import CinemaWelcome from "../components/CinemaWelcome.astro";
import HomepageReviews from "../components/HomepageReviews.astro";
import Layout from "../layouts/Layout.astro";
import Slideshow from "../components/slideshows/Slideshow.astro";
import Contact from "../components/Contact.astro";
import Landingsection from "../components/Landingsection.astro";
import Why from "../components/Why.astro";
import Eventtypes from "../components/Eventtypes.astro";
import FAQ from "../components/FAQ.astro";
import Aboutsection from "../components/about/Aboutsection.astro";
import { resolveTitleImage, resolveTitleImageFocus } from "../utils/titleImages";
import {
  getHomepageSlides,
} from "../utils/slideImages";
import { isComponentEnabled, resolveSectionOrder, type PageType } from "../utils/componentConfig";
import { getHomeIntro } from "../utils/siteTexts";

const homeIntro = getHomeIntro();

// Slideshow-Items nur aus Ordnern zusammenführen
const homepageSlides = getHomepageSlides();
const titleImage = resolveTitleImage();
const titleImagePosition = resolveTitleImageFocus();

// ── Sektions-Stack: Reihenfolge + Sichtbarkeit kommen aus components.json
//    (homepage.order), die Props pro Sektion von hier. Registry mappt ID →
//    Komponente; resolveSectionOrder validiert beides gegeneinander beim Build.
const PAGE_TYPE: PageType = 'homepage';
const registry: Record<string, any> = {
  opener: Opener,
  landingIntro: LandingIntro,
  homepageReviews: HomepageReviews,
  slideshow: Slideshow,
  cinemaWelcome: CinemaWelcome,
  eventtypes: Eventtypes,
  why: Why,
  contact: Contact,
  faq: FAQ,
  landingsection: Landingsection,
};
const sectionProps: Record<string, Record<string, any> | false> = {
  opener: { titleImage, titleImagePosition },
  landingIntro: { text: homeIntro },
  homepageReviews: {},
  slideshow: { items: homepageSlides },
  cinemaWelcome: {},
  eventtypes: {},
  why: {},
  contact: {},
  faq: {},
  landingsection: {},
};
const sectionOrder = resolveSectionOrder(PAGE_TYPE, '', registry);

// WEB-012: Schema-URLs aus Astro.site (= SITE_URL) statt hardcoded kunstwolff.de,
// konsistent zu Canonical/OG im Layout (Stage → vercel.app, Cutover → kunstwolff.de).
const site = Astro.site?.origin ?? 'https://kunstwolff.de';

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Kunstwolff",
  "description": "Eventkünstler seit über 25 Jahren – Schnellzeichner, Szenenmaler & Live-Performance für Firmenfeiern, Messen und Hochzeiten.",
  "url": site,
  "telephone": "+491736677229",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Birkenstr. 3",
    "addressLocality": "Saarbrücken",
    "postalCode": "66121",
    "addressCountry": "DE"
  },
  "areaServed": ["DE", "AT", "CH", "LU", "BE"],
  "image": `${site}/img/logo/logo_transparent.webp`,
  "priceRange": "€€"
};

//<Aboutsection />
---

<Layout image={titleImage}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  {sectionOrder.map((id) => {
    if (!isComponentEnabled(PAGE_TYPE, '', id)) return null;
    const props = sectionProps[id];
    if (props === false) return null;
    const Section = registry[id];
    return <Section {...props} />;
  })}

  <script>import "../scripts/formspree.js";</script>
</Layout>
