---
import Opener from "../components/hero/Opener.astro";
import SkillBanner from "../components/SkillBanner.astro";
import Layout from "../layouts/Layout.astro";
import Slideshow from "../components/slideshows/Slideshow.astro";
import References from "../components/reviews-references/References.astro";
import Contact from "../components/Contact.astro";
import Landingsection from "../components/Landingsection.astro";
import Aboutsection from "../components/about/Aboutsection.astro";
import { getSharedSkills } from "../utils/skills";
import {
  getHomepageSlides,
} from "../utils/slideImages";

const skills = getSharedSkills();

// Slideshow-Items nur aus Ordnern zusammenführen
const homepageSlides = getHomepageSlides();
---

<Layout>
  
  <Opener />

  <Aboutsection />

  <SkillBanner skills={skills} />

  <Slideshow
    items={homepageSlides}
  />

  <References />

  <Contact />

  <Landingsection />

  <script src="../scripts/formspree.js"></script>
</Layout>
