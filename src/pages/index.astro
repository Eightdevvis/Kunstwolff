---
import Opener from "../components/hero/Opener.astro";
import CinemaWelcome from "../components/CinemaWelcome.astro";
import HomepageReviews from "../components/HomepageReviews.astro";
import Layout from "../layouts/Layout.astro";
import Slideshow from "../components/slideshows/Slideshow.astro";
import Contact from "../components/Contact.astro";
import Landingsection from "../components/Landingsection.astro";
import Why from "../components/Why.astro";
import Eventtypes from "../components/Eventtypes.astro";
import FAQ from "../components/FAQ.astro";
import Aboutsection from "../components/about/Aboutsection.astro";
import { resolveTitleImage } from "../utils/titleImages";
import {
  getHomepageSlides,
} from "../utils/slideImages";
import { isComponentEnabled } from "../utils/componentConfig";

const show = (id: string) => isComponentEnabled('homepage', '', id);

// Slideshow-Items nur aus Ordnern zusammenführen
const homepageSlides = getHomepageSlides();
const titleImage = resolveTitleImage();

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Kunstwolff",
  "description": "Eventkünstler seit über 20 Jahren – Schnellzeichner, Szenenmaler & Live-Performance für Firmenfeiern, Messen und Hochzeiten.",
  "url": "https://kunstwolff.de",
  "telephone": "+491736677229",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Birkenstr. 3",
    "addressLocality": "Saarbrücken",
    "postalCode": "66121",
    "addressCountry": "DE"
  },
  "areaServed": ["DE", "AT", "CH", "LU", "BE"],
  "image": "https://kunstwolff.de/img/logo/logo_transparent.webp",
  "priceRange": "€€"
};

//<Aboutsection />
---

<Layout image={titleImage}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  
  {show('opener') && <Opener titleImage={titleImage} />}

  {show('homepageReviews') && <HomepageReviews />}

  {show('slideshow') && <Slideshow items={homepageSlides} />}

  {show('cinemaWelcome') && <CinemaWelcome />}

  {show('eventtypes') && <Eventtypes />}

  {show('why') && <Why />}

  {show('contact') && <Contact />}

  {show('faq') && <FAQ />}

  {show('landingsection') && <Landingsection />}

  <script src="../scripts/formspree.js"></script>
</Layout>
