---
import hochzeit from "../assets/img/Hochzeitsmaler.jpg";

import BrandStripe from "../components/BrandStripe.astro";
import Navigation from "../components/Navigation.astro";
import Opener from "../components/Opener.astro";

import Layout from "../layouts/Layout.astro";
---

<Layout>
  
  <Opener/>

  <!-- =========================
     ABOUT / STORY
========================= -->
  <section class="section about" id="skills">
    <div class="section-inner">
      <h2>Professionell. Erfahren. Kreativ.</h2>
      <p>
        <!-- hier kommt später eure Story rein Text über Kunstwolff, Philosophie, Live-Kunst, Erfahrung usw.-->

        <br />Kunststudio aber Familie. Mit zahllosen Aufträgen und Auftritten
        wissen wir genau, wie wir unsere Kunst an Sie liefern. Ob Live-Event und
        performant als besondere Gästeunterhaltung oder Anfertigung im Atelier
        auf Wunsch.
        <br /><br />
        Lernen Sie hier unsere Fähigkeiten kennen.
      </p>
    </div>
  </section>

  <!-- =========================
     SKILLS / FÄHIGKEITEN
========================= -->
  <section class="skills-section">
    <div class="skills-grid">
      <div class="skill-item">
        <div class="skill-image" style="background-image: url(${hochzeit})">
        </div>
        <div class="skill-label">Schnellzeichner</div>
      </div>
      <div class="skill-item">
        <div
          class="skill-image"
          style="background-image: url('../assets/img/Hochzeitsmaler.jpg')"
        >
        </div>
        <div class="skill-label">Szenenmaler</div>
      </div>
      <!-- weitere Skills später -->
    </div>
  </section>

  <!-- =========================
     SWIPE GALLERY
========================= -->
  <section class="section gallery" id="work">
    <div class="section-inner">
      <h2>Unsere Kunst</h2>

      <div class="gallery-swipe">
        <!-- später: Swipe / Slider / Lightbox -->
        <p>Swipe Gallery Placeholder</p>
      </div>
    </div>
  </section>

  <!-- =========================
     REFERENCES / GÄSTEBUCH
========================= -->
  <section class="section references">
    <div class="section-inner">
      <h2>Referenzen</h2>

      <!-- Logos / Marken -->
      <div class="reference-logos">
        <!-- später: Logos, Cards, Slider, Gästebuch -->
        <p>Marken & Events, mit denen wir gearbeitet haben</p>
      </div>
    </div>
  </section>

  <!-- =========================
     CONTACT
========================= -->
  <section id="contact" class="section contact">
    <div class="section-inner">
      <h2>Kontakt</h2>

      <!-- Formspree-Formular (mit JS) -->
      <form id="contactForm" class="contact-form">
        <input
          type="hidden"
          name="_subject"
          value="Neue Anfrage von Kunstwolff Website"
        />

        <input type="text" name="name" placeholder="Name" required />
        <input type="email" name="email" placeholder="E-Mail" required />
        <input type="tel" name="phone" placeholder="Telefon" required />
        <input
          type="date"
          name="date"
          required
          onfocus="this.showPicker()"
          placeholder="Datum des Events"
          style="color: #fff;"
        />

        <textarea name="message" placeholder="Ihre Anfrage" required></textarea>

        <button type="submit">Anfrage senden</button>
      </form>

      <div
        id="formMessage"
        style="display:none; color:#0f0; margin-top:10px; text-align:center; font-weight:700;"
      >
        Sent!
      </div>

      <!-- alternative Kontaktinfos -->
      <div class="contact-info">
        <p>Telefon: +49 …</p>
        <p>E-Mail: info@kunstwolff.de</p>
      </div>
    </div>
  </section>



  <!-- =========================
     LANDING PAGE LINKS / CTA
========================= -->
  <section class="section landing-links">
    <div class="section-inner">
      <p>
        <!-- hier kannst du einfach Text + Links reinwerfen -->
        Weitere Angebote & Spezialisierungen:
        <a href="#">Live Painting</a> ·
        <a href="#">Eventkunst</a> ·
        <a href="#">Corporate Art</a>
        Städte: <br />
        Karlsruhe · Stuttgart · Mannheim · Heidelberg · Freiburg · Baden-Baden · Frankfurt
        am Main · Walldorf · Wiesbaden · Mainz · Köln · Düsseldorf · Aachen · München
        · Nürnberg · Garmisch-Partenkirchen · Berlin · Hamburg · Leipzig · Dresden
        <br />
        <br />
        Regionen: <br />
        Schwarzwald · Odenwald · Pfalz · Rhein-Main · Rhein-Neckar · Main-Taunus ·
        Franken · Oberbayern · Allgäu · Berlin / Brandenburg · Norddeutschland
        <br />
        <br />
        Bundesländer: <br />
        Baden-Württemberg · Bayern · Berlin · Brandenburg · Bremen · Hamburg · Hessen
        · Niedersachsen · Nordrhein-Westfalen · Rheinland-Pfalz · Saarland · Sachsen
        · Sachsen-Anhalt · Thüringen · Mecklenburg-Vorpommern · Schleswig-Holstein
      </p>
    </div>
  </section>

  <script src="../scripts/formspree.js"></script>
</Layout>
