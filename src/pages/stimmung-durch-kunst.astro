---
import Layout from '../layouts/Layout.astro';
import { getStimmungDurchKunstContent } from '../utils/stimmungDurchKunst';
import { getWhyDetailLinkByTitle } from '../utils/whyDetailLinks';

const content = getStimmungDurchKunstContent();

if (!content) {
  return Astro.redirect('/404');
}

const { seo, hero, intro, artForms, otherSectionTitle, otherHighlights } = content;
const heroImage = artForms[0]?.image || '/img/samples/sample1.webp';
---

<Layout title={seo.title} description={seo.description} image={heroImage}>
  <main class="sdk-page">
    <header class="sdk-hero">
      <div class="sdk-hero-inner">
        <h1>{hero.title}</h1>
        <p class="sdk-hero-sub">{hero.subtitle}</p>
      </div>
    </header>

    <section class="sdk-intro" aria-label="Einleitung">
      <div class="sdk-section-inner">
        <p class="sdk-intro-text">{intro}</p>
      </div>
    </section>

    {artForms.map((form, i) => (
      <article
        class:list={['sdk-art', i % 2 === 1 && 'sdk-art--reverse', i % 2 === 1 && 'sdk-art--muted']}
        aria-labelledby={`sdk-art-${form.id}`}
      >
        <div class="sdk-section-inner sdk-art-grid">
          <div class="sdk-art-copy">
            <h2 id={`sdk-art-${form.id}`}>{form.name}</h2>

            <div class="sdk-block">
              <h3 class="sdk-label">Was ist das?</h3>
              <p>{form.whatIsIt}</p>
            </div>

            <div class="sdk-block">
              <h3 class="sdk-label">Welche Atmosphäre schafft das?</h3>
              <p>{form.atmosphere}</p>
            </div>

            {form.linkUrl?.trim() && (
              <a class="sdk-link" href={form.linkUrl}>
                {form.linkLabel?.trim() || 'Mehr erfahren'}
              </a>
            )}
          </div>

          <figure class="sdk-art-figure">
            {form.image && (<img src={form.image} alt={form.imageAlt || form.name} loading="lazy" width="800" height="500" />)}
          </figure>
        </div>
      </article>
    ))}

    <section class="sdk-other" aria-labelledby="sdk-other-title">
      <div class="sdk-section-inner">
        <h2 id="sdk-other-title" class="sdk-other-title">{otherSectionTitle}</h2>
        <div class="sdk-other-grid">
          {otherHighlights.map((item) => {
            const autoLink = getWhyDetailLinkByTitle(item.title);
            const targetLink = item.linkUrl?.trim() || autoLink;
            const targetLabel = item.linkLabel?.trim() || 'Mehr erfahren';

            return targetLink ? (
              <a class="sdk-other-card sdk-other-card--link" href={targetLink} aria-label={`Mehr zu ${item.title}`}>
                {item.image && (<img src={item.image} alt={item.alt || item.title} loading="lazy" />)}
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <span class="sdk-link sdk-link--small">{targetLabel}</span>
              </a>
            ) : (
              <div class="sdk-other-card">
                {item.image && (<img src={item.image} alt={item.alt || item.title} loading="lazy" />)}
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .sdk-page {
    width: 100%;
    padding-top: 72px;
    background: #f5f5f5;
    color: #111;
  }

  .sdk-hero {
    padding: clamp(48px, 8vw, 88px) 20px clamp(32px, 5vw, 56px);
    text-align: center;
    background: linear-gradient(180deg, #fff 0%, #f5f5f5 100%);
  }

  .sdk-hero-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .sdk-hero h1 {
    font-family: 'Mayonice', Georgia, serif;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 16px;
    letter-spacing: 0.02em;
  }

  .sdk-hero-sub {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #444;
    line-height: 1.65;
    margin: 0;
  }

  .sdk-section-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .sdk-intro {
    padding: 24px 0 40px;
  }

  .sdk-intro-text {
    max-width: 820px;
    margin: 0 auto;
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.75;
    color: #333;
  }

  .sdk-art {
    padding: clamp(40px, 6vw, 72px) 0;
    background: #fff;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .sdk-art--muted {
    background: #fafafa;
  }

  .sdk-art-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 48px);
    align-items: center;
  }

  .sdk-art--reverse .sdk-art-grid {
    direction: rtl;
  }

  .sdk-art--reverse .sdk-art-copy,
  .sdk-art--reverse .sdk-art-figure {
    direction: ltr;
  }

  .sdk-art-copy h2 {
    font-family: 'Mayonice', Georgia, serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    margin: 0 0 24px;
    color: #000;
  }

  .sdk-block {
    margin-bottom: 22px;
  }

  .sdk-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: #666;
    margin: 0 0 8px;
  }

  .sdk-block p {
    font-family: var(--font-body);
    font-size: 0.98rem;
    line-height: 1.7;
    color: #333;
    margin: 0;
  }

  .sdk-link {
    display: inline-block;
    margin-top: 8px;
    padding: 12px 22px;
    border-radius: 999px;
    background: #000;
    color: #fff;
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .sdk-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
  }

  .sdk-link--small {
    margin-top: 12px;
    padding: 10px 18px;
    font-size: 0.75rem;
  }

  .sdk-art-figure {
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1);
  }

  .sdk-art-figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .sdk-other {
    padding: clamp(56px, 8vw, 96px) 0 96px;
    background: #eee;
  }

  .sdk-other-title {
    font-family: 'Mayonice', Georgia, serif;
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 400;
    text-align: center;
    margin: 0 0 40px;
    color: #000;
  }

  .sdk-other-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .sdk-other-card {
    background: #fff;
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  }

  .sdk-other-card--link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .sdk-other-card--link:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.10);
  }

  .sdk-other-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 16px;
  }

  .sdk-other-card h3 {
    font-family: var(--font-headings);
    font-size: 1.05rem;
    margin: 0 0 10px;
    color: #000;
  }

  .sdk-other-card p {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.6;
    color: #444;
    margin: 0;
  }

  @media (max-width: 900px) {
    .sdk-art-grid {
      grid-template-columns: 1fr;
    }

    .sdk-art--reverse .sdk-art-grid {
      direction: ltr;
    }

    .sdk-other-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
