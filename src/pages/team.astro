---
/**
 * Team – die beiden Künstlerinnen hinter Kunstwolff.
 *
 * Bewusst eine in sich geschlossene Seite ohne eigenes Datenformat (wie
 * `partner.astro`, nur ohne JSON): zwei Profile ändern sich selten, und ein
 * Manager im Admin-Tool für zwei Datensätze wäre mehr Apparat als Inhalt. Kommt
 * ein drittes Profil dazu, ist der Umzug in eine `team.json` der richtige
 * Zeitpunkt – nicht vorher.
 *
 * Reihenfolge: Gabriele zuerst.
 *
 * Die Portraits liegen in `public/img/team/` und sind Ausschnitte aus
 * vorhandenen Event-Fotos (siehe `memory/content-team.md`). Sie tragen bewusst
 * KEIN `srcset`: `scripts/generate-image-variants.mjs` erzeugt Varianten nur für
 * `img/slides`, `img/Titelbild` und `img/why`. Ein `srcset` auf `img/team` würde
 * auf Dateien zeigen, die niemand erzeugt – und ein fehlender srcset-Kandidat
 * zeigt gar kein Bild, ohne zweiten Versuch. Deshalb sind die beiden Dateien
 * schon in Anzeigegröße zugeschnitten (680 × 850).
 */
import Layout from "../layouts/Layout.astro";

type Profil = {
  name: string;
  rolle: string;
  bild: string;
  alt: string;
  absaetze: string[];
  schwerpunkte: string[];
};

const profile: Profil[] = [
  {
    name: "Gabriele Wolff",
    rolle: "Karikatur & Schnellzeichnen",
    bild: "/img/team/gabriele-wolff.webp",
    alt: "Gabriele Wolff zeichnet lächelnd an ihrer Staffelei auf einem Event",
    absaetze: [
      "Gabriele ist die Karikaturistin im Haus. Ein Blick, ein paar Striche – und das Wesentliche steht auf dem Papier: der Zug um den Mund, die Haltung, das eine Detail, an dem alle sofort erkennen, wer da sitzt.",
      "Sie arbeitet live und mitten im Geschehen, an der Staffelei oder digital, und behält dabei auch dann die Ruhe, wenn sich eine Schlange bildet. Aus dieser Erfahrung ist Kunstwolff gewachsen.",
    ],
    schwerpunkte: ["Karikatur", "Schnellportrait", "Live-Zeichnen am Event"],
  },
  {
    name: "Jenny Wolff",
    rolle: "Szenenmalerei & Malerei",
    bild: "/img/team/jenny-wolff.webp",
    alt: "Jenny Wolff hält ein von ihr gemaltes Szenenbild eines tanzenden Brautpaars in die Kamera",
    absaetze: [
      "Jenny malt. Wo die Karikatur ein Gesicht auf den Punkt bringt, hält sie den ganzen Moment fest – den Raum, das Licht, die Bewegung auf der Tanzfläche. Am Ende des Abends hängt der Abend selbst an der Wand.",
      "Die eigentliche Szenenmalerei ist ihr Fach: Sie ist bei Kunstwolff die Einzige, die sie macht. Karikatur und Schnellzeichnen gehören trotzdem selbstverständlich dazu.",
    ],
    schwerpunkte: ["Szenenmalerei", "Live-Painting", "Portrait & Malerei"],
  },
];

const site = Astro.site?.origin ?? "https://kunstwolff.de";

// Zwei Person-Einträge – das ist es, was die Seite behauptet, und mehr nicht.
// Keine erfundenen Auszeichnungen, Jahreszahlen oder Ausbildungen im Schema:
// falsche strukturierte Daten sind schlimmer als keine.
const teamSchema = {
  "@context": "https://schema.org",
  "@graph": profile.map((p) => ({
    "@type": "Person",
    name: p.name,
    jobTitle: p.rolle,
    image: `${site}${p.bild}`,
    worksFor: { "@type": "Organization", name: "Kunstwolff", url: site },
  })),
};
---

<Layout
  title="Team | Kunstwolff"
  description="Die beiden Künstlerinnen hinter Kunstwolff: Gabriele Wolff (Karikatur & Schnellzeichnen) und Jenny Wolff (Szenenmalerei & Malerei)."
  image={profile[0]?.bild}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(teamSchema)} />

  <main class="team-page">
    <div class="team-header">
      <h1>Unser Team</h1>
      <p class="team-intro">
        Kunststudio, aber Familie: Mutter und Tochter, zwei Handschriften. Wir
        beide beherrschen alle Kunstformen von Kunstwolff – nur bei der
        Szenenmalerei bleibt es bei einer von uns.
      </p>
    </div>

    <div class="team-list">
      {profile.map((p) => (
        <article class="team-card">
          <div class="team-portrait">
            <img src={p.bild} alt={p.alt} loading="lazy" decoding="async" width="680" height="850" />
          </div>

          <div class="team-body">
            <h2>{p.name}</h2>
            <p class="team-role">{p.rolle}</p>

            {p.absaetze.map((absatz) => <p class="team-text">{absatz}</p>)}

            <ul class="team-tags">
              {p.schwerpunkte.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <p class="team-cta">
      Sie wissen noch nicht, was zu Ihrem Event passt?
      <a href="/contact">Fragen Sie uns</a> – oder sehen Sie sich in der
      <a href="/galerie/">Galerie</a> an, was wir bisher gemacht haben.
    </p>
  </main>
</Layout>

<style>
  .team-page {
    background: #000;
    padding: 90px 20px 100px;
  }

  .team-header {
    max-width: 720px;
    margin: 0 auto 56px;
    text-align: center;
  }

  .team-header h1 {
    color: #fff;
    font-family: "Mayonice", Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.2;
    letter-spacing: 0.01em;
    margin-bottom: 18px;
  }

  .team-intro {
    color: #b9b9b9;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .team-list {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    gap: 48px;
  }

  /* Portrait links, Text rechts. Bei zwei Profilen ist ein abwechselndes Layout
     (zweites Bild rechts) nur Effekt – gleiche Ausrichtung liest sich als Liste
     und lässt die beiden Profile gleichwertig aussehen. */
  .team-card {
    display: grid;
    grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    gap: 32px;
    align-items: start;
    padding: 28px;
    border: 1px solid #1f1f1f;
    border-radius: 14px;
    background: linear-gradient(180deg, #0d0d0d 0%, #080808 100%);
  }

  .team-portrait {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #262626;
    background: #111;
  }

  /* Die Dateien sind schon auf 4:5 zugeschnitten; `aspect-ratio` + `cover` hält
     den Ausschnitt auch dann, wenn jemand später ein anders proportioniertes
     Foto einsetzt. */
  .team-portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .team-body h2 {
    color: #fff;
    font-family: "Mayonice", Georgia, serif;
    font-weight: 400;
    font-size: clamp(1.7rem, 3.2vw, 2.2rem);
    line-height: 1.25;
    margin-bottom: 6px;
  }

  .team-role {
    color: #d7b96a;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .team-text {
    color: #cfcfcf;
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 14px;
  }

  .team-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
    padding: 0;
  }

  .team-tags li {
    border: 1px solid #383838;
    border-radius: 999px;
    background: #111;
    color: #d8d8d8;
    padding: 6px 13px;
    font-size: 0.85rem;
  }

  .team-cta {
    max-width: 720px;
    margin: 56px auto 0;
    text-align: center;
    color: #c7c7c7;
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .team-cta a {
    color: #d7b96a;
    text-decoration: none;
    border-bottom: 1px solid rgba(215, 185, 106, 0.65);
  }

  .team-cta a:hover,
  .team-cta a:focus-visible {
    color: #fff;
    border-color: #fff;
  }

  @media (max-width: 720px) {
    .team-page {
      padding: 64px 16px 76px;
    }

    .team-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      padding: 20px;
    }

    /* Auf dem Handy nimmt ein 4:5-Portrait über die volle Breite den halben
       Bildschirm ein, bevor ein Wort gelesen ist – deshalb begrenzt und
       zentriert statt formatfüllend. */
    .team-portrait {
      max-width: 240px;
      margin: 0 auto;
    }
  }
</style>
