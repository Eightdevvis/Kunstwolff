---
import Layout from '../layouts/Layout.astro';
import BrandStripe from '../components/reviews-references/BrandStripe.astro';
---

<Layout
  title="Referenzen | Kunstwolff"
  description="Ausgewählte Marken und Veranstaltungen, bei denen Kunstwolff live dabei war – national und international."
>
  <main class="referenzen-page">
    <div class="referenzen-header">
      <h1>Referenzen</h1>
      <p class="referenzen-intro">
        Ob Banken, Industrie oder internationale Messen: Seit über 25 Jahren sind wir für
        namhafte Kunden auf der Bühne – hier ein Auszug der Marken, mit denen wir zusammenarbeiten.
      </p>
    </div>

    <BrandStripe />
  </main>
</Layout>

<style>
  .referenzen-page {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 140px 24px 120px;
  }

  .referenzen-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .referenzen-header h1 {
    font-family: 'Mayonice', Georgia, serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: 0.12em;
    margin-bottom: 16px;
    color: #ffffff;
  }

  .referenzen-intro {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.5);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
    letter-spacing: 0.04em;
  }

  .referenzen-header::after {
    content: '';
    display: block;
    width: 48px;
    height: 1px;
    background: #d4af37;
    margin: 28px auto 0;
    opacity: 0.7;
  }
</style>
