{
  "name": "capricious-conjunction",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "setup:hooks": "git config core.hooksPath .githooks",
    "sync:landings": "node scripts/sync-landings.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "sync:title-images": "node scripts/sync-title-images.mjs",
    "sync:slides": "node scripts/sync-slides-metadata.mjs",
    "sync:why": "node scripts/sync-why.mjs",
    "remove:landing": "node scripts/remove-landing.mjs",
    "sync:content:safe": "node scripts/sync-content-safe.mjs",
    "sync:content": "npm run sync:landings && npm run sync:skills && npm run sync:title-images && npm run sync:slides && npm run sync:why",
    "optimize:images": "node scripts/optimize-staged-images.mjs",
    "predev": "npm run sync:content:safe",
    "dev": "astro dev",
    "prebuild": "npm run sync:content:safe",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/preact": "^4.1.3",
    "astro": "^5.17.1",
    "gray-matter": "^4.0.3",
    "lightgallery": "^2.9.0",
    "markdown-it": "^14.1.1",
    "preact": "^10.28.4",
    "sharp": "^0.34.5",
    "swiper": "^12.1.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.3.0"
  }
}
