{
  "name": "capricious-conjunction",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "setup:hooks": "git config core.hooksPath .githooks",
    "sync:landings": "node scripts/sync-landings.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "sync:tags": "node scripts/sync-tags.mjs",
    "sync:title-images": "node scripts/sync-title-images.mjs",
    "sync:slides": "node scripts/sync-slides-metadata.mjs",
    "sync:why": "node scripts/sync-why.mjs",
    "remove:landing": "node scripts/remove-landing.mjs",
    "sync:content:safe": "node scripts/sync-content-safe.mjs",
    "sync:events": "node scripts/sync-events.mjs",
    "sync:erinnerungen": "node scripts/sync-erinnerungen.mjs",
    "sync:content": "npm run sync:landings && npm run sync:skills && npm run sync:tags && npm run sync:title-images && npm run sync:slides && npm run sync:why && npm run sync:events && npm run sync:erinnerungen && npm run validate:images",
    "validate:images": "node scripts/validate-image-refs.mjs",
    "optimize:images": "node scripts/optimize-staged-images.mjs",
    "optimize:all": "node scripts/optimize-all-images.mjs",
    "predev": "npm run sync:content:safe",
    "dev": "astro dev",
    "prebuild": "npm run sync:content:safe",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@astrojs/preact": "^4.1.3",
    "@astrojs/sitemap": "^3.7.1",
    "astro": "^5.17.1",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.1",
    "preact": "^10.28.4",
    "sharp": "^0.34.5",
    "swiper": "^12.1.2"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.3.0",
    "vitest": "^4.1.2"
  }
}
